# Category: Config
# File: nginx_sites_available_vscode.example
# Description: Nginx reverse proxy template for VSCode Web Server with HTTPS, WebSockets, and CORS support.
# Usage: Copy to /etc/nginx/sites-available/$DOMAIN and symlink to /etc/nginx/sites-enabled/
# Maintainer: ryumada

map $http_origin $allow_origin {
    default "";
    # 1. Allow the same origin (your domain)
    "https://$ENTER_DOMAIN" $http_origin;
    # 2. Allow any subdomain of vscode-cdn.net using a regular expression.
    "~^https://[^.]+\.vscode-cdn\.net$" $http_origin;
}

# Block 1: Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name $ENTER_DOMAIN;
    return 301 https://$host$request_uri;
}

# Block 2: Main HTTPS Proxy
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $ENTER_DOMAIN;

    # SSL Configuration
    ssl_certificate         /etc/letsencrypt/live/$ENTER_SSL_DOMAIN/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/$ENTER_SSL_DOMAIN/privkey.pem;
    include                 /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam             /etc/letsencrypt/ssl-dhparams.pem;

    # Logging
    access_log /var/log/nginx/vscode.access.log;
    error_log  /var/log/nginx/vscode.error.log;

    location / {
        proxy_pass http://127.0.0.1:8000;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket Proxy Headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";

        # --- Secure CORS Directives ---
        if ($allow_origin) {
            add_header 'Access-Control-Allow-Origin' $allow_origin always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Content-Type,X-Requested-With' always;
        }

        # Handle preflight OPTIONS requests sent by browsers for CORS checks.
        if ($request_method = 'OPTIONS') {
            return 204;
        }

        # Set long timeouts
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
