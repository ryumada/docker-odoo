#!/usr/bin/env bash
set -o pipefail
# Category: Test
# Description: Fake docker for the validate-snapshot tests: a "container" is a local Postgres server (initdb/pg_ctl), or, when run with --entrypoint (the boot check's Odoo), a local process running the image's command with the container's mounts mapped to host paths.
# Usage: put this folder first on PATH; state in FAKE_DOCKER_STATE (required), Postgres binaries in PG_BIN
# Dependencies: bash, python3, PostgreSQL server binaries (initdb, pg_ctl, psql, pg_isready, pg_restore), runuser (root)
#
# Every call is appended to $FAKE_DOCKER_STATE/calls.log, every "run" to run.log, every "pull" to pull.log.
# Knobs (environment):
#   FAKE_DOCKER_DOWN=1     docker info fails (Docker not reachable)
#   FAKE_DOCKER_ROOTLESS=1 docker info reports a rootless daemon (SecurityOptions has name=rootless)
#   FAKE_DOCKER_HOST_ONLY=unix:///path  the "daemon" answers only when DOCKER_HOST is exactly this value
#                          (tests that the validator finds a rootless user's own socket by itself)
#   FAKE_NO_IMAGE=1        no image is ever cached (image inspect fails)
#   FAKE_PULL_FAIL=1       docker pull fails
#   FAKE_SLOW_RESTORE=N    the restore (psql -o /dev/null / pg_restore) first sleeps N seconds; the sleep's
#                          PID is written to $FAKE_DOCKER_STATE/slow_restore.pid so a test can kill it
#   FAKE_PG_USER=user      run Postgres as this user via runuser (set by the tests when running as root)
#   FAKE_PULL_FAIL_MATCH=s docker pull fails for images whose name contains s
#   FAKE_LOGIN_FAIL=1      docker login fails          FAKE_BUILD_FAIL=1   docker build fails
#   FAKE_ODOO_RUN_FAIL=1   docker run --entrypoint ... fails (the Odoo container does not start)
# Odoo containers (docker run --entrypoint X IMAGE CMD...): the bind mounts (--mount type=bind,src,dst) and
# --tmpfs folders are mapped to host paths; the file given to "-c" is copied with db_host/db_port pointing
# at the named Postgres "container", http_port set to a free local port, data_dir and addons_path mapped.
# Every Odoo run is logged in odoo-runs.log; build in build.log (+ builds/N/), login in login.log (with
# the password it read on stdin and DOCKER_CONFIG), tag/rmi in tag.log. Image markers in img/ hold the
# image's name.
# The Postgres server listens on 127.0.0.1 only (port chosen by the OS), with its socket in the
# container's own folder (mode 0700); TCP logins need a password nobody has (pg_isready still works).

S="${FAKE_DOCKER_STATE:?FAKE_DOCKER_STATE is not set}"
umask 077
# A real container never inherits the docker client's open files (the validator holds its queue
# lock open): close every descriptor above stderr, or a "container" would keep the lock forever.
for _fd in /proc/$$/fd/*; do
  _fd="${_fd##*/}"
  [ "$_fd" -gt 2 ] 2>/dev/null && eval "exec $_fd>&-" 2>/dev/null
done
unset _fd
mkdir -p "$S/c" "$S/net" "$S/img" 2>/dev/null
chmod 711 "$S" "$S/c" 2>/dev/null
printf '%s\n' "$*" >> "$S/calls.log"

pgbin() { echo "${PG_BIN:?PG_BIN is not set}/$1"; }
as_pg() { if [ -n "${FAKE_PG_USER:-}" ]; then runuser -u "$FAKE_PG_USER" -- "$@"; else "$@"; fi; }
img_key() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_'; }
cdir_of() {
  # Container name -> its folder (short folder names keep the socket path under 107 bytes)
  local d
  for d in "$S"/c/*; do
    [ -f "$d/name" ] && [ "$(cat "$d/name")" = "$1" ] && { echo "$d"; return 0; }
  done
  return 1
}
free_port() { python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()'; }
pg_stop() {
  # Immediate shutdown of a container's Postgres, then wait until it is gone
  local d="$1" pid
  [ -f "$d/slow.pid" ] && kill "$(cat "$d/slow.pid")" 2>/dev/null
  pid=$(head -n1 "$d/data/postmaster.pid" 2>/dev/null)
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    kill -QUIT "$pid" 2>/dev/null
    for _ in $(seq 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -KILL "$pid" 2>/dev/null
  fi
}

map_path() {
  # map_path CONTAINER_DIR PATH: a path inside the container -> the host path (longest mount first)
  local d="$1" p="$2" dst src best="" bsrc=""
  while IFS=$'\t' read -r dst src; do
    if [ "$p" = "$dst" ] || [[ "$p" == "$dst/"* ]]; then
      [ ${#dst} -ge ${#best} ] && { best="$dst"; bsrc="$src"; }   # later mounts win (the patched -c file)
    fi
  done < "$d/mounts"
  if [ -n "$best" ]; then echo "$bsrc${p#"$best"}"; else echo "$p"; fi
}

odoo_run() {
  local name="" label="" image="" entry="" net="" detach=0 mounts=() a d
  printf '%s\n' "$*" >> "$S/odoo-runs.log"
  [ "${FAKE_ODOO_RUN_FAIL:-}" = 1 ] && { echo "docker: Error response from daemon: OCI runtime create failed (fake)" >&2; return 125; }
  while [ $# -gt 0 ]; do
    case "$1" in
      -d) detach=1; shift ;;
      --name) name="$2"; shift 2 ;;
      --label) label="${2#odoo-drill=}"; shift 2 ;;
      --network) net="$2"; shift 2 ;;
      --entrypoint) entry="$2"; shift 2 ;;
      --mount) mounts+=("mount:$2"); shift 2 ;;
      --tmpfs) mounts+=("tmpfs:${2%%:*}"); shift 2 ;;
      --cpus|--memory|--memory-swap|--oom-score-adj|--pids-limit|-e|-v) shift 2 ;;
      -*) shift ;;
      *) image="$1"; shift; break ;;
    esac
  done
  [ -n "$name" ] && [ -n "$image" ] && [ -n "$entry" ] || { echo "fake docker run: name, image and entrypoint are required" >&2; return 1; }
  cdir_of "$name" >/dev/null && { echo "container $name exists" >&2; return 1; }
  [ -f "$S/img/$(img_key "$image")" ] || { echo "Unable to find image '$image' (fake)" >&2; return 125; }
  [ -n "$net" ] && [ -f "$S/net/$net" ] || { echo "network $net not found (fake)" >&2; return 1; }
  d=$(mktemp -d "$S/c/XXXXXX") || return 1
  chmod 755 "$d"
  printf '%s' "$name" > "$d/name"; printf '%s' "$label" > "$d/label"; printf '%s' "$image" > "$d/image"; echo odoo > "$d/kind"
  : > "$d/mounts"
  local m src dst ro
  for m in "${mounts[@]}"; do
    case "$m" in
      tmpfs:*)
        dst="${m#tmpfs:}"; src="$d/tmpfs$(printf '%s' "$dst" | tr '/' '_')"
        mkdir -p "$src" && chmod 1777 "$src"
        printf '%s\t%s\n' "$dst" "$src" >> "$d/mounts" ;;
      mount:*)
        src="" dst="" ro=0
        IFS=',' read -ra parts <<< "${m#mount:}"
        for a in "${parts[@]}"; do
          case "$a" in src=*|source=*) src="${a#*=}" ;; dst=*|target=*|destination=*) dst="${a#*=}" ;; readonly|ro|ro=true) ro=1 ;; esac
        done
        [ -e "$src" ] || { echo "invalid mount config: bind source path does not exist: $src (fake)" >&2; rm -rf "$d"; return 125; }
        printf '%s\t%s\n' "$dst" "$src" >> "$d/mounts"
        printf '%s %s ro=%s\n' "$name" "$dst" "$ro" >> "$S/mounts.log" ;;
    esac
  done
  # The command: map its paths; the configuration file given to -c gets the local Postgres and a free port
  local cmd=("$entry") prev="" conf_host="" pgd
  for a in "$@"; do
    if [ "$prev" = "-c" ]; then
      conf_host=$(map_path "$d" "$a")
      python3 - "$conf_host" "$d/odoo.conf" "$S" "$d" "$(free_port)" <<'PY' || { echo "fake docker: bad Odoo configuration" >&2; rm -rf "$d"; exit 1; }
import configparser, os, sys
src, out, state, cdir, port = sys.argv[1:6]
mounts = [l.rstrip("\n").split("\t") for l in open(os.path.join(cdir, "mounts")) if "\t" in l]
def mp(p):
    best = max((m for m in mounts if p == m[0] or p.startswith(m[0] + "/")), key=lambda m: len(m[0]), default=None)
    return best[1] + p[len(best[0]):] if best else p
c = configparser.ConfigParser(interpolation=None); c.read(src)
o = c["options"]
pg = None
for d in os.listdir(os.path.join(state, "c")):
    f = os.path.join(state, "c", d)
    try:
        if open(os.path.join(f, "name")).read() == o.get("db_host") and os.path.exists(os.path.join(f, "port")):
            pg = (f, open(os.path.join(f, "port")).read().strip())
    except OSError:
        pass
if pg:
    o["db_host"], o["db_port"] = pg
o["http_port"] = port
o["data_dir"] = mp(o.get("data_dir", "/var/lib/odoo"))
o["addons_path"] = ",".join(mp(p.strip()) for p in o.get("addons_path", "").split(",") if p.strip())
with open(out, "w") as f:
    c.write(f)
PY
      printf '%s\t%s\n' "$a" "$d/odoo.conf" >> "$d/mounts"
      cmd+=("$d/odoo.conf")
    else
      cmd+=("$(map_path "$d" "$a")")
    fi
    prev="$a"
  done
  printf '%s\n' "${cmd[*]}" > "$d/cmd"
  ( cd "$d" && exec setsid bash -c '"$@" > odoo.log 2>&1; echo $? > exitcode' _ "${cmd[@]}" ) </dev/null >/dev/null 2>&1 &
  echo $! > "$d/pid"
  if [ "$detach" = 0 ]; then
    wait "$(cat "$d/pid")" 2>/dev/null
    cat "$d/odoo.log"; return "$(cat "$d/exitcode" 2>/dev/null || echo 1)"
  fi
  printf 'fake%s\n' "${d##*/}"
}

if [ -n "${FAKE_DOCKER_HOST_ONLY:-}" ] && [ "${DOCKER_HOST:-}" != "$FAKE_DOCKER_HOST_ONLY" ]; then
  echo "Cannot connect to the Docker daemon at ${DOCKER_HOST:-unix:///var/run/docker.sock} (fake)" >&2; exit 1
fi
cmd="$1"; shift || true
case "$cmd" in
  info)
    [ "${FAKE_DOCKER_DOWN:-}" = 1 ] && { echo "Cannot connect to the Docker daemon (fake)" >&2; exit 1; }
    case "${1:-} ${2:-}" in
      "-f "*SecurityOptions*)
        if [ "${FAKE_DOCKER_ROOTLESS:-}" = 1 ]; then
          echo '["name=seccomp,profile=builtin","name=rootless","name=cgroupns"]'
        else
          echo '["name=apparmor","name=seccomp,profile=builtin","name=cgroupns"]'
        fi ;;
      "-f "*) mkdir -p "$S/root"; echo "$S/root" ;;
      *) echo "fake docker" ;;
    esac
    exit 0 ;;

  image)
    case "${1:-}" in
      inspect)
        [ "${FAKE_NO_IMAGE:-}" = 1 ] && exit 1
        [ -f "$S/img/$(img_key "${2:-}")" ] ;;
      ls)
        # image ls REPO --format '{{.Repository}}:{{.Tag}}'
        repo="${2:-}"
        for f in "$S"/img/*; do
          [ -f "$f" ] || continue
          n=$(cat "$f"); [ -n "$n" ] || continue
          [ -z "$repo" ] || [ "${n%:*}" = "$repo" ] && echo "$n"
        done
        exit 0 ;;
      *) exit 1 ;;
    esac ;;

  pull)
    [ "${1:-}" = "-q" ] && shift
    echo "$1" >> "$S/pull.log"
    [ "${FAKE_PULL_FAIL:-}" = 1 ] && { echo "pull failed (fake)" >&2; exit 1; }
    [ -n "${FAKE_PULL_FAIL_MATCH:-}" ] && [[ "$1" == *"$FAKE_PULL_FAIL_MATCH"* ]] && { echo "pull access denied for $1 (fake)" >&2; exit 1; }
    printf '%s' "$1" > "$S/img/$(img_key "$1")"
    echo "$1" ;;

  login)
    user="" server="" stdin=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --username|-u) user="$2"; shift 2 ;;
        --password-stdin) stdin=1; shift ;;
        -*) shift ;;
        *) server="$1"; shift ;;
      esac
    done
    pw=""; [ "$stdin" = 1 ] && pw=$(cat)
    printf 'server=%s user=%s password=%s config=%s\n' "${server:-docker.io}" "$user" "$pw" "${DOCKER_CONFIG:-}" >> "$S/login.log"
    [ "${FAKE_LOGIN_FAIL:-}" = 1 ] && { echo "unauthorized: incorrect username or password (fake)" >&2; exit 1; }
    [ -n "${DOCKER_CONFIG:-}" ] && mkdir -p "$DOCKER_CONFIG" && printf '{"auths": {"%s": {}}}' "${server:-docker.io}" > "$DOCKER_CONFIG/config.json"
    echo "Login Succeeded" ;;

  build)
    tag="" ctx="" bargs=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -t) tag="$2"; shift 2 ;;
        --label|-f) shift 2 ;;
        --build-arg) bargs+=("$2"); shift 2 ;;
        -*) shift ;;
        *) ctx="$1"; shift ;;
      esac
    done
    mkdir -p "$S/builds"
    n=$(( $(ls "$S/builds" | wc -l) + 1 ))
    mkdir -p "$S/builds/$n" && cp -a "$ctx/." "$S/builds/$n/" 2>/dev/null
    printf '%s\n' "${bargs[@]}" > "$S/builds/$n/args"
    printf '%s %s\n' "$tag" "$ctx" >> "$S/build.log"
    echo "Step 1/1 : FROM python (fake)"
    [ "${FAKE_BUILD_FAIL:-}" = 1 ] && { echo "ERROR: Could not find a version that satisfies the requirement nosuchpkg==9 (fake)" >&2; exit 1; }
    printf '%s' "$tag" > "$S/img/$(img_key "$tag")"
    echo "Successfully tagged $tag" ;;

  tag)
    [ -f "$S/img/$(img_key "$1")" ] || { echo "No such image: $1" >&2; exit 1; }
    printf '%s' "$2" > "$S/img/$(img_key "$2")"
    printf 'tag %s %s\n' "$1" "$2" >> "$S/tag.log" ;;

  rmi)
    while [[ "${1:-}" == -* ]]; do shift; done
    rc=1
    for n in "$@"; do
      [ -f "$S/img/$(img_key "$n")" ] && rm -f "$S/img/$(img_key "$n")" && rc=0 && printf 'rmi %s\n' "$n" >> "$S/tag.log"
    done
    exit $rc ;;

  logs)
    d=$(cdir_of "${*: -1}") || { echo "No such container: ${*: -1}" >&2; exit 1; }
    cat "$d/odoo.log" 2>/dev/null ;;

  inspect)
    fmt="" name=""
    while [ $# -gt 0 ]; do case "$1" in -f) fmt="$2"; shift 2 ;; *) name="$1"; shift ;; esac; done
    d=$(cdir_of "$name") || { echo "No such object: $name" >&2; exit 1; }
    running=false
    if [ -f "$d/pid" ]; then kill -0 "$(cat "$d/pid")" 2>/dev/null && [ ! -f "$d/exitcode" ] && running=true; else running=true; fi
    case "$fmt" in
      *State.Running*) echo "$running" ;;
      *State.ExitCode*) cat "$d/exitcode" 2>/dev/null || echo 0 ;;
      *) echo "{}" ;;
    esac ;;

  network)
    sub="$1"; shift
    case "$sub" in
      create)
        label="" internal=0 name=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --internal) internal=1; shift ;;
            --label) label="${2#odoo-drill=}"; shift 2 ;;
            *) name="$1"; shift ;;
          esac
        done
        [ -n "$name" ] && [ ! -e "$S/net/$name" ] || exit 1
        printf '%s %s\n' "$label" "$internal" > "$S/net/$name" ;;
      rm) [ -f "$S/net/$1" ] && rm -f "$S/net/$1" ;;
      ls)
        for f in "$S"/net/*; do
          [ -f "$f" ] || continue
          read -r label _ < "$f"
          printf '%s %s\n' "$(basename "$f")" "$label"
        done ;;
      *) exit 1 ;;
    esac ;;

  ps)
    # Only "ps -a --filter label=odoo-drill --format ..." is used: print "name run-id"
    for d in "$S"/c/*; do
      [ -f "$d/name" ] || continue
      printf '%s %s\n' "$(cat "$d/name")" "$(cat "$d/label" 2>/dev/null)"
    done ;;

  rm)
    while [[ "${1:-}" == -* ]]; do shift; done
    rc=1
    for n in "$@"; do
      d=$(cdir_of "$n") || continue
      if [ -f "$d/kind" ]; then
        [ -f "$d/pid" ] && kill -TERM -- "-$(cat "$d/pid")" 2>/dev/null
        for _ in $(seq 50); do [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null || break; sleep 0.1; done
        [ -f "$d/pid" ] && kill -KILL -- "-$(cat "$d/pid")" 2>/dev/null
      else
        pg_stop "$d"
      fi
      rm -rf "$d" && rc=0
    done
    exit $rc ;;

  run)
    printf '%s\n' "$*" >> "$S/run.log"
    case " $* " in *" --entrypoint "*) odoo_run "$@"; exit $? ;; esac
    name="" label="" image="" pgargs=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -d) shift ;;
        --name) name="$2"; shift 2 ;;
        --label) label="${2#odoo-drill=}"; shift 2 ;;
        --network|--cpus|--memory|--memory-swap|--oom-score-adj|--pids-limit|-e|--mount) shift 2 ;;
        -*) shift ;;
        *) image="$1"; shift; break ;;
      esac
    done
    while [ $# -gt 0 ]; do
      [ "$1" = "-c" ] && [ -n "${2:-}" ] && { pgargs+=("-c" "$2"); shift 2; continue; }
      shift
    done
    [ -n "$name" ] && [ -n "$image" ] || { echo "fake docker run: name and image are required" >&2; exit 1; }
    cdir_of "$name" >/dev/null && { echo "container $name exists" >&2; exit 1; }
    if [ "${FAKE_NO_IMAGE:-}" = 1 ] || [ ! -f "$S/img/$(img_key "$image")" ]; then
      echo "Unable to find image '$image' (fake)" >&2; exit 125
    fi
    # Unique folder per container, never reused: a late "docker rm" of an old container (the
    # watchdog and the drill's own cleanup may both remove it) must never hit a new one
    d=$(mktemp -d "$S/c/XXXXXX") || exit 1
    n="${d##*/}"
    printf '%s' "$name" > "$d/name"; printf '%s' "$label" > "$d/label"; printf '%s' "$image" > "$d/image"
    if [ -n "${FAKE_PG_USER:-}" ]; then chmod 711 "$d"; chown "$FAKE_PG_USER" "$d"; fi
    as_pg "$(pgbin initdb)" -D "$d/data" -U postgres --auth-local=trust --auth-host=scram-sha-256 \
      -E UTF8 --no-sync >"$d/initdb.log" 2>&1 || { echo "initdb failed (see $d/initdb.log)" >&2; exit 1; }
    opts="-c listen_addresses=127.0.0.1 -k $d -c unix_socket_permissions=0700"
    for a in "${pgargs[@]}"; do [ "$a" = "-c" ] || opts="$opts -c $a"; done
    for _ in 1 2 3 4 5; do
      port=$(free_port)
      if as_pg "$(pgbin pg_ctl)" -D "$d/data" -l "$d/data/server.log" -w -t 30 -o "$opts -p $port" start >/dev/null 2>&1; then
        echo "$port" > "$d/port"
        printf 'fake%s\n' "$n"
        exit 0
      fi
    done
    echo "Postgres did not start (see $d/data/server.log)" >&2
    exit 1 ;;

  exec)
    interactive=0
    while [[ "${1:-}" == -* ]]; do [ "$1" = "-i" ] && interactive=1; shift; done
    name="$1"; shift
    d=$(cdir_of "$name") || { echo "No such container: $name" >&2; exit 1; }
    if [ -f "$d/kind" ]; then
      # Odoo container: run the command here with its paths mapped
      mapped=()
      for a in "$@"; do mapped+=("$(map_path "$d" "$a")"); done
      [ "$interactive" = 1 ] || exec </dev/null
      exec "${mapped[@]}"
    fi
    port=$(cat "$d/port" 2>/dev/null)
    tool="$1"; shift
    case "$tool" in
      pg_isready)
        exec "$(pgbin pg_isready)" -h 127.0.0.1 -p "$port" -q -t 2 ;;
      psql|pg_restore)
        args=()
        restore=0
        [ "$tool" = pg_restore ] && restore=1
        while [ $# -gt 0 ]; do
          case "$1" in
            -h|-p) shift 2; continue ;;
            -o) [ "${2:-}" = /dev/null ] && restore=1; args+=("$1" "$2"); shift 2; continue ;;
          esac
          args+=("$1"); shift
        done
        if [ "$restore" = 1 ] && [ -n "${FAKE_SLOW_RESTORE:-}" ]; then
          sleep "$FAKE_SLOW_RESTORE" &
          sp=$!
          echo "$sp" > "$S/slow_restore.pid"; echo "$sp" > "$d/slow.pid"
          trap 'kill "$sp" 2>/dev/null; exit 143' TERM INT HUP
          wait "$sp" 2>/dev/null
          trap - TERM INT HUP
          rm -f "$d/slow.pid"
          [ -d "$d/data" ] || exit 1
        fi
        [ "$interactive" = 1 ] || exec </dev/null
        exec "$(pgbin "$tool")" -h "$d" -p "$port" "${args[@]}" ;;
      *) echo "fake docker exec: unsupported command $tool" >&2; exit 1 ;;
    esac ;;

  *) echo "fake docker: unsupported command '$cmd'" >&2; exit 1 ;;
esac
