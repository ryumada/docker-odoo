#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Clones an Odoo database to another environment via the web endpoint.
# Usage: ./scripts/databasecloner.sh [TARGET_DB_NAME]
# Dependencies: curl, docker, sudo, git, rsync, ssh

# Detect Repository Owner to run non-root commands as that user
CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_ODOO")

if [ -f "$CURRENT_DIR/lib/odoo_utils.sh" ]; then
    source "$CURRENT_DIR/lib/odoo_utils.sh"
elif [ -f "$CURRENT_DIR/../lib/odoo_utils.sh" ]; then
    source "$CURRENT_DIR/../lib/odoo_utils.sh"
fi

if [ -f "$CURRENT_DIR/lib/ssh_utils.sh" ]; then
    source "$CURRENT_DIR/lib/ssh_utils.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/ssh_utils.sh" ]; then
    source "$PATH_TO_ODOO/scripts/lib/ssh_utils.sh"
fi

# Configuration
ENV_FILE=".env"
UPDATE_SCRIPT="./scripts/update-env-file.sh"
MAX_BACKUPS=3
JSON_MODE="${JSON_MODE:-false}"

# --- Logging Functions & Colors ---
# Define colors for log messages
readonly COLOR_RESET="\033[0m"
readonly COLOR_INFO="\033[0;34m"
readonly COLOR_SUCCESS="\033[0;32m"
readonly COLOR_WARN="\033[1;33m"
readonly COLOR_ERROR="\033[0;31m"
readonly COLOR_CYAN="\033[0;36m"

# Function to log messages with a specific color and emoji
log() {
  local color="$1"
  local emoji="$2"
  local message="$3"
  if [ "$JSON_MODE" = "true" ]; then
    echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}" >&2
  else
    echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
  fi
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() {
  if [ "$JSON_MODE" = "true" ]; then
    local escaped_msg
    escaped_msg=$(echo -n "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
    echo "{\"error\": \"$escaped_msg\"}"
  fi
  log "${COLOR_ERROR}" "❌" "$1"
}
log_stage() { log "${COLOR_CYAN}" "📋" "$1"; }

function fail_with_json() {
  local message="$1"
  log_error "$message"
  exit 1
}
# ------------------------------------

function checkOdooEndpoint() {
  local port="$1"
  log_info "Checking if Odoo endpoint is accessible on port $port..."

  if curl --output /dev/null --silent --head --fail "http://localhost:$port"; then
    log_success "Odoo endpoint is accessible on port $port."
    return 0
  else
    log_warn "Odoo endpoint is NOT accessible at http://localhost:$port. Retrying with longer timeout..."
    if curl --output /dev/null --silent --head --fail --connect-timeout 10 "http://localhost:$port"; then
      log_success "Odoo endpoint is accessible on port $port after retry."
      return 0
    else
      fail_with_json "Odoo endpoint is NOT accessible at http://localhost:$port. Please check if the service is running."
    fi
  fi
}

error_handler() {
  local exit_code=$1
  local line_no=$2
  local command_name=$3

  # Restore stderr to the original descriptor to stop logging to the temp file
  if [ -n "${STDERR_LOG:-}" ]; then
    exec 2>&3
  fi

  log_error "An error occurred on line $line_no."
  log_error "Exit Code: $exit_code"
  log_error "Command: $command_name"

  # Allow tee to finish flushing
  sleep 0.2

  if [ -f "${STDERR_LOG:-}" ] && [ -s "$STDERR_LOG" ]; then
    log_error "Captured stderr output:"
    while IFS= read -r line; do
      log_error "  $line"
    done < <(tail -n 20 "$STDERR_LOG")
  fi

  exit "$exit_code"
}

# Save original stderr to file descriptor 3 and redirect to temp file & descriptor 3
STDERR_LOG=$(mktemp)
exec 3>&2
exec 2> >(tee -a "$STDERR_LOG" >&3)

trap 'error_handler $? $LINENO "$BASH_COMMAND"' ERR

# --- Centralized Cleanup Hook ---
cleanup_temp_files() {
    if [ -n "${TEMP_BACKUP_FILE:-}" ] && [ -f "$TEMP_BACKUP_FILE" ]; then
        rm -f "$TEMP_BACKUP_FILE"
    fi
    local owner_home
    owner_home=$(eval echo "~$REPOSITORY_OWNER")
    [ -n "$owner_home" ] && rm -f "$owner_home/backupdata-$SERVICE_NAME.zip" 2>/dev/null || true
    rm -f "/tmp/${STG_DB_NAME:-}.sql" "/tmp/${STG_DB_NAME:-}.sql.zst" "/tmp/backupdata-$SERVICE_NAME.zip" 2>/dev/null || true
    # Delete temp stderr log
    if [ -n "${STDERR_LOG:-}" ] && [ -f "$STDERR_LOG" ]; then
        rm -f "$STDERR_LOG"
    fi
    if [ -n "${CURL_OUT:-}" ] && [ -f "$CURL_OUT" ]; then
        rm -f "$CURL_OUT"
    fi
}
trap cleanup_temp_files EXIT

function promptWhichEnvironment() {
  local environment="$1"
  local ODOO_DEPLOYMENT_ENVIRONMENT
  local input_env

  if [ "$environment" == "" ]; then
    # You need to choose whether there are multiple environments for your deployment
    while true; do
      printf "Which environment you wish to clone the data to?\r\n" >&3
      printf "[1] Development (dev)\r\n" >&3
      printf "[2] Staging (stg)\r\n" >&3
      printf "[3] Testing (tst)\r\n" >&3
      printf "[4] Other\r\n\r\n" >&3
      printf ">> Enter the number 1 - 4: " >&3
      read -r input_env

      if [[ ! "$input_env" =~ ^[1-9]+$ ]]; then
        log_error "Invalid input. Please enter a number base on the menu above."
        continue
      fi

      case $input_env in
        1)
          ODOO_DEPLOYMENT_ENVIRONMENT=dev
          break
          ;;
        2)
          ODOO_DEPLOYMENT_ENVIRONMENT=stg
          break
          ;;
        3)
          ODOO_DEPLOYMENT_ENVIRONMENT=tst
          break
          ;;
        4)
          read -rp "Enter the environment name: " ODOO_DEPLOYMENT_ENVIRONMENT
          break
          ;;
        *)
          log_error "Invalid option"
          ;;
      esac
    done
  else
    ODOO_DEPLOYMENT_ENVIRONMENT=$environment
  fi

  echo "$ODOO_DEPLOYMENT_ENVIRONMENT"
}

function get_next_prefix() {
  local env_file="$1"
  local current_count
  local next_count

  # Read existing count
  current_count=$(grep "^DB_PREFIX_COUNT=" "$env_file" | cut -d "=" -f 2 | tr -d '[:space:]')

  # Initialize if empty or not a number
  if [[ ! "$current_count" =~ ^[0-9]+$ ]]; then
    current_count=-1
  fi

  # Increment
  next_count=$((current_count + 1))

  # Reset if > 999
  if [ "$next_count" -gt 999 ]; then
    next_count=0
  fi

  # Update .env file
  if grep -q "^DB_PREFIX_COUNT=" "$env_file"; then
     sed -i "s/^DB_PREFIX_COUNT=.*/DB_PREFIX_COUNT=$next_count/" "$env_file"
  else
     echo "DB_PREFIX_COUNT=$next_count" >> "$env_file"
  fi

  # Output formatted with leading zeros
  printf "%03d" "$next_count"
}

function promptClonedDBName() {
  local env_file="$1"
  local use_date_suffix="$2"
  local ODOO_DEPLOYMENT_ENVIRONMENT="$3"
  local ODOO_DB_NAME_ENV
  local DB_PREFIX
  DB_PREFIX=$(get_next_prefix "$env_file")
  local USE_DATE_SUFFIX_INPUT

  case "$use_date_suffix" in
    N|n)
      ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT"
      ;;
    prompt)
      while true; do
        read -rp "Do you want to use a date suffix for the new database name? [Y/n]: " USE_DATE_SUFFIX_INPUT

        case "$USE_DATE_SUFFIX_INPUT" in
          Y|y)
            ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT-$(date +"%Y%m%d_%H%M%S")"; break ;;
          N|n)
            ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT"; break ;;
          *)
            log_error "Invalid option" ;;
        esac
      done
      ;;
    *)
      ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT-$(date +"%Y%m%d_%H%M%S")"
      ;;
  esac

  echo "$ODOO_DB_NAME_ENV"
}

function run_psql() {
  local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
  local db_host=$(grep "^DB_HOST=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
  local has_db=false
  for arg in "$@"; do
    if [[ "$arg" == "-d" || "$arg" == -d* || "$arg" == "--dbname="* || "$arg" == "--dbname" ]]; then
      has_db=true
      break
    fi
  done
  local db_default=()
  if [ "$has_db" = false ]; then
    db_default=(-d postgres)
  fi
  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port=$(grep "^DB_PORT=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    local db_user=$(grep "^ACTIVE_DB_USER=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    [ -z "$db_user" ] && db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
    local db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
    local docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    local net=$(echo "$docker_net" | cut -d "," -f 1)
    PGPASSWORD="$db_pass" docker run -i --rm --network="$net" -e PGPASSWORD postgres psql -h "$db_host" -p "$db_port" -U "$db_user" "${db_default[@]}" "$@"
  else
    sudo -u postgres psql "${db_default[@]}" "$@"
  fi
}

function sanitize_database() {
  local db_name="$1"
  log_info "Neutralizing the database (SMTP, Crons, Webhooks, Payments, and activating Neutralized Banner)..."

  local SANITIZE_SQL
  SANITIZE_SQL=$(cat << 'EOF'
    DO $$
    BEGIN
        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_mail_server' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_mail_server SET active = false';
            EXECUTE 'INSERT INTO ir_mail_server(name, smtp_port, smtp_host, smtp_encryption, active, smtp_authentication)
            VALUES (''neutralization - disable emails'', 1025, ''invalid'', ''none'', true, ''login'')
            ON CONFLICT DO NOTHING';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_cron' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_cron
               SET active = false
             WHERE id NOT IN (
                   SELECT res_id
                     FROM ir_model_data
                    WHERE model = ''ir.cron''
                      AND name = ''autovacuum_job''
                      AND module = ''base''
             )';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_config_parameter' AND column_name = 'key') THEN
            EXECUTE 'INSERT INTO ir_config_parameter (key, value)
            VALUES (''database.is_neutralized'', true)
                ON CONFLICT (key) DO UPDATE SET value = true';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_act_server' AND column_name = 'webhook_url') THEN
            EXECUTE 'UPDATE ir_act_server SET webhook_url = ''neutralization - disable webhook'' WHERE state = ''webhook''';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'mail_template' AND column_name = 'mail_server_id') THEN
            EXECUTE 'UPDATE mail_template SET mail_server_id = NULL';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'fetchmail_server' AND column_name = 'active') THEN
            EXECUTE 'UPDATE fetchmail_server SET active = false';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_config_parameter' AND column_name = 'key') THEN
            EXECUTE 'DELETE FROM ir_config_parameter WHERE key IN (''mail.web_push_vapid_private_key'', ''mail.web_push_vapid_public_key'', ''mail.sfu_server_key'')';
        END IF;

        IF EXISTS (SELECT FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'mail_push') THEN
            EXECUTE 'TRUNCATE mail_push CASCADE';
        END IF;

        IF EXISTS (SELECT FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'mail_push_device') THEN
            EXECUTE 'DELETE FROM mail_push_device';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_ui_view' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_ui_view SET active = true WHERE key = ''web.neutralize_banner''';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'payment_provider' AND column_name = 'state') THEN
            EXECUTE 'UPDATE payment_provider SET state = ''disabled'' WHERE state NOT IN (''test'', ''disabled'')';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'auth_oauth_provider' AND column_name = 'enabled') THEN
            EXECUTE 'UPDATE auth_oauth_provider SET enabled = false';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'res_users_settings' AND column_name = 'google_calendar_rtoken') THEN
            EXECUTE 'UPDATE res_users_settings SET google_calendar_rtoken = NULL, google_calendar_token = NULL, google_synchronization_stopped = True';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'iap_account' AND column_name = 'account_token') THEN
            EXECUTE 'UPDATE iap_account SET account_token = REGEXP_REPLACE(account_token, ''(\+.*)?$'', ''+disabled'') WHERE LENGTH(account_token) <= 33';
            EXECUTE 'UPDATE iap_account SET account_token = ''dummy_value+disabled'' WHERE LENGTH(account_token) > 33 AND account_token NOT LIKE ''%+disabled''';
        END IF;
    END $$;
EOF
)

  if run_psql -d "$db_name" -c "$SANITIZE_SQL" > /dev/null 2>&1; then
    log_success "Database successfully neutralized."
  else
    log_warn "Warning: Failed to sanitize database completely (SQL command failed)."
  fi
}

function run_automated_pull_mode() {
  local TARGET_DB="${1:-}"
  local MODULES_TO_UPDATE="${2:-}"

  local STG_PATH_TO_ODOO="$PATH_TO_ODOO"
  local SERVICE_NAME_PRD="${SERVICE_NAME%-*}"
  local STG_ENV_FILE="$STG_PATH_TO_ODOO/.env"
  if [ ! -f "$STG_ENV_FILE" ]; then
    fail_with_json "Target .env file not found at $STG_ENV_FILE"
  fi

  local prev_stg_db
  prev_stg_db=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^DB_NAME=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)

  if [ -n "$TARGET_DB" ]; then
    STG_DB_NAME="$TARGET_DB"
  else
    STG_DB_NAME="$prev_stg_db"
    if [ -z "$STG_DB_NAME" ]; then
      STG_DB_NAME="$(get_next_prefix "$STG_ENV_FILE")-$SERVICE_NAME-$(date +"%Y%m%d-%H%M%S")"
    fi
  fi

  local PRD_SSH_HOST PRD_SSH_USER PRD_SSH_PORT PRD_SSH_KEY PRD_SSH_PATH
  PRD_SSH_HOST=$(grep "^PRD_SSH_HOST=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  PRD_SSH_USER=$(grep "^PRD_SSH_USER=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  PRD_SSH_PORT=$(grep "^PRD_SSH_PORT=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  PRD_SSH_KEY=$(grep "^PRD_SSH_KEY=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  PRD_SSH_PATH=$(grep "^PRD_SSH_PATH=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  [ -z "$PRD_SSH_PORT" ] && PRD_SSH_PORT="22"

  export PSQL_ENV_FILE="$STG_ENV_FILE"
  local PRD_DB_NAME=""
  local PRD_ENV_FILE=""

  if [ -n "$PRD_SSH_HOST" ]; then
    # --- Cross-VPS Pull Mode ---
    if [ -z "$PRD_SSH_USER" ] || [ -z "$PRD_SSH_PATH" ]; then
      fail_with_json "PRD_SSH_USER and PRD_SSH_PATH are required when PRD_SSH_HOST is configured in .env!"
    fi

    local PRD_SERVICE_NAME
    PRD_SERVICE_NAME=$(basename "$PRD_SSH_PATH")

    log_stage "[1/3] Connecting to Remote Production VPS ($PRD_SSH_USER@$PRD_SSH_HOST:$PRD_SSH_PORT)..."

    local key_path
    if declare -f ensure_ssh_key_for_remote >/dev/null 2>&1; then
      key_path=$(ensure_ssh_key_for_remote "deploy_rc" "$PRD_SSH_HOST" "$PRD_SSH_USER" "$PRD_SSH_KEY" "$REPOSITORY_OWNER" "PRD_SSH_KEY" "$STG_ENV_FILE")
    else
      local owner_home
      owner_home=$(eval echo "~$REPOSITORY_OWNER")
      [ -z "$owner_home" ] && owner_home="$HOME"
      key_path="${PRD_SSH_KEY/#\~/$owner_home}"
    fi

    local prd_ssh_opts=(-p "$PRD_SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5)
    local prd_rsync_ssh="ssh -p $PRD_SSH_PORT -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5"
    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
      prd_ssh_opts+=(-i "$key_path")
      prd_rsync_ssh+=" -i $key_path"
    fi

    if ! ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "true" 2>/dev/null; then
      fail_with_json "Failed to establish SSH connection with Remote Production VPS at $PRD_SSH_USER@$PRD_SSH_HOST:$PRD_SSH_PORT."
    fi
    log_success "SSH connection to Production VPS established."

    local remote_prd_db
    remote_prd_db=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "sed -e 's/#.*//' '$PRD_SSH_PATH/.env' 2>/dev/null | grep '^DB_NAME=' | cut -d '=' -f2- | tr -d '[:space:]\"' | tr -d \"'\" || true" | tr -d '\r\n')
    [ -z "$remote_prd_db" ] && remote_prd_db="$PRD_SERVICE_NAME"
    PRD_DB_NAME="$remote_prd_db"

    local remote_has_zstd
    remote_has_zstd=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "command -v zstd >/dev/null 2>&1 && echo true || echo false" | tr -d '\r\n')

    local local_filestore_base="/var/lib/odoo/$SERVICE_NAME/filestore"
    local local_target_filestore="$local_filestore_base/$STG_DB_NAME"
    mkdir -p "$local_filestore_base"

    if [ -n "$prev_stg_db" ] && [ "$prev_stg_db" != "$STG_DB_NAME" ]; then
      local old_pull_filestore="$local_filestore_base/$prev_stg_db"
      if [ -d "$old_pull_filestore" ] && [ ! -d "$local_target_filestore" ]; then
        log_info "Moving previous filestore for incremental rsync: $old_pull_filestore -> $local_target_filestore"
        mv "$old_pull_filestore" "$local_target_filestore"
      elif [ -d "$old_pull_filestore" ]; then
        rm -rf "$old_pull_filestore"
      fi
    fi

    if [ ! -d "$local_target_filestore" ]; then
      local existing_seed_filestore
      existing_seed_filestore=$(find "$local_filestore_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1 || true)
      if [ -n "$existing_seed_filestore" ] && [ -d "$existing_seed_filestore" ]; then
        log_info "Seeding filestore from existing local directory: $existing_seed_filestore..."
        cp -al "$existing_seed_filestore" "$local_target_filestore" 2>/dev/null || cp -r "$existing_seed_filestore" "$local_target_filestore" 2>/dev/null || true
      else
        mkdir -p "$local_target_filestore"
      fi
    fi

    log_info "Synchronizing Odoo filestore from Remote Production VPS ($PRD_DB_NAME -> $STG_DB_NAME)..."
    local remote_has_export_helper
    remote_has_export_helper=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "
      if command -v export_filestore-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/export_filestore-$PRD_SERVICE_NAME' ] || [ -f '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh' ] || [ -f '$PRD_SSH_PATH/scripts/export_filestore.sh' ]; then
        echo 'true'
      elif [ -f '$PRD_SSH_PATH/scripts/installer/install-export_filestore.sh' ] && sudo -n true 2>/dev/null; then
        sudo -n bash '$PRD_SSH_PATH/scripts/installer/install-export_filestore.sh' >/dev/null 2>&1 || true
        if command -v export_filestore-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/export_filestore-$PRD_SERVICE_NAME' ]; then
          echo 'true'
        else
          echo 'false'
        fi
      else
        echo 'false'
      fi
    " | tr -d '\r\n')

    if [ "$remote_has_export_helper" = "true" ]; then
      log_info "Streaming remote filestore via export_filestore helper..."
      local remote_export_cmd="if command -v export_filestore-$PRD_SERVICE_NAME &>/dev/null; then sudo -n export_filestore-$PRD_SERVICE_NAME; elif [ -x '/usr/local/sbin/export_filestore-$PRD_SERVICE_NAME' ]; then sudo -n /usr/local/sbin/export_filestore-$PRD_SERVICE_NAME; elif [ -f '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh' ]; then sudo -n '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh'; else sudo -n '$PRD_SSH_PATH/scripts/export_filestore.sh'; fi"
      if [ "$remote_has_zstd" = "true" ] && command -v zstd >/dev/null 2>&1; then
        ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_export_cmd" | zstd -d -T0 | tar -C "$local_target_filestore" -xf -
      else
        ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_export_cmd" | tar -C "$local_target_filestore" -xf -
      fi
    else
      log_info "Syncing filestore via rsync from /var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/..."
      rsync -e "$prd_rsync_ssh" -avz --delete "$PRD_SSH_USER@$PRD_SSH_HOST:/var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/" "$local_target_filestore/" 2>/dev/null || \
      rsync -e "$prd_rsync_ssh" -avz "$PRD_SSH_USER@$PRD_SSH_HOST:/var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/" "$local_target_filestore/" 2>/dev/null || \
      log_warn "Filestore direct rsync skipped or partially transferred."
    fi
    chown -R odoo:odoo "$local_target_filestore" 2>/dev/null || true
    log_success "Filestore synchronization completed."

    log_stage "[2/3] Dumping & Restoring Remote Production Database ($PRD_DB_NAME -> $STG_DB_NAME)..."
    local remote_has_dump_helper
    remote_has_dump_helper=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "
      if command -v dump_database-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/dump_database-$PRD_SERVICE_NAME' ] || [ -f '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh' ] || [ -f '$PRD_SSH_PATH/scripts/dump_database.sh' ]; then
        echo 'true'
      elif [ -f '$PRD_SSH_PATH/scripts/installer/install-dump_database.sh' ] && sudo -n true 2>/dev/null; then
        sudo -n bash '$PRD_SSH_PATH/scripts/installer/install-dump_database.sh' >/dev/null 2>&1 || true
        if command -v dump_database-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/dump_database-$PRD_SERVICE_NAME' ]; then
          echo 'true'
        else
          echo 'false'
        fi
      else
        echo 'false'
      fi
    " | tr -d '\r\n')

    local remote_dump_b64=""

    log_info "Recreating staging database '$STG_DB_NAME'..."
    run_psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$STG_DB_NAME' AND pid <> pg_backend_pid();" >/dev/null 2>&1 || true
    run_psql -d postgres -c "DROP DATABASE IF EXISTS \"$STG_DB_NAME\"" >/dev/null 2>&1 || true

    local local_db_user
    local_db_user=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^ACTIVE_DB_USER=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
    [ -z "$local_db_user" ] && local_db_user=$(cat "$STG_PATH_TO_ODOO/.secrets/db_user" 2>/dev/null || echo "odoo")
    run_psql -d postgres -c "CREATE DATABASE \"$STG_DB_NAME\" OWNER \"$local_db_user\"" >/dev/null 2>&1 || run_psql -d postgres -c "CREATE DATABASE \"$STG_DB_NAME\"" >/dev/null 2>&1

    restore_via_odoo_container() {
      local stg_db_host
      stg_db_host=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^DB_HOST=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
      local stg_db_port
      stg_db_port=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^DB_PORT=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
      [ -z "$stg_db_host" ] && stg_db_host="localhost"
      [ -z "$stg_db_port" ] && stg_db_port="5432"

      local stg_db_pass
      stg_db_pass=$(cat "$STG_PATH_TO_ODOO/.secrets/db_password" 2>/dev/null | tr -d '[:space:]' || true)

      local odoo_cid
      odoo_cid=$(cd "$STG_PATH_TO_ODOO" && docker compose ps -q odoo 2>/dev/null || true)
      if [ -n "$odoo_cid" ]; then
        (
          cd "$STG_PATH_TO_ODOO"
          PGPASSWORD="$stg_db_pass" docker exec -i -e PGPASSWORD "$odoo_cid" psql -h "$stg_db_host" -p "$stg_db_port" -U "$local_db_user" "$@"
        )
      else
        run_psql "$@"
      fi
    }

    local remote_dump_file=""
    if [ "$remote_has_dump_helper" = "true" ]; then
      log_info "Streaming remote database dump via dump_database helper..."
      local remote_dump_cmd="if command -v dump_database-$PRD_SERVICE_NAME &>/dev/null; then sudo -n dump_database-$PRD_SERVICE_NAME; elif [ -x '/usr/local/sbin/dump_database-$PRD_SERVICE_NAME' ]; then sudo -n /usr/local/sbin/dump_database-$PRD_SERVICE_NAME; elif [ -f '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh' ]; then sudo -n '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh'; else sudo -n '$PRD_SSH_PATH/scripts/dump_database.sh'; fi"
      local ssh_status=0
      if [ "$remote_has_zstd" = "true" ] && command -v zstd >/dev/null 2>&1; then
        ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_dump_cmd" | zstd -d -T0 | restore_via_odoo_container -d "$STG_DB_NAME" >/dev/null
        ssh_status=${PIPESTATUS[0]}
      else
        ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_dump_cmd --raw" | restore_via_odoo_container -d "$STG_DB_NAME" >/dev/null
        ssh_status=${PIPESTATUS[0]}
      fi
      if [ "$ssh_status" -ne 0 ]; then
        fail_with_json "Database streaming restore from remote production failed (SSH exit code: $ssh_status)."
      fi
    else
      log_info "dump_database helper not found on remote; dumping on production host via container pg_dump..."
      local remote_tmp_base="/tmp/${STG_DB_NAME}"
      local remote_exec_cmd="echo '$remote_dump_b64' | base64 -d | bash -s -- '$PRD_SSH_PATH' '$remote_prd_db' '$remote_tmp_base'"
      local remote_dump_out=""
      if ! remote_dump_out=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_exec_cmd" 2>&1); then
        fail_with_json "Database dump on remote production host failed. Output: $remote_dump_out"
      fi
      remote_dump_file=$(echo "$remote_dump_out" | tail -n 1 | tr -d '\r\n')
      if [ -z "$remote_dump_file" ] || [[ "$remote_dump_file" != /tmp/* ]]; then
        fail_with_json "Database dump on remote production host failed. Output: $remote_dump_out"
      fi

      log_info "Moving database dump from Production VPS to staging environment ($remote_dump_file)..."
      local local_dump_file="/tmp/$(basename "$remote_dump_file")"
      if [ "$JSON_MODE" = "true" ]; then
        if ! rsync -az -e "$prd_rsync_ssh" "$PRD_SSH_USER@$PRD_SSH_HOST:$remote_dump_file" "$local_dump_file" >&2; then
          ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true
          fail_with_json "Failed to transfer database dump from Production VPS."
        fi
      else
        if ! rsync -az -e "$prd_rsync_ssh" "$PRD_SSH_USER@$PRD_SSH_HOST:$remote_dump_file" "$local_dump_file"; then
          ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true
          fail_with_json "Failed to transfer database dump from Production VPS."
        fi
      fi
      ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true

      log_info "Restoring SQL into '$STG_DB_NAME'..."
      if [[ "$local_dump_file" == *.zst ]] && command -v zstd >/dev/null 2>&1; then
        zstd -d -c "$local_dump_file" | restore_via_odoo_container -d "$STG_DB_NAME" >/dev/null
      else
        restore_via_odoo_container -d "$STG_DB_NAME" < "$local_dump_file" >/dev/null
      fi
      rm -f "$local_dump_file"
    fi

    log_info "Reassigning database object ownership to role '$local_db_user'..."
    run_psql -d "$STG_DB_NAME" -c "
      DO \$\$
      DECLARE
        rec RECORD;
      BEGIN
        FOR rec IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') LOOP
          EXECUTE 'ALTER TABLE ' || quote_ident(rec.tablename) || ' OWNER TO \"$local_db_user\"';
        END LOOP;
        FOR rec IN (SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public') LOOP
          EXECUTE 'ALTER SEQUENCE ' || quote_ident(rec.sequence_name) || ' OWNER TO \"$local_db_user\"';
        END LOOP;
        FOR rec IN (SELECT table_name FROM information_schema.views WHERE table_schema = 'public') LOOP
          EXECUTE 'ALTER VIEW ' || quote_ident(rec.table_name) || ' OWNER TO \"$local_db_user\"';
        END LOOP;
        FOR rec IN (SELECT matviewname FROM pg_matviews WHERE schemaname = 'public') LOOP
          EXECUTE 'ALTER MATERIALIZED VIEW ' || quote_ident(rec.matviewname) || ' OWNER TO \"$local_db_user\"';
        END LOOP;
      END \$\$;
    " >/dev/null 2>&1 || true

    local NEUTRALIZE_DB
    NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' | tr '[:upper:]' '[:lower:]' || true)
    [ -z "$NEUTRALIZE_DB" ] && NEUTRALIZE_DB="true"
    if [ "$NEUTRALIZE_DB" = "true" ]; then
      sanitize_database "$STG_DB_NAME"
    fi
  else
    # --- Same-VPS Endpoint Pull Mode ---
    if [ "$SERVICE_NAME" = "$SERVICE_NAME_PRD" ]; then
      fail_with_json "Cannot clone production database onto itself ($SERVICE_NAME)."
    fi

    local PRD_PATH_TO_ODOO="$STG_PATH_TO_ODOO/../$SERVICE_NAME_PRD"
    PRD_ENV_FILE="$PRD_PATH_TO_ODOO/.env"
    if [ ! -f "$PRD_ENV_FILE" ]; then
      fail_with_json "Production .env file not found at $PRD_ENV_FILE"
    fi

    PRD_DB_NAME=$(sed -e 's/#.*//' "$PRD_ENV_FILE" 2>/dev/null | grep "^DB_NAME=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
    if [ -z "$PRD_DB_NAME" ]; then
      fail_with_json "DB_NAME not set in production .env ($PRD_ENV_FILE)."
    fi

    local STG_PORT STG_ADMIN_PASSWD PRD_PORT PRD_ADMIN_PASSWD
    STG_PORT=$(grep "^PORT=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    STG_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    PRD_PORT=$(grep "^PORT=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    PRD_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)

    if [ -z "$STG_ADMIN_PASSWD" ] || [ -z "$STG_PORT" ] || [ -z "$PRD_ADMIN_PASSWD" ] || [ -z "$PRD_PORT" ]; then
      fail_with_json "ADMIN_PASSWD and/or PORT not set in source or destination .env file."
    fi

    log_stage "[1/3] Checking Source & Destination Odoo Endpoints..."
    if ! curl -s -o /dev/null "http://localhost:$STG_PORT"; then
      log_warn "Staging environment is not running. Starting it..."
      docker compose -f "$STG_PATH_TO_ODOO/docker-compose.yml" up -d >/dev/null 2>&1 || true
      sleep 15
    fi
    checkOdooEndpoint "$STG_PORT"
    checkOdooEndpoint "$PRD_PORT"

    local OWNER_HOME
    OWNER_HOME=$(eval echo "~$REPOSITORY_OWNER")
    local ODOO_TMP_DIR="$OWNER_HOME/.odoo-tmp/$SERVICE_NAME"
    mkdir -p "$ODOO_TMP_DIR" 2>/dev/null || true
    chmod 700 "$OWNER_HOME/.odoo-tmp" "$ODOO_TMP_DIR" 2>/dev/null || true
    chown -R "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$OWNER_HOME/.odoo-tmp" 2>/dev/null || true
    TEMP_BACKUP_FILE="$ODOO_TMP_DIR/cloner_backup-$SERVICE_NAME.zip"

    log_info "Dropping old database '$STG_DB_NAME' if it exists..."
    curl -s -X POST \
      --data-urlencode "master_pwd@"<(printf '%s' "$STG_ADMIN_PASSWD") \
      -d "name=$STG_DB_NAME" \
      "http://localhost:$STG_PORT/web/database/drop" >/dev/null 2>&1 || true

    log_info "Requesting backup from production $SERVICE_NAME_PRD ($PRD_DB_NAME)..."
    printf '%s' "$PRD_ADMIN_PASSWD" | curl -s -X POST \
      -F "master_pwd=<-" \
      -F "name=$PRD_DB_NAME" \
      -F "backup_format=zip" \
      -o "$TEMP_BACKUP_FILE" \
      "http://localhost:$PRD_PORT/web/database/backup"

    if [ ! -s "$TEMP_BACKUP_FILE" ]; then
      fail_with_json "Backup failed for production $SERVICE_NAME_PRD instance. Output file is empty."
    fi
    if grep -q -i "<html" "$TEMP_BACKUP_FILE"; then
      local ODOO_ERROR_MSG
      ODOO_ERROR_MSG=$(grep -a '<div class="alert alert-danger">' "$TEMP_BACKUP_FILE" | sed -n 's/.*<div class="alert alert-danger">\(.*\)<\/div>.*/\1/p' || true)
      fail_with_json "Backup failed! Odoo returned HTML error: ${ODOO_ERROR_MSG:-Unknown error}"
    fi

    log_stage "[2/3] Restoring Backup to Staging ($STG_DB_NAME)..."
    local NEUTRALIZE_DB
    NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' | tr '[:upper:]' '[:lower:]' || true)
    if [ -z "$NEUTRALIZE_DB" ]; then
      NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$PRD_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' | tr '[:upper:]' '[:lower:]' || true)
    fi
    [ -z "$NEUTRALIZE_DB" ] && NEUTRALIZE_DB="true"

    local ODOO_VERSION ODOO_VERSION_NUM
    ODOO_VERSION=$(grep "^ODOO_VERSION=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    ODOO_VERSION_NUM=${ODOO_VERSION%%.*}
    if [[ ! "$ODOO_VERSION_NUM" =~ ^[0-9]+$ ]]; then
      if [[ "$ODOO_VERSION" == "latest" ]]; then ODOO_VERSION_NUM=18; else ODOO_VERSION_NUM=16; fi
    fi

    local CURL_RESTORE_ARGS=(
      -sS -X POST
      -F "master_pwd=<-"
      -F "name=$STG_DB_NAME"
      -F "backup_file=@$TEMP_BACKUP_FILE"
      -F "copy=true"
    )
    if [ "$ODOO_VERSION_NUM" -ge 16 ]; then
      CURL_RESTORE_ARGS+=(-F "neutralize_database=$NEUTRALIZE_DB")
    fi

    local response
    response=$(printf '%s' "$STG_ADMIN_PASSWD" | curl "${CURL_RESTORE_ARGS[@]}" \
      --connect-timeout 10 \
      --max-time 3600 \
      "http://localhost:$STG_PORT/web/database/restore")
    rm -f "$TEMP_BACKUP_FILE"

    local response_lower="${response,,}"
    if [[ "$response_lower" == *"redirecting"* ]] && [[ "$response_lower" == *"/web/database/manager"* ]]; then
      log_success "Database clone command completed successfully."
    elif [[ "$response_lower" == *"error"* ]] || \
         [[ "$response_lower" == *"incorrect master password"* ]] || \
         [[ "$response_lower" == *"no space left"* ]] || \
         [[ "$response_lower" == *"<html"* ]] || \
         [ -z "$response" ]; then
      fail_with_json "Failed to restore database to staging environment. Response: ${response:-Empty response}"
    else
      log_success "Database clone command completed."
    fi

    if [ "$NEUTRALIZE_DB" = "true" ] && [ "$ODOO_VERSION_NUM" -lt 16 ]; then
      sanitize_database "$STG_DB_NAME"
    fi
  fi

  if [ -n "$prev_stg_db" ] && [ "$prev_stg_db" != "$STG_DB_NAME" ]; then
    if grep -q "^DB_NAME=" "$STG_ENV_FILE"; then
      sed -i "s/^DB_NAME=.*/DB_NAME=$STG_DB_NAME/" "$STG_ENV_FILE"
    else
      echo "DB_NAME=$STG_DB_NAME" >> "$STG_ENV_FILE"
    fi
    log_success "Replaced DB_NAME in $STG_ENV_FILE with '$STG_DB_NAME'."
  fi

  log_stage "[3/3] Restarting Odoo Container..."
  cd "$STG_PATH_TO_ODOO"
  if [ "$JSON_MODE" = "true" ]; then
    docker compose up -d >&2 || docker compose restart odoo >&2 || true
  else
    docker compose up -d || docker compose restart odoo || true
  fi

  trigger_registry_reload "$STG_DB_NAME" "$STG_PATH_TO_ODOO" 2>/dev/null || true

  local MODULE_UPDATE_ERROR=false
  local UPDATE_OUTPUT=""
  if [ -n "$MODULES_TO_UPDATE" ]; then
    log_info "Updating Odoo modules: $MODULES_TO_UPDATE..."
    sleep 10
    local TEMP_UPDATE_LOG
    TEMP_UPDATE_LOG=$(mktemp)
    if [ "$JSON_MODE" = "true" ]; then
      docker compose exec -T odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG" >&2
      if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
    else
      docker compose exec -T odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG"
      if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
    fi
    UPDATE_OUTPUT=$(cat "$TEMP_UPDATE_LOG")
    rm -f "$TEMP_UPDATE_LOG"
  fi

  if [ "$JSON_MODE" = "true" ]; then
    echo "{"
    echo "  \"database_name\": \"$STG_DB_NAME\","
    echo "  \"source_database\": \"$PRD_DB_NAME\""
    if [ -n "$MODULES_TO_UPDATE" ]; then
      echo "  , \"modules_to_upgrade\": ["
      IFS=',' read -ra MODULES <<< "$MODULES_TO_UPDATE"
      local FIRST_MODULE=1
      for module in "${MODULES[@]}"; do
        module=$(echo "$module" | xargs)
        [ -z "$module" ] && continue
        if [ $FIRST_MODULE -eq 0 ]; then echo ","; fi
        echo -n "    \"$module\""
        FIRST_MODULE=0
      done
      echo ""
      echo "  ]"
    fi
    if [ "$MODULE_UPDATE_ERROR" = "true" ]; then
      echo "  , \"error\": true"
      local JSON_SAFE_LOG
      if command -v python3 >/dev/null 2>&1; then
        JSON_SAFE_LOG=$(python3 -c 'import json, sys; print(json.dumps(sys.stdin.read()))' <<< "$UPDATE_OUTPUT")
      else
        local ESCAPED
        ESCAPED=$(echo "$UPDATE_OUTPUT" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}' | sed 's/\\n$//')
        JSON_SAFE_LOG="\"$ESCAPED\""
      fi
      echo "  , \"module_upgrade_log\": $JSON_SAFE_LOG"
    fi
    echo "}"
  fi

  log_success "Database clone completed successfully!"
}

function run_interactive_push_mode() {
  local TARGET_DB_NAME="${1:-}"

  OWNER_HOME=$(eval echo "~$REPOSITORY_OWNER")
  ODOO_TMP_DIR="$OWNER_HOME/.odoo-tmp/$SERVICE_NAME"
  mkdir -p "$ODOO_TMP_DIR" 2>/dev/null || true
  chmod 700 "$OWNER_HOME/.odoo-tmp" "$ODOO_TMP_DIR" 2>/dev/null || true
  chown -R "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$OWNER_HOME/.odoo-tmp" 2>/dev/null || true

  TEMP_BACKUP_FILE="$ODOO_TMP_DIR/cloner_backup-$SERVICE_NAME.zip"
  ENV_FILE="$PATH_TO_ODOO/.env"

  # Source environment details
  SOURCE_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
  SOURCE_PORT=$(grep "^PORT=" "$ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

  ODOO_DATABASE_NAME_PRD=$(grep "^DB_NAME=" "$ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
  if [ -z "$ODOO_DATABASE_NAME_PRD" ]; then
    read -rp "Enter the database name: " ODOO_DATABASE_NAME_PRD
  fi

  ## The environment to which the database will be cloned (leave empty to prompt)
  CLONED_ENV=$(grep "^CLONED_ENV=" "$ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

  ## ex. Y (replace with Y if you want to use a date suffix for the new database name)
  # This variable determines whether to use a date suffix for the new database name
  USE_DATE_SUFFIX=$(grep "^USE_DATE_SUFFIX=" "$ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

  # Remote SSH Cloner Detection
  CLONER_SSH_HOST=$(grep "^CLONER_SSH_HOST=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  CLONER_SSH_USER=$(grep "^CLONER_SSH_USER=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  CLONER_SSH_PORT=$(grep "^CLONER_SSH_PORT=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  CLONER_SSH_KEY=$(grep "^CLONER_SSH_KEY=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  CLONER_SSH_DEST_PATH=$(grep "^CLONER_SSH_DEST_PATH=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  [ -z "$CLONER_SSH_PORT" ] && CLONER_SSH_PORT="22"

  if [ -n "$CLONER_SSH_HOST" ]; then
    if [ -z "$CLONER_SSH_USER" ] || [ -z "$CLONER_SSH_DEST_PATH" ]; then
      log_error "CLONER_SSH_USER and CLONER_SSH_DEST_PATH are required when CLONER_SSH_HOST is configured in .env!"
      exit 1
    fi

    local DEST_SERVICE_NAME
    DEST_SERVICE_NAME=$(basename "$CLONER_SSH_DEST_PATH")

    local owner_home
    owner_home=$(eval echo "~$REPOSITORY_OWNER")
    [ -z "$owner_home" ] && owner_home="$HOME"
    local key_expanded="${CLONER_SSH_KEY/#\~/$owner_home}"

    local ssh_opts=(-p "$CLONER_SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5)
    local rsync_ssh="ssh -p $CLONER_SSH_PORT -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5"
    if [ -n "$key_expanded" ] && [ -f "$key_expanded" ]; then
      ssh_opts+=(-i "$key_expanded")
      rsync_ssh+=" -i $key_expanded"
    fi

    log_info "Connecting to Remote VPS ($CLONER_SSH_USER@$CLONER_SSH_HOST:$CLONER_SSH_PORT)..."
    if ! ssh "${ssh_opts[@]}" "$CLONER_SSH_USER@$CLONER_SSH_HOST" "true" 2>/dev/null; then
      log_error "Failed to establish SSH connection with Remote VPS at $CLONER_SSH_USER@$CLONER_SSH_HOST:$CLONER_SSH_PORT."
      exit 1
    fi
    log_success "SSH connection established."

    local dest_db_name_from_env
    dest_db_name_from_env=$(ssh "${ssh_opts[@]}" "$CLONER_SSH_USER@$CLONER_SSH_HOST" "grep '^DB_NAME=' '$CLONER_SSH_DEST_PATH/.env' 2>/dev/null | cut -d '=' -f 2 | tr -d '\"' | tr -d \"'\" | tr -d ' ' || true" 2>/dev/null || true)

    local ODOO_DB_NAME_ENV
    if [ -n "$TARGET_DB_NAME" ]; then
      ODOO_DB_NAME_ENV="$TARGET_DB_NAME"
    elif [ -n "$dest_db_name_from_env" ]; then
      ODOO_DB_NAME_ENV="$dest_db_name_from_env"
      log_info "Using existing DB_NAME from remote destination environment: $ODOO_DB_NAME_ENV"
    else
      ODOO_DB_NAME_ENV=$(promptClonedDBName "$ENV_FILE" "$USE_DATE_SUFFIX" "$DEST_SERVICE_NAME")
    fi

    log_info "🚀 Remote SSH Cloner Mode: Cloning to $CLONER_SSH_USER@$CLONER_SSH_HOST:$CLONER_SSH_DEST_PATH"
    log_info "   Target Database: $ODOO_DB_NAME_ENV"

    log_info "Step 1/3: Creating backup of '$ODOO_DATABASE_NAME_PRD' on local VPS..."
    if command -v "backupdata-$SERVICE_NAME" &>/dev/null; then
      "backupdata-$SERVICE_NAME"
    elif [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME.sh" ]; then
      "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME.sh"
    elif [ -f "$PATH_TO_ODOO/scripts/backupdata.sh" ]; then
      "$PATH_TO_ODOO/scripts/backupdata.sh"
    elif [ -f "$PATH_TO_ODOO/scripts/dataodoo-backupper.sh" ]; then
      "$PATH_TO_ODOO/scripts/dataodoo-backupper.sh"
    else
      log_error "backupdata utility not found in PATH or scripts directory."
      exit 1
    fi

    local local_backup_zip="$OWNER_HOME/backupdata-$SERVICE_NAME.zip"
    if [ ! -s "$local_backup_zip" ] && [ -s "/tmp/backupdata-$SERVICE_NAME.zip" ]; then
      local_backup_zip="/tmp/backupdata-$SERVICE_NAME.zip"
    fi

    if [ ! -s "$local_backup_zip" ]; then
      log_error "Backup failed: $local_backup_zip is missing or empty."
      exit 1
    fi
    log_success "Backup archive ready at $local_backup_zip"

    local remote_home
    remote_home=$(ssh "${ssh_opts[@]}" "$CLONER_SSH_USER@$CLONER_SSH_HOST" 'echo "$HOME"' 2>/dev/null | tr -d '\r\n')
    local remote_target_zip="${remote_home:-/tmp}/backupdata-$DEST_SERVICE_NAME.zip"

    log_info "Step 2/3: Transferring backup archive to Remote VPS as $remote_target_zip..."
    rsync -e "$rsync_ssh" -avz "$local_backup_zip" "$CLONER_SSH_USER@$CLONER_SSH_HOST:$remote_target_zip"
    log_success "Transfer completed."

    log_info "Step 3/3: Restoring database on Remote VPS for service '$DEST_SERVICE_NAME'..."
    ssh "${ssh_opts[@]}" "$CLONER_SSH_USER@$CLONER_SSH_HOST" "
      if command -v restore_backupdata-$DEST_SERVICE_NAME &>/dev/null; then
        sudo restore_backupdata-$DEST_SERVICE_NAME '$remote_target_zip' --name '$ODOO_DB_NAME_ENV'
      elif [ -f '$CLONER_SSH_DEST_PATH/scripts/restore_backupdata-$DEST_SERVICE_NAME.sh' ]; then
        sudo '$CLONER_SSH_DEST_PATH/scripts/restore_backupdata-$DEST_SERVICE_NAME.sh' '$remote_target_zip' --name '$ODOO_DB_NAME_ENV'
      elif [ -f '$CLONER_SSH_DEST_PATH/scripts/restore_backupdata.sh' ]; then
        sudo '$CLONER_SSH_DEST_PATH/scripts/restore_backupdata.sh' '$remote_target_zip' --name '$ODOO_DB_NAME_ENV'
      else
        echo '❌ restore_backupdata script not found on remote VPS at $CLONER_SSH_DEST_PATH' >&2
        exit 1
      fi

      if [ -f '$CLONER_SSH_DEST_PATH/.env' ]; then
        dest_db_name=\$(grep '^DB_NAME=' '$CLONER_SSH_DEST_PATH/.env' 2>/dev/null | cut -d '=' -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        if [ -n \"\$dest_db_name\" ] && [ \"\$dest_db_name\" != '$ODOO_DB_NAME_ENV' ]; then
          echo \"Destination environment has different DB_NAME set ('\$dest_db_name'). Replacing with '$ODOO_DB_NAME_ENV'...\"
          sudo sed -i \"s/^DB_NAME=.*/DB_NAME=$ODOO_DB_NAME_ENV/\" '$CLONER_SSH_DEST_PATH/.env'
          sudo docker compose -f '$CLONER_SSH_DEST_PATH/docker-compose.yml' up -d >/dev/null 2>&1 || true
        elif [ -z \"\$dest_db_name\" ]; then
          sudo sed -i \"s/^DB_NAME=.*/DB_NAME=$ODOO_DB_NAME_ENV/\" '$CLONER_SSH_DEST_PATH/.env'
        fi
      fi
    "

    # Remote and local cleanup
    ssh "${ssh_opts[@]}" "$CLONER_SSH_USER@$CLONER_SSH_HOST" "rm -f '$remote_target_zip'" 2>/dev/null || true
    rm -f "$local_backup_zip" "/tmp/backupdata-$SERVICE_NAME.zip" 2>/dev/null || true

    log_success "Finished cloning database '$ODOO_DB_NAME_ENV' to remote VPS ($CLONER_SSH_HOST) for service '$DEST_SERVICE_NAME'!"
    return 0
  fi

  # Local Sibling Environment Clone Mode (Default)
  ODOO_DEPLOYMENT_ENVIRONMENT=$(promptWhichEnvironment "$CLONED_ENV")

  PATH_TO_ODOO_ENV="$PATH_TO_ODOO/../$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT"

  if [ ! -d "$PATH_TO_ODOO_ENV" ]; then
    log_error "The destination deployment environment '$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT' does not exist at '$PATH_TO_ODOO_ENV'"
    exit 1
  fi

  # Destination environment details
  DEST_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
  DEST_PORT=$(grep "^PORT=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

  if [ -z "$SOURCE_ADMIN_PASSWD" ] || [ -z "$SOURCE_PORT" ] || [ -z "$DEST_ADMIN_PASSWD" ] || [ -z "$DEST_PORT" ]; then
    log_error "ADMIN_PASSWD and/or PORT not set in the .env file of the source or destination environment."
    exit 1
  fi

  local dest_db_name_from_env
  dest_db_name_from_env=$(grep "^DB_NAME=" "$PATH_TO_ODOO_ENV/.env" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g;s/[[:space:]\n]*$//g;s/^["'\'']//;s/["'\'']$//' || true)

  local ODOO_DB_NAME_ENV
  if [ -n "$TARGET_DB_NAME" ]; then
    ODOO_DB_NAME_ENV="$TARGET_DB_NAME"
  elif [ -n "$dest_db_name_from_env" ]; then
    ODOO_DB_NAME_ENV="$dest_db_name_from_env"
    log_info "Using existing DB_NAME from destination environment: $ODOO_DB_NAME_ENV"
  else
    ODOO_DB_NAME_ENV=$(promptClonedDBName "$ENV_FILE" "$USE_DATE_SUFFIX" "$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT")
  fi

  log_info "Start cloning database from '$ODOO_DATABASE_NAME_PRD' to '$ODOO_DB_NAME_ENV'"

  # 1. Backup source database using curl
  # Check Source Health
  log_info "Checking Source ($SERVICE_NAME) Health..."
  checkOdooEndpoint "$SOURCE_PORT"

  log_info "Requesting backup from source Odoo instance..."
  printf '%s' "$SOURCE_ADMIN_PASSWD" | curl -s -X POST \
       -F "master_pwd=<-" \
       -F "name=$ODOO_DATABASE_NAME_PRD" \
       -F "backup_format=zip" \
       -o "$TEMP_BACKUP_FILE" \
       "http://localhost:$SOURCE_PORT/web/database/backup"

  if [ ! -s "$TEMP_BACKUP_FILE" ]; then
      log_error "Backup failed. The output file is empty or was not created. Check source Odoo logs."
      exit 1
  fi
  log_success "Backup of '$ODOO_DATABASE_NAME_PRD' completed successfully to $TEMP_BACKUP_FILE"

  # 2. Restore to destination database using curl
  log_info "Ensuring the destination environment '$ODOO_DEPLOYMENT_ENVIRONMENT' is running before restore..."
  if ! docker compose -f "$PATH_TO_ODOO_ENV/docker-compose.yml" up -d > /dev/null 2>&1; then
    log_warn "Could not start destination environment. It might already be running or there could be an issue."
  fi

  # Check Destination Health
  log_info "Checking Destination ($SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT) Health..."
  checkOdooEndpoint "$DEST_PORT"

  local dest_db_name_from_env
  dest_db_name_from_env=$(grep "^DB_NAME=" "$PATH_TO_ODOO_ENV/.env" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
  if [ -n "$dest_db_name_from_env" ] && [ "$dest_db_name_from_env" != "$ODOO_DB_NAME_ENV" ]; then
    log_info "Dropping previous database '$dest_db_name_from_env'..."
    curl -s -X POST \
      --data-urlencode "master_pwd@"<(printf '%s' "$DEST_ADMIN_PASSWD") \
      -d "name=$dest_db_name_from_env" \
      "http://localhost:$DEST_PORT/web/database/drop" >/dev/null 2>&1 || true
  fi

  log_info "Dropping old database '$ODOO_DB_NAME_ENV' if it exists..."
  drop_response=$(curl -s -X POST \
    --data-urlencode "master_pwd@"<(printf '%s' "$DEST_ADMIN_PASSWD") \
    -d "name=$ODOO_DB_NAME_ENV" \
    "http://localhost:$DEST_PORT/web/database/drop")

  drop_response_lower="${drop_response,,}"

  if [[ "$drop_response_lower" == *"redirecting"* ]] && [[ "$drop_response_lower" == *"/web/database/manager"* ]]; then
      log_info "Drop database command sent for '$ODOO_DB_NAME_ENV'. (Redirect received)"
  elif [[ "$drop_response_lower" == *"error"* ]] && [[ "$drop_response_lower" != *"does not exist"* ]] || \
     [[ "$drop_response_lower" == *"no space left"* ]] || \
     [[ "$drop_response_lower" == *"<html"* ]]; then
      log_warn "Could not drop database '$ODOO_DB_NAME_ENV'. It might not exist or another error occurred. Response: $drop_response"
  else
      log_info "Drop database command sent for '$ODOO_DB_NAME_ENV'."
  fi

  # restore the database
  NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
  if [ -z "$NEUTRALIZE_DB" ]; then
      NEUTRALIZE_DB="true"
  fi

  log_info "Requesting restore to destination Odoo instance..."
  log_info "Neutralize database option: $NEUTRALIZE_DB"

  if [ "$NEUTRALIZE_DB" = "true" ]; then
    response=$(printf '%s' "$DEST_ADMIN_PASSWD" | curl -s -X POST \
      -F "master_pwd=<-" \
      -F "name=$ODOO_DB_NAME_ENV" \
      -F "backup_file=@$TEMP_BACKUP_FILE" \
      -F "copy=true" \
      -F "neutralize_database=true" \
      "http://localhost:$DEST_PORT/web/database/restore")
  else
    response=$(printf '%s' "$DEST_ADMIN_PASSWD" | curl -s -X POST \
      -F "master_pwd=<-" \
      -F "name=$ODOO_DB_NAME_ENV" \
      -F "backup_file=@$TEMP_BACKUP_FILE" \
      -F "copy=true" \
      "http://localhost:$DEST_PORT/web/database/restore")
  fi

  response_lower="${response,,}"

  if [[ "$response_lower" == *"redirecting"* ]] && [[ "$response_lower" == *"/web/database/manager"* ]]; then
    log_success "Database restore command sent successfully to destination. (Redirect received)"
  elif [[ "$response_lower" == *"error"* ]] || \
     [[ "$response_lower" == *"incorrect master password"* ]] || \
     [[ "$response_lower" == *"no space left"* ]] || \
     [[ "$response_lower" == *"<html"* ]] || \
     [ -z "$response" ]; then
    log_error "Failed to restore database to destination. Response: ${response:-'Empty response (Likely timeout or bad gateway)'}"
    exit 1
  else
    log_success "Database restore command sent successfully to destination."
  fi

  # Update DB_NAME in destination environment only if an explicit different target name was supplied
  if [ -n "$dest_db_name_from_env" ] && [ "$dest_db_name_from_env" != "$ODOO_DB_NAME_ENV" ]; then
    log_info "Destination environment has different DB_NAME set ('$dest_db_name_from_env'). Replacing with '$ODOO_DB_NAME_ENV'..."
    sed -i "s/^DB_NAME=.*/DB_NAME=$ODOO_DB_NAME_ENV/" "$PATH_TO_ODOO_ENV/.env"
    log_success "Replaced DB_NAME in $PATH_TO_ODOO_ENV/.env with '$ODOO_DB_NAME_ENV'."
  fi

  log_info "Restarting the destination environment '$ODOO_DEPLOYMENT_ENVIRONMENT'..."
  docker compose -f "$PATH_TO_ODOO_ENV/docker-compose.yml" up -d > /dev/null 2>&1 || { log_error "Error restarting $ODOO_DEPLOYMENT_ENVIRONMENT"; exit 1; }

  log_success "Finish cloning database '$ODOO_DB_NAME_ENV' from '$ODOO_DATABASE_NAME_PRD'"
}

main() {
  display_usage() {
    echo -e "${COLOR_INFO}Usage:${COLOR_RESET} sudo $0 [TARGET_DB_NAME] [MODULES] [json]"
    echo -e "       $0 -h | --help"
    echo ""
    echo -e "${COLOR_CYAN}Modes:${COLOR_RESET}"
    echo -e "  ${COLOR_SUCCESS}Automated Pull Mode${COLOR_RESET}   : Pass arguments or 'json' to pull & clone production database to this instance."
    echo -e "  ${COLOR_SUCCESS}Interactive Push Mode${COLOR_RESET} : Run without pull arguments to choose a target environment to clone data to."
    echo ""
  }

  JSON_MODE="false"
  for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
      display_usage
      exit 0
    elif [[ "$arg" == "json" ]]; then
      JSON_MODE="true"
    fi
  done

  if [ "$(id -u)" -ne 0 ]; then
    log_info "Elevating permissions to root..."
    # shellcheck disable=SC2093
    exec sudo "$0" "$@"
    log_error "Failed to elevate to root. Please run with sudo."
    exit 1
  fi

  ARGS=()
  for arg in "$@"; do
    if [[ "$arg" != "json" ]]; then
      ARGS+=("$arg")
    fi
  done
  set -- "${ARGS[@]}"

  local PRD_SSH_HOST=""
  if [ -f "$PATH_TO_ODOO/.env" ]; then
    PRD_SSH_HOST=$(grep "^PRD_SSH_HOST=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  fi

  if [ "$JSON_MODE" = "true" ] || ([ "$#" -gt 0 ] && ([ "$SERVICE_NAME" != "${SERVICE_NAME%-*}" ] || [ -n "$PRD_SSH_HOST" ])); then
    run_automated_pull_mode "$@"
  else
    run_interactive_push_mode "$@"
  fi
}

main "$@"
