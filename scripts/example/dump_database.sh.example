#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Dumps Odoo PostgreSQL database to stdout or file with optional zstd compression.
# Usage: ./scripts/dump_database.sh [DB_NAME] [--raw] [--output PATH]
# Dependencies: docker, pg_dump, zstd, sudo

CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
ENV_FILE="$PATH_TO_ODOO/.env"

# Parse arguments
TARGET_DB=""
RAW_STREAM=false
OUTPUT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)
      RAW_STREAM=true
      shift
      ;;
    -o|--output)
      OUTPUT_FILE="$2"
      shift 2
      ;;
    *)
      if [ -z "$TARGET_DB" ]; then
        TARGET_DB="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$TARGET_DB" ]; then
  TARGET_DB=$(grep "^DB_NAME=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
fi

if [ -z "$TARGET_DB" ]; then
  echo "❌ Error: DB_NAME not specified and not found in $ENV_FILE" >&2
  exit 1
fi

run_pg_dump() {
  local db_host
  db_host=$(grep "^DB_HOST=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)

  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port db_user db_pass docker_net net
    db_port=$(grep "^DB_PORT=" "$ENV_FILE" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    db_user=$(grep "^ACTIVE_DB_USER=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    [ -z "$db_user" ] && db_user=$(cat "$PATH_TO_ODOO/.secrets/db_user" 2>/dev/null || true)
    db_pass=$(cat "$PATH_TO_ODOO/.secrets/db_password" 2>/dev/null || true)
    docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$ENV_FILE" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    net=$(echo "$docker_net" | cut -d "," -f 1)
    docker run -i --rm --network="$net" -e PGPASSWORD="$db_pass" postgres pg_dump -h "$db_host" -p "$db_port" -U "$db_user" "$@"
  else
    sudo -u postgres pg_dump "$@"
  fi
}

dump_stream() {
  if [ "$RAW_STREAM" = true ]; then
    run_pg_dump --no-owner "$TARGET_DB"
  else
    if command -v zstd >/dev/null 2>&1; then
      run_pg_dump --no-owner "$TARGET_DB" | zstd -1 -T0
    else
      run_pg_dump --no-owner "$TARGET_DB"
    fi
  fi
}

if [ -n "$OUTPUT_FILE" ]; then
  dump_stream > "$OUTPUT_FILE"
else
  dump_stream
fi
