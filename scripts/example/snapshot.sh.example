#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Creates a full Odoo snapshot (database dump + filestore + configs) locally or via secondary VPS over SSH.
# Usage: ./scripts/snapshot-SERVICE_NAME [auto]
# Dependencies: sudo, git, zstd, tar, docker, pg_dump, gcloud, rsync, ssh, curl, dd, flock, zip

CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_ODOO")
OWNER_HOME=$(eval echo "~$REPOSITORY_OWNER")
TAR_PROJECT_ROOT="${PATH_TO_ODOO#/}"

# --- Logging Functions & Colors ---
# Define colors for log messages
readonly COLOR_RESET="\033[0m"
readonly COLOR_INFO="\033[0;34m"
readonly COLOR_SUCCESS="\033[0;32m"
readonly COLOR_WARN="\033[0;33m"
readonly COLOR_ERROR="\033[0;31m"

# Function to log messages with a specific color and emoji
log() {
  local color="$1"
  local emoji="$2"
  local message="$3"
  echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() { log "${COLOR_ERROR}" "❌" "$1"; }
# ------------------------------------

function run_pg_dump() {
  local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
  local db_host
  db_host=$(grep "^DB_HOST=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port db_user db_pass docker_net net
    db_port=$(grep "^DB_PORT=" "$env_file" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^[""'\\']//;s/[""'\\']$//')
    db_user=$(grep "^ACTIVE_DB_USER=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    [ -z "$db_user" ] && db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
    db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
    docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^[""'\\']//;s/[""'\\']$//')
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    local net
    net=$(echo "$docker_net" | cut -d "," -f 1)
    docker run -i --rm --network="$net" -e PGPASSWORD="$db_pass" postgres pg_dump -h "$db_host" -p "$db_port" -U "$db_user" "$@"
  else
    sudo -u postgres pg_dump "$@"
  fi
}

function areYouReallySure() {
  tar_file_path=$1
  ASK_TO_REPLACE_EXISTING_SNAPSHOT=$2
  if [ -f "$tar_file_path" ]; then
    if [ "$ASK_TO_REPLACE_EXISTING_SNAPSHOT" == "Y" ]; then
      echo "current snapshot file already exists, do you want to overwrite it? ($tar_file_path)"
      echo -e "type 'yes I am sure' to continue.\n"

      read -rp ": " CONFIRMATION

      case $CONFIRMATION in
        "yes I am sure")
          log_info "Overwriting the current snapshot file."
          rm -f "$tar_file_path"
          ;;
        *)
          log_error "You're not sure, okay. Now exiting the script."
          exit 1
          ;;
      esac
    else
      log_info "Removing the existing snapshot file."
      rm -f "$tar_file_path"
    fi
  fi
}

function getGitHash() {
  local git_path=$1
  local output_file=$2
  local git_real_owner
  git_real_owner=$(stat -c '%U' "$git_path")

  {
      echo "  Updated at [$(date +"%Y-%m-%d %H:%M:%S")]"
      echo "  Git Directory: $git_path"
      echo "  Git Remote: $(sudo -u "$git_real_owner" git -C "$git_path" remote get-url origin)"
      echo "  Git Branch: $(sudo -u "$git_real_owner" git -C "$git_path" branch --show-current)"
      echo "  Git Hashes: $(sudo -u "$git_real_owner" git -C "$git_path" rev-parse HEAD)"
      echo ""
  } >> "$output_file"
}

function getSubDirectories() {
  dir=$1
  subdirs="$(ls -d "$dir"/*/)"
  echo "$subdirs"
}

function isDirectoryGitRepository() {
  # _inherit = writeGitHash

  dir=$1

  if [ -d "$dir/.git" ]; then
    if git rev-parse --is-inside-work-tree &>/dev/null; then
      return 0
    else
      return 1
    fi
  else
    return 1
  fi
}

function moveSnapshotFileToTempDir() {
  local tar_file_path=$1
  local tar_file_name=$2

  local temp_dir
  temp_dir="$tar_file_path-$(date +"%Y%m%d-%H%M%S")"
  if ! OUTPUT_mkdir=$(mkdir "$temp_dir" 2>&1); then
    log_error "Can't create the temporary directory: $OUTPUT_mkdir"
    exit 1
  else
    log_success "Create the temporary directory"
  fi

  log_info "Moving the snapshot file to the temporary directory."
  mv "$tar_file_path" "$temp_dir/"

  log_info "change the permission and owner of the temporary directory"
  chmod 755 "$temp_dir"
  chmod 644 "$temp_dir/$tar_file_name"
  chown -R "$REPOSITORY_OWNER": "$temp_dir"

  log_success "The snapshot File Created Successfully named $tar_file_name. File Backed up at $temp_dir/$tar_file_name"
}

function get_gdrive_access_token_from_sa() {
  local sa_input="$1"
  local sa_json_content=""

  if [ -f "$sa_input" ]; then
    sa_json_content=$(cat "$sa_input")
  elif [[ "$sa_input" =~ ^\{.*\}$ ]]; then
    sa_json_content="$sa_input"
  else
    log_error "Service Account JSON key file or content '$sa_input' not found."
    return 1
  fi

  local client_email token_uri key_pem
  client_email=$(echo "$sa_json_content" | grep -o '"client_email": *"[^"]*"' | cut -d'"' -f4)
  token_uri=$(echo "$sa_json_content" | grep -o '"token_uri": *"[^"]*"' | cut -d'"' -f4)
  [ -z "$token_uri" ] && token_uri="https://oauth2.googleapis.com/token"

  key_pem=$(echo "$sa_json_content" | grep -o '"private_key": *"[^"]*"' | sed 's/^"private_key": *"//;s/"$//')

  if [ -z "$client_email" ] || [ -z "$key_pem" ]; then
    log_error "Could not parse client_email or private_key from Service Account JSON."
    return 1
  fi

  local b64url_cmd='openssl base64 -e -A | tr "+/" "-_" | tr -d "="'
  local now exp header_b64 claims claims_b64 unsigned_jwt sig_b64 jwt
  now=$(date +%s)
  exp=$((now + 3600))

  header_b64=$(echo -n '{"alg":"RS256","typ":"JWT"}' | eval "$b64url_cmd")
  claims="{\"iss\":\"$client_email\",\"scope\":\"https://www.googleapis.com/auth/drive\",\"aud\":\"$token_uri\",\"exp\":$exp,\"iat\":$now}"
  claims_b64=$(echo -n "$claims" | eval "$b64url_cmd")

  unsigned_jwt="${header_b64}.${claims_b64}"
  sig_b64=$(printf "%s" "$unsigned_jwt" | openssl dgst -sha256 -sign <(printf '%b' "$key_pem") -binary 2>/dev/null | eval "$b64url_cmd")

  if [ -z "$sig_b64" ]; then
    log_error "Failed to sign Service Account JWT with openssl."
    return 1
  fi

  jwt="${unsigned_jwt}.${sig_b64}"

  local token_response
  token_response=$(curl -s -X POST \
    -d "grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer" \
    --data-urlencode "assertion=$jwt" \
    "$token_uri")

  echo "$token_response" | grep -o '"access_token": *"[^"]*"' | cut -d'"' -f4
}

function cleanup_gdrive_old_snapshots() {
  local access_token="$1"
  local folder_id="$2"
  local service_name="$3"
  local max_backups="$4"

  if [ -z "$max_backups" ] || ! [[ "$max_backups" =~ ^[0-9]+$ ]] || [ "$max_backups" -le 0 ]; then
    return 0
  fi

  log_info "Running Google Drive lifecycle retention (keeping latest $max_backups snapshot(s) for $service_name)..."

  local query="name contains 'snapshot-${service_name}' and trashed = false"
  if [ -n "$folder_id" ]; then
    query="$query and '$folder_id' in parents"
  fi

  local response
  response=$(curl -s -G \
    -H "Authorization: Bearer $access_token" \
    --data-urlencode "q=$query" \
    --data-urlencode "orderBy=createdTime desc" \
    --data-urlencode "fields=files(id, name, createdTime)" \
    --data-urlencode "supportsAllDrives=true" \
    --data-urlencode "includeItemsFromAllDrives=true" \
    --data-urlencode "pageSize=100" \
    "https://www.googleapis.com/drive/v3/files")

  local file_ids
  file_ids=$(echo "$response" | grep -o '"id": *"[^"]*"' | cut -d'"' -f4)

  local to_delete
  to_delete=$(echo "$file_ids" | tail -n +$((max_backups + 1)))

  for file_id in $to_delete; do
    if [ -n "$file_id" ]; then
      curl -s -X DELETE \
        -H "Authorization: Bearer $access_token" \
        "https://www.googleapis.com/drive/v3/files/${file_id}?supportsAllDrives=true" >/dev/null 2>&1 || true
    fi
  done
}

function upload_to_gdrive() {
  local file_path="$1"
  local raw_access_token="$2"
  local sa_key_path="$3"
  local folder_id="$4"
  local chunk_size_cfg="$5"
  local max_backups_cfg="$6"

  if [ ! -f "$file_path" ]; then
    log_error "Snapshot file '$file_path' not found for Google Drive upload."
    return 1
  fi

  local access_token=""
  if [ -n "$raw_access_token" ]; then
    if [ -f "$raw_access_token" ]; then
      if [[ "$raw_access_token" == *.json ]] || grep -q '"type": *"service_account"' "$raw_access_token" 2>/dev/null; then
        log_info "Exchanging Google Drive Service Account key file '$raw_access_token' for access token..."
        access_token=$(get_gdrive_access_token_from_sa "$raw_access_token")
      else
        access_token=$(tr -d '\r\n' < "$raw_access_token")
      fi
    else
      access_token="$raw_access_token"
    fi
  elif [ -n "$sa_key_path" ]; then
    log_info "Exchanging Google Drive Service Account key file '$sa_key_path' for access token..."
    access_token=$(get_gdrive_access_token_from_sa "$sa_key_path")
  fi

  if [ -z "$access_token" ]; then
    log_error "Google Drive access token could not be obtained (check your access token or Service Account key file)."
    return 1
  fi

  # Default chunk size: 5 MiB (5 * 1024 * 1024 = 5242880 bytes)
  # Chunk size MUST be a positive multiple of 256 KiB (262144 bytes)
  local chunk_size=5242880
  if [ -n "$chunk_size_cfg" ]; then
    if [[ "$chunk_size_cfg" =~ ^[0-9]+$ ]] && [ "$chunk_size_cfg" -gt 0 ] && [ "$((chunk_size_cfg % 262144))" -eq 0 ]; then
      chunk_size="$chunk_size_cfg"
    else
      log_warn "Invalid GDRIVE_CHUNK_SIZE '$chunk_size_cfg'. It must be a positive multiple of 262144 bytes. Using default 5242880 (5 MiB)."
    fi
  fi

  local upload_timestamp
  upload_timestamp=$(date +"%Y%m%d-%H%M%S")
  local file_name="snapshot-${SERVICE_NAME}-${upload_timestamp}.tar.zst"
  local file_size mime_type
  file_size=$(wc -c < "$file_path" | tr -d ' ')
  mime_type="application/octet-stream"

  log_info "Initiating Google Drive resumable upload session for $file_name ($file_size bytes, chunk size: $chunk_size bytes)..."

  # Build JSON metadata
  local metadata="{\"name\": \"$file_name\""
  if [ -n "$folder_id" ]; then
    metadata="$metadata, \"parents\": [\"$folder_id\"]"
  fi
  metadata="$metadata}"

  local init_response
  init_response=$(curl -s -i -X POST \
    -H "Authorization: Bearer $access_token" \
    -H "X-Upload-Content-Type: $mime_type" \
    -H "X-Upload-Content-Length: $file_size" \
    -H "Content-Type: application/json; charset=UTF-8" \
    -d "$metadata" \
    "https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&supportsAllDrives=true")

  local session_uri
  session_uri=$(echo "$init_response" | grep -i "^location:" | tr -d '\r' | awk '{print $2}')

  if [ -z "$session_uri" ]; then
    log_error "Failed to initiate Google Drive upload session."
    log_error "Google Drive API Response: $init_response"
    return 1
  fi

  log_info "Google Drive upload session created successfully."

  local start_byte=0
  local chunk_index=0
  local max_retries=3
  local retry_count=0

  while [ "$start_byte" -lt "$file_size" ]; do
    local end_byte=$((start_byte + chunk_size - 1))
    if [ "$end_byte" -ge "$file_size" ]; then
      end_byte=$((file_size - 1))
    fi

    local current_chunk_len=$((end_byte - start_byte + 1))

    log_info "Uploading bytes ${start_byte}-${end_byte}/${file_size} to Google Drive..."

    local http_response http_status response_body
    http_response=$( (dd if="$file_path" bs="$chunk_size" skip="$chunk_index" count=1 status=none | \
      curl -s -w "\n%{http_code}" -X PUT \
        -H "Content-Length: $current_chunk_len" \
        -H "Content-Range: bytes ${start_byte}-${end_byte}/${file_size}" \
        --data-binary @- \
        "$session_uri") 2>/dev/null || true )

    http_status=$(echo "$http_response" | tail -n1)
    response_body=$(echo "$http_response" | sed '$d')

    if [ "$http_status" = "308" ]; then
      # 308 Resume Incomplete: Chunk uploaded successfully
      start_byte=$((end_byte + 1))
      chunk_index=$((chunk_index + 1))
      retry_count=0
    elif [ "$http_status" = "200" ] || [ "$http_status" = "201" ]; then
      # 200/201: File upload completed
      log_success "Google Drive chunked upload completed successfully for $file_name."
      if [ -n "$max_backups_cfg" ]; then
        cleanup_gdrive_old_snapshots "$access_token" "$folder_id" "$SERVICE_NAME" "$max_backups_cfg"
      fi
      return 0
    else
      log_warn "Chunk upload failed with HTTP status: $http_status. Response: $response_body"
      retry_count=$((retry_count + 1))
      if [ "$retry_count" -gt "$max_retries" ]; then
        log_error "Max retries ($max_retries) reached for Google Drive chunk upload."
        return 1
      fi

      log_info "Querying Google Drive upload session status (retry $retry_count/$max_retries)..."
      sleep 2
      local status_response query_status last_byte
      status_response=$(curl -s -i -X PUT \
        -H "Content-Length: 0" \
        -H "Content-Range: bytes */$file_size" \
        "$session_uri")

      query_status=$(echo "$status_response" | grep "^HTTP" | awk '{print $2}')
      if [ "$query_status" = "308" ]; then
        last_byte=$(echo "$status_response" | grep -i "^range:" | tr -d '\r' | awk -F'-' '{print $2}')
        if [ -n "$last_byte" ]; then
          start_byte=$((last_byte + 1))
          chunk_index=$((start_byte / chunk_size))
          log_info "Resuming Google Drive upload from byte $start_byte (Chunk #$chunk_index)..."
        fi
      elif [ "$query_status" = "200" ] || [ "$query_status" = "201" ]; then
        log_success "Google Drive upload was completed during session query."
        return 0
      fi
    fi
  done

  return 0
}


function writeGitHash() {
  local search_dir=$1
  local output_file=$2
  local subdirs

  subdirs="$(getSubDirectories "$search_dir")"

  for dir in $subdirs; do
    if isDirectoryGitRepository "$dir"; then
      getGitHash "$dir" "$output_file"
    else
      log_warn "$dir is not a git repository. You need to backup this directory by adding it to your snapshot utilities."
    fi
  done
}

function extract_odoo_version_info() {
  local active_base_path
  active_base_path=$(grep "^ACTIVE_ODOO_BASE_PATH=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  local odoo_base_dir_path=""
  if [ -n "$active_base_path" ] && [ -d "$PATH_TO_ODOO/$active_base_path" ]; then
    odoo_base_dir_path="$PATH_TO_ODOO/$active_base_path"
  else
    odoo_base_dir_path=$(find "$PATH_TO_ODOO/odoo-base" -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null || true)
  fi

  local release_py_file=""
  if [ -n "$odoo_base_dir_path" ] && [ -f "$odoo_base_dir_path/odoo/release.py" ]; then
    release_py_file="$odoo_base_dir_path/odoo/release.py"
  else
    release_py_file=$(find "$PATH_TO_ODOO/odoo-base" "$PATH_TO_ODOO/odoo" -name "release.py" -path "*/odoo/release.py" 2>/dev/null | head -n 1 || true)
  fi

  MANIFEST_VERSION="16.0"
  MANIFEST_MAJOR_VERSION="16"
  MANIFEST_VERSION_INFO='[16, 0, 0, "final", 0, ""]'

  if [ -n "$release_py_file" ] && [ -f "$release_py_file" ] && command -v python3 >/dev/null 2>&1; then
    local version_json
    version_json=$(python3 -c '
import sys, json, ast
try:
    with open(sys.argv[1], "r") as f:
        tree = ast.parse(f.read())
    version = "16.0"
    version_info = [16, 0, 0, "final", 0, ""]
    major_version = "16"
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name):
                    if target.id == "version" and isinstance(node.value, ast.Constant):
                        version = str(node.value.value)
                    elif target.id in ("major_version", "series", "serie") and isinstance(node.value, ast.Constant):
                        major_version = str(node.value.value)
                    elif target.id == "version_info" and isinstance(node.value, ast.Tuple):
                        version_info = [
                            elt.value if isinstance(elt, ast.Constant)
                            else (elt.id.lower() if isinstance(elt, ast.Name) else str(elt))
                            for elt in node.value.elts
                        ]
    print(json.dumps({"version": version, "version_info": version_info, "major_version": major_version}))
except Exception:
    print(json.dumps({"version": "16.0", "version_info": [16, 0, 0, "final", 0, ""], "major_version": "16"}))
' "$release_py_file" 2>/dev/null || true)

    if [ -n "$version_json" ]; then
      local extracted_v extracted_mv extracted_vi
      extracted_v=$(echo "$version_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null || true)
      extracted_mv=$(echo "$version_json" | python3 -c 'import sys, json; print(json.load(sys.stdin).get("major_version", ""))' 2>/dev/null || true)
      extracted_vi=$(echo "$version_json" | python3 -c 'import sys, json; print(json.dumps(json.load(sys.stdin).get("version_info", [])))' 2>/dev/null || true)
      [ -n "$extracted_v" ] && MANIFEST_VERSION="$extracted_v"
      [ -n "$extracted_mv" ] && MANIFEST_MAJOR_VERSION="$extracted_mv"
      [ -n "$extracted_vi" ] && [ "$extracted_vi" != "[]" ] && MANIFEST_VERSION_INFO="$extracted_vi"
    fi
  fi
}

function run_remote_snapshot() {
  local host="$1"
  local user="$2"
  local port="${3:-22}"
  local key="$4"
  local compression_level="$5"

  if [ -z "$key" ]; then
    if [ -f "$OWNER_HOME/.ssh/id_ed25519-snapshot-$SERVICE_NAME" ]; then
      key="$OWNER_HOME/.ssh/id_ed25519-snapshot-$SERVICE_NAME"
    elif [ -f "$OWNER_HOME/.ssh/id_ed25519_snapshot" ]; then
      key="$OWNER_HOME/.ssh/id_ed25519_snapshot"
    else
      key="$OWNER_HOME/.ssh/id_ed25519-snapshot-$SERVICE_NAME"
    fi
  fi
  key="${key/#\~/$OWNER_HOME}"
  local ssh_opts=(-p "$port" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5)
  local rsync_ssh="ssh -p $port -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5"
  if [ -n "$key" ] && [ -f "$key" ]; then
    ssh_opts+=(-i "$key")
    rsync_ssh+=" -i $key"
  fi

  remote_exec() {
    ssh "${ssh_opts[@]}" "$user@$host" "$@"
  }

  remote_sync() {
    rsync -e "$rsync_ssh" "$@"
  }

  log_info "Connecting to Secondary VPS ($user@$host:$port)..."
  if ! remote_exec "true" 2>/dev/null; then
    log_error "Failed to establish SSH connection with Secondary VPS at $user@$host:$port."
    exit 1
  fi
  log_success "SSH connection established with Secondary VPS."

  # Check required tools on Secondary VPS
  if ! remote_exec "command -v zstd >/dev/null 2>&1 && command -v zip >/dev/null 2>&1 && command -v tar >/dev/null 2>&1"; then
    log_error "Secondary VPS is missing required tools (zstd, zip, or tar). Please install them on Secondary VPS."
    exit 1
  fi

  # Check GCS access on Secondary VPS if GCS_BUCKET_NAME is configured
  if [ -n "$GCS_BUCKET_NAME" ]; then
    log_info "Verifying Google Cloud Storage access on Secondary VPS..."
    if ! remote_exec "command -v gcloud >/dev/null 2>&1"; then
      log_error "gcloud CLI is not installed on Secondary VPS ($host), but GCS_BUCKET_NAME is set in .env."
      exit 1
    fi

    # Disable parallel composite upload check on secondary if needed
    remote_exec "gcloud config set storage/parallel_composite_upload_compatibility_check false 2>/dev/null || true"

    if ! remote_exec "gcloud storage ls 'gs://$GCS_BUCKET_NAME' >/dev/null 2>&1"; then
      log_error "Secondary VPS ($host) cannot access Google Cloud Storage bucket: gs://$GCS_BUCKET_NAME"
      log_error "Please ensure gcloud is authenticated and has storage permissions on the Secondary VPS."
      exit 1
    fi
    log_success "Secondary VPS has verified access to gs://$GCS_BUCKET_NAME."
  fi

  # Check Google Drive access prerequisites on Secondary VPS if configured
  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    log_info "Verifying Google Drive upload tools on Secondary VPS..."
    if ! remote_exec "command -v curl >/dev/null 2>&1 && command -v dd >/dev/null 2>&1"; then
      log_error "Secondary VPS ($host) is missing curl or dd, which are required for Google Drive upload."
      exit 1
    fi
    if [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      if ! remote_exec "command -v openssl >/dev/null 2>&1"; then
        log_error "Secondary VPS ($host) is missing openssl, which is required for Service Account token generation."
        exit 1
      fi
    fi
    log_success "Secondary VPS has verified prerequisites for Google Drive upload."
  fi

  local remote_home
  remote_home=$(remote_exec 'echo "$HOME"' 2>/dev/null | tr -d '\r\n')
  if [ -z "$remote_home" ]; then
    log_error "Could not determine HOME directory on Secondary VPS."
    exit 1
  fi

  local remote_base="$remote_home/.odoo-snapshots/$SERVICE_NAME"
  local remote_mirror="$remote_base/mirror/filestore"
  local remote_cache="$remote_base/cache"
  local remote_staging="$remote_base/staging"
  local remote_archives="$remote_base/archives"

  log_info "Preparing directory structure on Secondary VPS under $remote_base/..."
  remote_exec "mkdir -p '$remote_mirror' '$remote_cache' '$remote_staging/tmp' '$remote_archives' && chmod 700 '$remote_home/.odoo-snapshots'"

  local odoo_filestore_path="/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD"
  if [ -d "$odoo_filestore_path" ]; then
    log_info "Syncing filestore to Secondary VPS (incremental pass 1)..."
    remote_sync -az --delete "$odoo_filestore_path/" "$user@$host:$remote_mirror/"
  else
    log_warn "Filestore path not found: $odoo_filestore_path"
  fi

  log_info "Streaming database dump directly to Secondary VPS..."
  if ! run_pg_dump --no-owner "$ODOO_DATABASE_NAME_PRD" | remote_exec "cat > $remote_staging/tmp/dump.sql"; then
    log_error "pg_dump stream to Secondary VPS failed."
    exit 1
  fi

  if [ -d "$odoo_filestore_path" ]; then
    log_info "Syncing filestore catch-up changes to Secondary VPS..."
    remote_sync -az "$odoo_filestore_path/" "$user@$host:$remote_mirror/"
  fi

  local git_hashes_file
  git_hashes_file=$(mktemp --tmpdir "git_hashes_XXXXXX.txt")
  chmod 644 "$git_hashes_file"
  writeGitHash "$PATH_TO_ODOO/git" "$git_hashes_file"
  writeGitHash "$PATH_TO_ODOO/odoo-base" "$git_hashes_file"
  remote_sync -az "$git_hashes_file" "$user@$host:$remote_staging/tmp/git_hashes.txt"
  rm -f "$git_hashes_file"

  log_info "Syncing configuration files to Secondary VPS staging..."
  local files_to_sync=()
  [ -d "$PATH_TO_ODOO/.secrets" ] && files_to_sync+=("$PATH_TO_ODOO/.secrets")
  [ -f "$PATH_TO_ODOO/conf/odoo.conf" ] && files_to_sync+=("$PATH_TO_ODOO/conf/odoo.conf")
  [ -f "$PATH_TO_ODOO/.env" ] && files_to_sync+=("$PATH_TO_ODOO/.env")
  [ -f "$PATH_TO_ODOO/requirements.txt" ] && files_to_sync+=("$PATH_TO_ODOO/requirements.txt")
  [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME")

  if [ -n "$SNAPSHOT_CUSTOM_DIRS" ]; then
    IFS=';' read -ra ADDR <<< "$SNAPSHOT_CUSTOM_DIRS"
    for dir in "${ADDR[@]}"; do
      dir=$(echo "$dir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      if [ -n "$dir" ] && [ -e "$dir" ]; then
        files_to_sync+=("$dir")
      fi
    done
  fi

  remote_sync -azR "${files_to_sync[@]}" "$user@$host:$remote_staging/"

  log_info "Preparing manifest.json on Secondary VPS..."
  remote_exec "mkdir -p '$remote_staging/tmp/zip_staging' && cat <<'MANIFEST_EOF' > '$remote_staging/tmp/zip_staging/manifest.json'
{
    \"odoo_dump\": \"1\",
    \"db_name\": \"$ODOO_DATABASE_NAME_PRD\",
    \"version\": \"$MANIFEST_VERSION\",
    \"version_info\": $MANIFEST_VERSION_INFO,
    \"major_version\": \"$MANIFEST_MAJOR_VERSION\",
    \"modules\": {}
}
MANIFEST_EOF"

  log_info "Moving database dump to zip staging on Secondary VPS..."
  remote_exec "if [ -f '$remote_staging/tmp/dump.sql' ]; then mv '$remote_staging/tmp/dump.sql' '$remote_staging/tmp/zip_staging/dump.sql'; fi"

  local remote_cache_zip="$remote_cache/backupdata-$SERVICE_NAME.zip"
  log_info "Updating cached backupdata-$SERVICE_NAME.zip incrementally on Secondary VPS..."
  if remote_exec "[ -f '$remote_cache_zip' ]"; then
    remote_exec "cd '$remote_staging/tmp/zip_staging' && zip -u -q '$remote_cache_zip' dump.sql manifest.json"
    if remote_exec "[ -d '$remote_mirror' ] && [ -n \"\$(ls -A '$remote_mirror' 2>/dev/null)\" ]"; then
      remote_exec "ln -sfn '$remote_mirror' '$remote_staging/tmp/zip_staging/filestore' && cd '$remote_staging/tmp/zip_staging' && zip -u -FS -0 -r -q '$remote_cache_zip' filestore"
    fi
  else
    if remote_exec "[ -d '$remote_mirror' ] && [ -n \"\$(ls -A '$remote_mirror' 2>/dev/null)\" ]"; then
      remote_exec "ln -sfn '$remote_mirror' '$remote_staging/tmp/zip_staging/filestore' && cd '$remote_staging/tmp/zip_staging' && zip -0 -r -q '$remote_cache_zip' dump.sql manifest.json filestore"
    else
      remote_exec "cd '$remote_staging/tmp/zip_staging' && zip -0 -r -q '$remote_cache_zip' dump.sql manifest.json"
    fi
  fi
  remote_exec "rm -rf '$remote_staging/tmp/zip_staging'"

  log_info "Copying cached backup bundle to staging on Secondary VPS..."
  remote_exec "cp -f '$remote_cache_zip' '$remote_staging/tmp/backupdata-$SERVICE_NAME.zip'"

  log_info "Packaging snapshot-$SERVICE_NAME.tar.zst on Secondary VPS (compression level: $compression_level)..."
  remote_exec "cd '$remote_staging' && tar -cf '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' -I 'zstd -vT0 -$compression_level --ultra' *"

  local remote_upload_attempted=false
  local remote_upload_success=false

  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    remote_upload_attempted=true
    log_info "Uploading snapshot archive from Secondary VPS to Google Drive..."

    local remote_sa_content=""
    if [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ] && [ -f "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      remote_sa_content=$(cat "$GDRIVE_SERVICE_ACCOUNT_KEY")
    elif [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      remote_sa_content="$GDRIVE_SERVICE_ACCOUNT_KEY"
    fi

    local upload_funcs
    upload_funcs=$(declare -f log log_info log_success log_warn log_error get_gdrive_access_token_from_sa cleanup_gdrive_old_snapshots upload_to_gdrive)

    if remote_exec "bash -s" << REMOTE_EOF
$upload_funcs
upload_to_gdrive '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$GDRIVE_ACCESS_TOKEN' '$remote_sa_content' '$GDRIVE_FOLDER_ID' '$GDRIVE_CHUNK_SIZE' '$GDRIVE_MAX_BACKUPS'
REMOTE_EOF
    then
      remote_upload_success=true
      log_success "Remote snapshot successfully uploaded to Google Drive from Secondary VPS."
    else
      log_error "Failed to upload snapshot to Google Drive from Secondary VPS."
    fi
  fi

  if [ -n "$GCS_BUCKET_NAME" ]; then
    remote_upload_attempted=true
    log_info "Moving snapshot archive to Google Cloud Storage (gs://$GCS_BUCKET_NAME)..."
    if remote_exec "gcloud storage cp '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' 'gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst'"; then
      remote_upload_success=true
      log_success "Remote snapshot successfully uploaded to gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst from Secondary VPS."
    else
      log_error "Failed to upload snapshot to gs://$GCS_BUCKET_NAME from Secondary VPS."
    fi
  fi

  if [ "$remote_upload_attempted" = true ]; then
    if [ "$remote_upload_success" = true ]; then
      log_info "Remote cloud upload succeeded. Cleaning up temporary archive on Secondary VPS..."
      remote_exec "rm -f '$remote_staging/snapshot-$SERVICE_NAME.tar.zst'"
    else
      log_warn "Remote cloud upload failed. Preserving fallback archive on Secondary VPS at $remote_archives/snapshot-$SERVICE_NAME.tar.zst."
      remote_exec "mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst'"
    fi
  else
    log_info "Storing snapshot archive locally on Secondary VPS..."
    remote_exec "mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst'"
    log_success "Remote snapshot successfully created and stored on Secondary VPS at $remote_archives/snapshot-$SERVICE_NAME.tar.zst."
  fi

  log_info "Cleaning staging directory on Secondary VPS..."
  remote_exec "rm -rf '$remote_staging'/*"
}

function main() {
  LOG_PATH=/var/log/odoo/_utilities/snapshot-$SERVICE_NAME.log

  # Redirect stdout and stderr to tee
  exec > >(tee -a "$LOG_PATH") 2>&1

  # Self-elevate to root if not already
  if [ "$(id -u)" -ne 0 ]; then
      log_info "Elevating permissions to root..."
      # shellcheck disable=SC2093
      exec sudo "$0" "$@" # Re-run the script with sudo
      log_error "Failed to elevate to root. Please run with sudo." # This will only run if exec fails
      exit 1
  fi

  # Prevent multiple snapshot instances from running simultaneously
  LOCK_FILE="/var/run/snapshot-$SERVICE_NAME.lock"
  exec 200>"$LOCK_FILE"
  if ! flock -n 200; then
    local running_pid
    running_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "unknown")
    log_warn "Another snapshot instance for $SERVICE_NAME is already running (PID: $running_pid). Exiting."
    exit 0
  fi
  echo "$$" > "$LOCK_FILE"

  ZIP_FILE_NAME="backupdata-$SERVICE_NAME.zip"
  ZIP_STAGING_DIR="/tmp/backupdata_staging_$SERVICE_NAME"
  BACKUPDATA_ZIP_PATH="/tmp/$ZIP_FILE_NAME"
  SNAPSHOT_CACHE_DIR="$OWNER_HOME/.odoo-snapshots/$SERVICE_NAME/cache"
  SNAPSHOT_CACHE_ZIP="$SNAPSHOT_CACHE_DIR/backupdata-$SERVICE_NAME.zip"
  GIT_HASHES_FILE=""

  cleanup_temp_files() {
      local exit_code=$?
      if [[ -n "$LOCK_FILE" && -f "$LOCK_FILE" ]]; then
          rm -f "$LOCK_FILE"
      fi
      if [[ -n "$ZIP_STAGING_DIR" && -d "$ZIP_STAGING_DIR" ]]; then
          rm -rf "$ZIP_STAGING_DIR"
      fi
      if [[ -n "$BACKUPDATA_ZIP_PATH" && -f "$BACKUPDATA_ZIP_PATH" ]]; then
          rm -f "$BACKUPDATA_ZIP_PATH"
      fi
      if [[ -n "$GIT_HASHES_FILE" && -f "$GIT_HASHES_FILE" ]]; then
          rm -f "$GIT_HASHES_FILE"
      fi
      if [ $exit_code -ne 0 ]; then
          if [[ -n "$TAR_FILE_PATH" && -f "$TAR_FILE_PATH" ]]; then
              rm -f "$TAR_FILE_PATH"
          fi
      fi
  }
  trap cleanup_temp_files EXIT

  echo "-------------------------------------------------------------------------------"
  echo " DAILY SNAPSHOT FOR $SERVICE_NAME @ $(date +"%A, %d %B %Y %H:%M %Z")"
  echo "-------------------------------------------------------------------------------"

  # enter the production database name this is required to backup the database
  # Robust parsing for DB_NAME
  ODOO_DATABASE_NAME_PRD=$(grep "^DB_NAME=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  if [ -z "$ODOO_DATABASE_NAME_PRD" ]; then
    log_error "Please setup DB_NAME in your .env file!"
    exit 1
  fi

  # ask to replace the existing snapshot file
  # enter "Y" to add question to replace the existing snapshot file
  ASK_TO_REPLACE_EXISTING_SNAPSHOT=$(grep "^ASK_TO_REPLACE_EXISTING_SNAPSHOT=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # Custom directories to backup (semicolon separated)
  SNAPSHOT_CUSTOM_DIRS=$(grep "^SNAPSHOT_CUSTOM_DIRS=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # you can leave it as is to back up to the /tmp directory instead of Google Cloud Storage (GCS)
  GCS_BUCKET_NAME=$(grep "^GCS_BUCKET_NAME=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # Google Drive upload configuration
  GDRIVE_ACCESS_TOKEN=$(grep "^GDRIVE_ACCESS_TOKEN=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_SERVICE_ACCOUNT_KEY=$(grep "^GDRIVE_SERVICE_ACCOUNT_KEY=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_FOLDER_ID=$(grep "^GDRIVE_FOLDER_ID=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_CHUNK_SIZE=$(grep "^GDRIVE_CHUNK_SIZE=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_MAX_BACKUPS=$(grep "^GDRIVE_MAX_BACKUPS=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [ -z "$GDRIVE_MAX_BACKUPS" ] && GDRIVE_MAX_BACKUPS="7"

  # The number represents the compression level for Zstandard (zstd)
  SNAPSHOT_COMPRESSION_LEVEL=$(grep "^SNAPSHOT_COMPRESSION_LEVEL=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  if [ -z "$SNAPSHOT_COMPRESSION_LEVEL" ]; then
    SNAPSHOT_COMPRESSION_LEVEL=7
  fi

  if ! [[ "$SNAPSHOT_COMPRESSION_LEVEL" =~ ^[0-9]+$ ]]; then
    log_error "SNAPSHOT_COMPRESSION_LEVEL must be a number!"
    exit 1
  fi

  # Secondary VPS Remote Snapshot Config
  SNAPSHOT_REMOTE_HOST=$(grep "^SNAPSHOT_REMOTE_HOST=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_USER=$(grep "^SNAPSHOT_REMOTE_USER=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_PORT=$(grep "^SNAPSHOT_REMOTE_PORT=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_KEY=$(grep "^SNAPSHOT_REMOTE_KEY=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [ -z "$SNAPSHOT_REMOTE_PORT" ] && SNAPSHOT_REMOTE_PORT="22"

  # Extract Odoo version metadata
  extract_odoo_version_info

  # --- Branch: Remote Secondary VPS Snapshot Mode ---
  if [ -n "$SNAPSHOT_REMOTE_HOST" ]; then
    if [ -z "$SNAPSHOT_REMOTE_USER" ]; then
      log_error "SNAPSHOT_REMOTE_USER is required when SNAPSHOT_REMOTE_HOST is set in .env!"
      exit 1
    fi
    log_info "Executing snapshot in Remote Secondary VPS Mode ($SNAPSHOT_REMOTE_USER@$SNAPSHOT_REMOTE_HOST)..."
    run_remote_snapshot "$SNAPSHOT_REMOTE_HOST" "$SNAPSHOT_REMOTE_USER" "$SNAPSHOT_REMOTE_PORT" "$SNAPSHOT_REMOTE_KEY" "$SNAPSHOT_COMPRESSION_LEVEL"
    echo
    return 0
  fi

  # --- Branch: Local Snapshot Mode (Default) ---
  if ! command -v zstd >/dev/null 2>&1; then
    log_error "zstd is not installed. Please install zstd first."
    echo "For Ubuntu: sudo apt install zstd"
    echo "For CentOS: sudo yum install zstd"
    exit 1
  fi

  if ! command -v zip >/dev/null 2>&1; then
    log_error "zip is not installed. Please install zip first."
    echo "For Ubuntu: sudo apt install zip"
    echo "For CentOS: sudo yum install zip"
    exit 1
  fi

  if ! command -v curl >/dev/null 2>&1; then
    log_error "curl is not installed. Please install curl first."
    echo "For Ubuntu: sudo apt install curl"
    echo "For CentOS: sudo yum install curl"
    exit 1
  fi

  if ! command -v dd >/dev/null 2>&1; then
    log_error "dd is not installed. Please install coreutils first."
    exit 1
  fi

  # --- Dynamic Odoo Version Extraction & Staging ---
  rm -rf "$ZIP_STAGING_DIR" "$BACKUPDATA_ZIP_PATH"
  mkdir -p "$ZIP_STAGING_DIR"
  mkdir -p "$SNAPSHOT_CACHE_DIR"
  chmod 700 "$OWNER_HOME/.odoo-snapshots" "$SNAPSHOT_CACHE_DIR" 2>/dev/null || true

  log_info "Dumping $ODOO_DATABASE_NAME_PRD database to staging dump.sql..."
  if ! run_pg_dump --no-owner "$ODOO_DATABASE_NAME_PRD" > "$ZIP_STAGING_DIR/dump.sql"; then
    log_error "pg_dump failed."
    exit 1
  fi

  log_info "Generating manifest.json for backup bundle (Odoo version: $MANIFEST_VERSION)..."
  cat <<EOF > "$ZIP_STAGING_DIR/manifest.json"
{
    "odoo_dump": "1",
    "db_name": "$ODOO_DATABASE_NAME_PRD",
    "version": "$MANIFEST_VERSION",
    "version_info": $MANIFEST_VERSION_INFO,
    "major_version": "$MANIFEST_MAJOR_VERSION",
    "modules": {}
}
EOF

  ODOO_FILESTORE_PATH="/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD"
  if [ -d "$ODOO_FILESTORE_PATH" ]; then
    log_info "Symlinking filestore to staging..."
    ln -s "$ODOO_FILESTORE_PATH" "$ZIP_STAGING_DIR/filestore"
  else
    log_warn "Filestore path not found: $ODOO_FILESTORE_PATH"
  fi

  if [ -f "$SNAPSHOT_CACHE_ZIP" ]; then
    log_info "Updating cached $ZIP_FILE_NAME incrementally..."
    (cd "$ZIP_STAGING_DIR" && zip -u -q "$SNAPSHOT_CACHE_ZIP" dump.sql manifest.json)
    if [ -d "$ZIP_STAGING_DIR/filestore" ]; then
      (cd "$ZIP_STAGING_DIR" && zip -u -FS -0 -r -q "$SNAPSHOT_CACHE_ZIP" filestore)
    fi
  else
    log_info "Creating initial cached $ZIP_FILE_NAME (store mode)..."
    if [ -d "$ZIP_STAGING_DIR/filestore" ]; then
      (cd "$ZIP_STAGING_DIR" && zip -0 -r -q "$SNAPSHOT_CACHE_ZIP" dump.sql manifest.json filestore)
    else
      (cd "$ZIP_STAGING_DIR" && zip -0 -r -q "$SNAPSHOT_CACHE_ZIP" dump.sql manifest.json)
    fi
  fi

  # Maintain correct ownership and permissions on cache
  chown -R "$REPOSITORY_OWNER": "$SNAPSHOT_CACHE_DIR" 2>/dev/null || true
  chmod 644 "$SNAPSHOT_CACHE_ZIP" 2>/dev/null || true

  # Clean up staging directory after zipping
  rm -rf "$ZIP_STAGING_DIR"

  log_info "Copying cached backup bundle to staging..."
  cp -f "$SNAPSHOT_CACHE_ZIP" "$BACKUPDATA_ZIP_PATH"

  ## This variable below to define the new variable (DON'T EDIT)
  # Use array for files
  files_dirs_to_tar=()

  # Include bundled backup data ZIP
  files_dirs_to_tar+=("$BACKUPDATA_ZIP_PATH")

  # Generate Git Hashes to a temporary file
  GIT_HASHES_FILE=$(mktemp --tmpdir "git_hashes_XXXXXX.txt")
  chmod 644 "$GIT_HASHES_FILE"

  writeGitHash "$PATH_TO_ODOO/git" "$GIT_HASHES_FILE"
  writeGitHash "$PATH_TO_ODOO/odoo-base" "$GIT_HASHES_FILE"

  files_dirs_to_tar+=("$GIT_HASHES_FILE")

  # Add custom directories if defined
  if [ -n "$SNAPSHOT_CUSTOM_DIRS" ]; then
    log_info "Processing custom backup directories..."
    IFS=';' read -ra ADDR <<< "$SNAPSHOT_CUSTOM_DIRS"
    for dir in "${ADDR[@]}"; do
        # Trim whitespace
        dir=$(echo "$dir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        if [ -n "$dir" ]; then
            if [ -e "$dir" ]; then
                log_info "Adding custom directory: $dir"
                files_dirs_to_tar+=("$dir")
            else
                log_warn "Custom directory not found: $dir"
            fi
        fi
    done
  fi

  TAR_FILE_NAME=snapshot-$SERVICE_NAME.tar.zst
  TAR_FILE_PATH=/tmp/$TAR_FILE_NAME

  areYouReallySure "$TAR_FILE_PATH" "$ASK_TO_REPLACE_EXISTING_SNAPSHOT"

  # Use absolute paths for consistency
  files_dirs_to_tar+=("$PATH_TO_ODOO/.secrets")
  files_dirs_to_tar+=("$PATH_TO_ODOO/conf/odoo.conf")
  files_dirs_to_tar+=("$PATH_TO_ODOO/.env")
  files_dirs_to_tar+=("$PATH_TO_ODOO/requirements.txt")

  if [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME" ]; then
    files_dirs_to_tar+=("$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME")
  fi

  if [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME" ]; then
    files_dirs_to_tar+=("$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME")
  fi

  if [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME" ]; then
    files_dirs_to_tar+=("$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME")
  fi

  log_info "Backing up the database and its datadir..."
  # Use array expansion
  if ! tar -cf "$TAR_FILE_PATH" -I "zstd -vT0 -$SNAPSHOT_COMPRESSION_LEVEL --ultra" "${files_dirs_to_tar[@]}" > /dev/null 2>&1; then
    log_error "tar failed to backup the database and its datadir."
    exit 1
  fi

  log_info "Changing the ownership of the snapshot file..."
  chown "$REPOSITORY_OWNER": "$TAR_FILE_PATH"

  local remote_upload_attempted=false
  local remote_upload_success=false

  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    remote_upload_attempted=true
    log_info "Uploading snapshot file to Google Drive..."
    if upload_to_gdrive "$TAR_FILE_PATH" "$GDRIVE_ACCESS_TOKEN" "$GDRIVE_SERVICE_ACCOUNT_KEY" "$GDRIVE_FOLDER_ID" "$GDRIVE_CHUNK_SIZE" "$GDRIVE_MAX_BACKUPS"; then
      remote_upload_success=true
      log_success "The snapshot File Uploaded Successfully to Google Drive: $TAR_FILE_NAME"
    else
      log_error "Failed to upload snapshot file to Google Drive."
    fi
  fi

  if [ -n "$GCS_BUCKET_NAME" ]; then
    remote_upload_attempted=true
    # Disable parallel composite upload compatibility check to avoid permission errors if not already set.
    if [ "$(sudo -u "$REPOSITORY_OWNER" gcloud config get-value storage/parallel_composite_upload_compatibility_check 2>/dev/null)" != "false" ]; then
      sudo -u "$REPOSITORY_OWNER" gcloud config set storage/parallel_composite_upload_compatibility_check false 2>/dev/null
    fi
    if sudo -u "$REPOSITORY_OWNER" gcloud storage ls "gs://$GCS_BUCKET_NAME" > /dev/null 2>&1; then
      log_info "Uploading the snapshot file to Google Cloud Storage bucket: gs://$GCS_BUCKET_NAME."
      if sudo -u "$REPOSITORY_OWNER" gcloud storage cp "$TAR_FILE_PATH" "gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME"; then
        remote_upload_success=true
        log_success "The snapshot File Created Successfully named $TAR_FILE_NAME. File Backed up at gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME."
      else
        log_error "Error can't copy the snapshot file to gs://$GCS_BUCKET_NAME. Exit code: $?"
      fi
    else
      log_error "Error cannot access Google Cloud Storage (GCS). Exit code: $?"
      log_error "Please make sure the GCS_BUCKET_NAME on your .env file is the valid GCS Bucket Name."
    fi
  fi

  if [ "$remote_upload_attempted" = true ]; then
    if [ "$remote_upload_success" = true ]; then
      rm -f "$TAR_FILE_PATH"
    else
      log_warn "Remote upload failed. Preserving snapshot file locally in temporary directory."
      moveSnapshotFileToTempDir "$TAR_FILE_PATH" "$TAR_FILE_NAME"
    fi
  else
    moveSnapshotFileToTempDir "$TAR_FILE_PATH" "$TAR_FILE_NAME"
  fi
  echo
}

main "$@"
