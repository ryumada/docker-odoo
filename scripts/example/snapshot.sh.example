#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Creates a full Odoo snapshot (database dump + filestore + configs) locally or via secondary VPS over SSH.
# Usage: ./scripts/snapshot-SERVICE_NAME.sh [auto]
# Dependencies: sudo, git, zstd, tar, docker, pg_dump, gcloud, rsync, ssh, curl, dd, flock, ionice

CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_ODOO")
OWNER_HOME=$(eval echo "~$REPOSITORY_OWNER")
TAR_PROJECT_ROOT="${PATH_TO_ODOO#/}"

# --- Logging Functions & Colors ---
# Define colors for log messages
readonly COLOR_RESET="\033[0m"
readonly COLOR_INFO="\033[0;34m"
readonly COLOR_SUCCESS="\033[0;32m"
readonly COLOR_WARN="\033[0;33m"
readonly COLOR_ERROR="\033[0;31m"

# Function to log messages with a specific color and emoji
log() {
  local color="$1"
  local emoji="$2"
  local message="$3"
  echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() { log "${COLOR_ERROR}" "❌" "$1"; }
# ------------------------------------

# Shared queue lock (this host and the Secondary VPS), see scripts/lib/queue_lock.sh
if [ -f "$CURRENT_DIR/lib/queue_lock.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/lib/queue_lock.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/queue_lock.sh" ]; then
  # shellcheck source=/dev/null
  source "$PATH_TO_ODOO/scripts/lib/queue_lock.sh"
else
  log_error "scripts/lib/queue_lock.sh not found. Update docker-odoo (git pull) and re-run ./setup.sh."
  exit 1
fi

# Snapshot storage helpers: sha256 sidecars, Drive retention/upload checks, GCS checks
if [ -f "$CURRENT_DIR/lib/snapshot_storage.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/lib/snapshot_storage.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/snapshot_storage.sh" ]; then
  # shellcheck source=/dev/null
  source "$PATH_TO_ODOO/scripts/lib/snapshot_storage.sh"
else
  log_error "scripts/lib/snapshot_storage.sh not found. Update docker-odoo (git pull) and re-run ./setup.sh."
  exit 1
fi

# Odoo version reader for manifest.json
if [ -f "$CURRENT_DIR/lib/odoo_version.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/lib/odoo_version.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/odoo_version.sh" ]; then
  # shellcheck source=/dev/null
  source "$PATH_TO_ODOO/scripts/lib/odoo_version.sh"
else
  log_error "scripts/lib/odoo_version.sh not found. Update docker-odoo (git pull) and re-run ./setup.sh."
  exit 1
fi

# Database and filestore sizes for manifest.json
if [ -f "$CURRENT_DIR/lib/odoo_sizes.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/lib/odoo_sizes.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/odoo_sizes.sh" ]; then
  # shellcheck source=/dev/null
  source "$PATH_TO_ODOO/scripts/lib/odoo_sizes.sh"
else
  log_error "scripts/lib/odoo_sizes.sh not found. Update docker-odoo (git pull) and re-run ./setup.sh."
  exit 1
fi

function run_pg_dump() {
  local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
  local db_host
  db_host=$(grep "^DB_HOST=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port db_user db_pass docker_net net
    db_port=$(grep "^DB_PORT=" "$env_file" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^[""'\\']//;s/[""'\\']$//')
    db_user=$(grep "^ACTIVE_DB_USER=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    [ -z "$db_user" ] && db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
    db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
    docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" 2>/dev/null | cut -d "=" -f 2 | sed 's/^[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^[""'\\']//;s/[""'\\']$//')
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    local net
    net=$(echo "$docker_net" | cut -d "," -f 1)
    PGPASSWORD="$db_pass" docker run -i --rm --network="$net" -e PGPASSWORD postgres pg_dump -h "$db_host" -p "$db_port" -U "$db_user" "$@"
  else
    sudo -u postgres pg_dump "$@"
  fi
}

function areYouReallySure() {
  tar_file_path=$1
  ASK_TO_REPLACE_EXISTING_SNAPSHOT=$2
  if [ -f "$tar_file_path" ]; then
    if [ "$ASK_TO_REPLACE_EXISTING_SNAPSHOT" == "Y" ]; then
      echo "current snapshot file already exists, do you want to overwrite it? ($tar_file_path)"
      echo -e "type 'yes I am sure' to continue.\n"

      read -rp ": " CONFIRMATION

      case $CONFIRMATION in
        "yes I am sure")
          log_info "Overwriting the current snapshot file."
          rm -f "$tar_file_path"
          ;;
        *)
          log_error "You're not sure, okay. Now exiting the script."
          exit 1
          ;;
      esac
    else
      log_info "Removing the existing snapshot file."
      rm -f "$tar_file_path"
    fi
  fi
}

function getGitHash() {
  local git_path=$1
  local output_file=$2
  local git_real_owner
  git_real_owner=$(stat -c '%U' "$git_path" 2>/dev/null || echo "$REPOSITORY_OWNER")

  {
      echo "  Updated at [$(date +"%Y-%m-%d %H:%M:%S")]"
      echo "  Git Directory: $git_path"
      echo "  Git Remote: $(sudo -u "$git_real_owner" git -C "$git_path" config --get remote.origin.url 2>/dev/null || echo "N/A")"
      echo "  Git Branch: $(sudo -u "$git_real_owner" git -C "$git_path" branch --show-current 2>/dev/null || echo "HEAD")"
      echo "  Git Hashes: $(sudo -u "$git_real_owner" git -C "$git_path" rev-parse HEAD 2>/dev/null || echo "N/A")"
      echo ""
  } >> "$output_file"
}

function getSubDirectories() {
  local dir=$1
  ls -d "$dir"/*/ 2>/dev/null || true
}

function isDirectoryGitRepository() {
  # _inherit = writeGitHash

  local dir=$1
  local git_real_owner
  git_real_owner=$(stat -c '%U' "$dir" 2>/dev/null || echo "$REPOSITORY_OWNER")

  if [ -e "$dir/.git" ]; then
    if sudo -u "$git_real_owner" git -C "$dir" rev-parse --is-inside-work-tree &>/dev/null; then
      return 0
    else
      return 1
    fi
  else
    return 1
  fi
}

function moveSnapshotFileToTempDir() {
  local tar_file_path=$1
  local tar_file_name=$2

  local snapshot_archive_dir="$OWNER_HOME/.odoo-snapshots/$SERVICE_NAME/archives"
  mkdir -p "$snapshot_archive_dir" 2>/dev/null || true
  chmod 700 "$OWNER_HOME/.odoo-snapshots" "$snapshot_archive_dir" 2>/dev/null || true

  local dest_dir
  dest_dir="$snapshot_archive_dir/$tar_file_name-$(date +"%Y%m%d-%H%M%S")"
  if ! OUTPUT_mkdir=$(mkdir -p "$dest_dir" 2>&1); then
    log_error "Can't create the archive directory: $OUTPUT_mkdir"
    exit 1
  fi

  log_info "Moving the snapshot file to $dest_dir/..."
  mv "$tar_file_path" "$dest_dir/$tar_file_name"
  # Keep the checksum file next to its snapshot (sha256sum -c works inside this folder)
  [ -f "$tar_file_path.sha256" ] && mv "$tar_file_path.sha256" "$dest_dir/$tar_file_name.sha256"

  chmod 755 "$dest_dir" 2>/dev/null || true
  chmod 644 "$dest_dir/$tar_file_name" "$dest_dir/$tar_file_name.sha256" 2>/dev/null || true
  chown -R "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$dest_dir" 2>/dev/null || true

  # Also place/link at $OWNER_HOME for immediate convenient access
  ln -sf "$dest_dir/$tar_file_name" "$OWNER_HOME/$tar_file_name" 2>/dev/null || cp -f "$dest_dir/$tar_file_name" "$OWNER_HOME/$tar_file_name" 2>/dev/null || true

  log_success "The snapshot File Created Successfully named $tar_file_name. File Backed up at $dest_dir/$tar_file_name"
}

function get_gdrive_access_token_from_sa() {
  local sa_input="$1"
  local sa_json_content=""

  if [ -f "$sa_input" ]; then
    sa_json_content=$(cat "$sa_input")
  elif [[ "$sa_input" =~ ^\{.*\}$ ]]; then
    sa_json_content="$sa_input"
  else
    log_error "Service Account JSON key file or content '$sa_input' not found."
    return 1
  fi

  local client_email token_uri key_pem
  client_email=$(echo "$sa_json_content" | grep -o '"client_email": *"[^"]*"' | cut -d'"' -f4)
  token_uri=$(echo "$sa_json_content" | grep -o '"token_uri": *"[^"]*"' | cut -d'"' -f4)
  [ -z "$token_uri" ] && token_uri="https://oauth2.googleapis.com/token"

  key_pem=$(echo "$sa_json_content" | grep -o '"private_key": *"[^"]*"' | sed 's/^"private_key": *"//;s/"$//')

  if [ -z "$client_email" ] || [ -z "$key_pem" ]; then
    log_error "Could not parse client_email or private_key from Service Account JSON."
    return 1
  fi

  local b64url_cmd='openssl base64 -e -A | tr "+/" "-_" | tr -d "="'
  local now exp header_b64 claims claims_b64 unsigned_jwt sig_b64 jwt
  now=$(date +%s)
  exp=$((now + 3600))

  header_b64=$(echo -n '{"alg":"RS256","typ":"JWT"}' | eval "$b64url_cmd")
  claims="{\"iss\":\"$client_email\",\"scope\":\"https://www.googleapis.com/auth/drive\",\"aud\":\"$token_uri\",\"exp\":$exp,\"iat\":$now}"
  claims_b64=$(echo -n "$claims" | eval "$b64url_cmd")

  unsigned_jwt="${header_b64}.${claims_b64}"
  sig_b64=$(printf "%s" "$unsigned_jwt" | openssl dgst -sha256 -sign <(printf '%b' "$key_pem") -binary 2>/dev/null | eval "$b64url_cmd")

  if [ -z "$sig_b64" ]; then
    log_error "Failed to sign Service Account JWT with openssl."
    return 1
  fi

  jwt="${unsigned_jwt}.${sig_b64}"

  local token_response
  token_response=$(curl -s -X POST \
    -d "grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer" \
    --data-urlencode "assertion@"<(printf '%s' "$jwt") \
    "$token_uri")

  echo "$token_response" | grep -o '"access_token": *"[^"]*"' | cut -d'"' -f4
}

function is_gdrive_token_valid() {
  local token="$1"
  [ -z "$token" ] && return 1

  local resp http_code exp
  resp=$(curl -s --connect-timeout 5 --max-time 10 -w "\n%{http_code}" --data-urlencode "access_token@"<(printf '%s' "${token}") "https://oauth2.googleapis.com/tokeninfo" 2>/dev/null || true)
  http_code=$(echo "$resp" | tail -n1)

  if [ "$http_code" = "200" ]; then
    exp=$(echo "$resp" | sed '$d' | grep -o '"expires_in": *"[^"]*"' | cut -d'"' -f4)
    [ -z "$exp" ] && exp=$(echo "$resp" | sed '$d' | grep -o '"expires_in": *[0-9]*' | awk '{print $2}')
    if [ -n "$exp" ] && [ "$exp" -gt 60 ] 2>/dev/null; then
      return 0
    fi
  fi
  return 1
}

function resolve_gdrive_access_token() {
  local current_token="$1"
  local raw_access_token="$2"
  local sa_input="$3"

  # If current token is provided and still valid, reuse it without renewing
  if is_gdrive_token_valid "$current_token"; then
    echo "$current_token"
    return 0
  fi

  # Otherwise renew bearer token
  if [ -n "$sa_input" ]; then
    get_gdrive_access_token_from_sa "$sa_input"
  elif [ -n "$raw_access_token" ]; then
    if [ -f "$raw_access_token" ]; then
      if [[ "$raw_access_token" == *.json ]] || grep -q '"type": *"service_account"' "$raw_access_token" 2>/dev/null; then
        get_gdrive_access_token_from_sa "$raw_access_token"
      else
        local file_tok
        file_tok=$(tr -d '\r\n' < "$raw_access_token")
        if is_gdrive_token_valid "$file_tok"; then
          echo "$file_tok"
        elif [ -n "$sa_input" ]; then
          get_gdrive_access_token_from_sa "$sa_input"
        else
          echo "$file_tok"
        fi
      fi
    elif [[ "$raw_access_token" =~ ^\{.*\}$ ]]; then
      get_gdrive_access_token_from_sa "$raw_access_token"
    else
      echo "$raw_access_token"
    fi
  fi
}

function cleanup_gdrive_old_snapshots() {
  # Keeps the newest <max_backups> snapshots of this service on Google Drive.
  # Each snapshot is deleted together with its .sha256 file (see scripts/lib/snapshot_storage.sh).
  local access_token="$1"
  local folder_id="$2"
  local service_name="$3"
  local max_backups="$4"
  local raw_access_token="${5:-$access_token}"
  local sa_input="$6"

  if [ -z "$max_backups" ] || ! [[ "$max_backups" =~ ^[0-9]+$ ]] || [ "$max_backups" -le 0 ]; then
    return 0
  fi

  local valid_token
  valid_token=$(resolve_gdrive_access_token "$access_token" "$raw_access_token" "$sa_input")
  [ -n "$valid_token" ] && access_token="$valid_token"

  gds_retention "$access_token" "$folder_id" "$service_name" "$max_backups"
}

function upload_to_gdrive() {
  local file_path="$1"
  local raw_access_token="$2"
  local sa_key_path="$3"
  local folder_id="$4"
  local chunk_size_cfg="$5"
  local max_backups_cfg="$6"
  local service_name="${7:-$SERVICE_NAME}"

  if [ -z "$service_name" ]; then
    service_name=$(basename "$file_path" | sed -E 's/^snapshot-(.*)\.tar\.zst$/\1/' | sed -E 's/-[0-9]{8}-[0-9]{6}$//')
  fi

  if [ ! -f "$file_path" ]; then
    log_error "Snapshot file '$file_path' not found for Google Drive upload."
    return 1
  fi

  log_info "Verifying Google Drive bearer token validity..."
  local access_token
  access_token=$(resolve_gdrive_access_token "$raw_access_token" "$raw_access_token" "$sa_key_path")

  if [ -z "$access_token" ]; then
    log_error "Google Drive access token could not be obtained (check your access token or Service Account key file)."
    return 1
  fi

  # Default chunk size: 5 MiB (5 * 1024 * 1024 = 5242880 bytes)
  # Chunk size MUST be a positive multiple of 256 KiB (262144 bytes)
  local chunk_size=5242880
  if [ -n "$chunk_size_cfg" ]; then
    if [[ "$chunk_size_cfg" =~ ^[0-9]+$ ]] && [ "$chunk_size_cfg" -gt 0 ] && [ "$((chunk_size_cfg % 262144))" -eq 0 ]; then
      chunk_size="$chunk_size_cfg"
    else
      log_warn "Invalid GDRIVE_CHUNK_SIZE '$chunk_size_cfg'. It must be a positive multiple of 262144 bytes. Using default 5242880 (5 MiB)."
    fi
  fi

  local upload_timestamp
  upload_timestamp=$(date +"%Y%m%d-%H%M%S")
  local file_name="snapshot-${service_name}-${upload_timestamp}.tar.zst"
  local file_size mime_type
  file_size=$(wc -c < "$file_path" | tr -d ' ')
  mime_type="application/octet-stream"

  log_info "Initiating Google Drive resumable upload session for $file_name ($file_size bytes, chunk size: $chunk_size bytes)..."

  # Build JSON metadata
  local metadata="{\"name\": \"$file_name\""
  if [ -n "$folder_id" ]; then
    metadata="$metadata, \"parents\": [\"$folder_id\"]"
  fi
  metadata="$metadata}"

  local init_response
  init_response=$(curl -s -i -X POST \
    -H @<(printf 'Authorization: Bearer %s\n' "$access_token") \
    -H "X-Upload-Content-Type: $mime_type" \
    -H "X-Upload-Content-Length: $file_size" \
    -H "Content-Type: application/json; charset=UTF-8" \
    -d "$metadata" \
    "https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&supportsAllDrives=true")

  local session_uri
  session_uri=$(echo "$init_response" | grep -i "^location:" | tr -d '\r' | awk '{print $2}')

  if [ -z "$session_uri" ]; then
    log_error "Failed to initiate Google Drive upload session."
    log_error "Google Drive API Response: $init_response"
    return 1
  fi

  log_info "Google Drive upload session created successfully."

  local start_byte=0
  local chunk_index=0
  local max_retries=3
  local retry_count=0
  local upload_completed=false
  local uploaded_id=""

  while [ "$start_byte" -lt "$file_size" ]; do
    local end_byte=$((start_byte + chunk_size - 1))
    if [ "$end_byte" -ge "$file_size" ]; then
      end_byte=$((file_size - 1))
    fi

    local current_chunk_len=$((end_byte - start_byte + 1))
    local pct=$(( (end_byte + 1) * 100 / file_size ))

    log_info "Uploading bytes ${start_byte}-${end_byte}/${file_size} (${pct}%) to Google Drive..."

    local http_response http_status response_body
    http_response=$( (dd if="$file_path" bs="$chunk_size" skip="$chunk_index" count=1 status=none | \
      curl -s -w "\n%{http_code}" -X PUT \
        -H "Content-Length: $current_chunk_len" \
        -H "Content-Range: bytes ${start_byte}-${end_byte}/${file_size}" \
        --data-binary @- \
        "$session_uri") 2>/dev/null || true )

    http_status=$(echo "$http_response" | tail -n1)
    response_body=$(echo "$http_response" | sed '$d')

    if [ "$http_status" = "308" ]; then
      # 308 Resume Incomplete: Chunk uploaded successfully
      start_byte=$((end_byte + 1))
      chunk_index=$((chunk_index + 1))
      retry_count=0
    elif [ "$http_status" = "200" ] || [ "$http_status" = "201" ]; then
      # 200/201: File upload completed
      log_success "Google Drive chunked upload completed successfully for $file_name."
      uploaded_id=$(python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("id",""))
except Exception: print("")' <<< "$response_body")
      upload_completed=true
      break
    else
      log_warn "Chunk upload failed with HTTP status: $http_status. Response: $response_body"
      retry_count=$((retry_count + 1))
      if [ "$retry_count" -gt "$max_retries" ]; then
        log_error "Max retries ($max_retries) reached for Google Drive chunk upload."
        return 1
      fi

      log_info "Querying Google Drive upload session status (retry $retry_count/$max_retries)..."
      sleep 2
      local status_response query_status last_byte
      status_response=$(curl -s -i -X PUT \
        -H "Content-Length: 0" \
        -H "Content-Range: bytes */$file_size" \
        "$session_uri")

      query_status=$(echo "$status_response" | grep "^HTTP" | awk '{print $2}')
      if [ "$query_status" = "308" ]; then
        last_byte=$(echo "$status_response" | grep -i "^range:" | tr -d '\r' | awk -F'-' '{print $2}')
        if [ -n "$last_byte" ]; then
          start_byte=$((last_byte + 1))
          chunk_index=$((start_byte / chunk_size))
          log_info "Resuming Google Drive upload from byte $start_byte (Chunk #$chunk_index)..."
        fi
      elif [ "$query_status" = "200" ] || [ "$query_status" = "201" ]; then
        log_success "Google Drive upload was completed during session query."
        uploaded_id=$(printf '%s' "$status_response" | tr -d '\r' | sed -n '/^$/,$p' | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("id",""))
except Exception: print("")')
        upload_completed=true
        break
      fi
    fi
  done

  if [ "$upload_completed" != true ]; then
    return 0
  fi

  # Long uploads can outlive the token
  local fresh_token
  fresh_token=$(resolve_gdrive_access_token "$access_token" "$raw_access_token" "$sa_key_path")
  [ -n "$fresh_token" ] && access_token="$fresh_token"

  # Upload the .sha256 sidecar and cross-check Drive's own sha256 of the uploaded file
  if [ -f "$file_path.sha256" ]; then
    if [ -z "$uploaded_id" ]; then
      log_warn "Google Drive did not return the uploaded file ID; skipping the checksum check and .sha256 upload for $file_name."
    else
      local publish_rc=0
      gds_publish_sidecar "$access_token" "$folder_id" "$uploaded_id" "$file_name" "$file_path.sha256" || publish_rc=$?
      if [ "$publish_rc" -eq 1 ]; then
        log_error "Removing the broken copy $file_name from Google Drive so it is never restored by mistake."
        gds_delete_file "$access_token" "$uploaded_id" "$folder_id" >/dev/null || log_warn "Could not remove the broken copy $file_name from Google Drive. Delete it by hand."
        return 1
      fi
    fi
  else
    log_warn "No .sha256 file next to $file_path; uploaded without a checksum file."
  fi

  # The validator inbox records the name and id the snapshot got on Drive
  if [ -n "${SNAP_UPLOAD_RESULT:-}" ] && [ -n "$uploaded_id" ]; then
    printf '%s\t%s\n' "$file_name" "$uploaded_id" > "$SNAP_UPLOAD_RESULT"
  fi

  if [ -n "$max_backups_cfg" ]; then
    cleanup_gdrive_old_snapshots "$access_token" "$folder_id" "$service_name" "$max_backups_cfg" "$raw_access_token" "$sa_key_path"
  fi
  return 0
}


function collectGitMetadataAndNonGitDirs() {
  # Writes git_hashes.json/.txt and prints (stdout) every directory that must be bundled
  # into the snapshot, one relative path per line:
  #   - non-git directories under git/ and odoo-base/
  #   - git repositories that cannot be re-cloned at their current state
  #     (no remote, unreachable remote, unpushed commits, or uncommitted changes).
  #     These are bundled WITH their .git directory, and their remote/branch/commit
  #     is still recorded in git_hashes.json under "bundled_directories".
  local json_file=$1
  local txt_file=$2

  python3 -c '
import os, sys, json, subprocess

path_to_odoo = sys.argv[1]
repo_owner = sys.argv[2]
json_file = sys.argv[3]
txt_file = sys.argv[4]

GIT_ENV = [
    "env", "GIT_TERMINAL_PROMPT=0",
    "GIT_SSH_COMMAND=ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new",
]
REMOTE_CHECK_TIMEOUT = 30

def read_env_value(key, default):
    try:
        with open(os.path.join(path_to_odoo, ".env")) as f:
            for line in f:
                if line.startswith(key + "="):
                    val = line.split("=", 1)[1].split("#", 1)[0].strip().strip("\"").strip("\x27")
                    return val or default
    except Exception:
        pass
    return default

try:
    UNREACHABLE_BUNDLE_MAX_BYTES = int(read_env_value("SNAPSHOT_BUNDLE_UNREACHABLE_MAX_MB", "1024")) * 1024 * 1024
except ValueError:
    UNREACHABLE_BUNDLE_MAX_BYTES = 1024 * 1024 * 1024

git_repos = []
bundled_dirs = []
txt_lines = []

def warn(msg):
    sys.stderr.write("\033[0;33m[WARN] " + msg + "\033[0m\n")

def git_cmd(cmd, cwd):
    return ["sudo", "-u", repo_owner] + GIT_ENV + ["git", "-C", cwd] + cmd

def run_git(cmd, cwd, timeout=60, strip=True):
    try:
        res = subprocess.run(git_cmd(cmd, cwd), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, check=True, timeout=timeout)
        return res.stdout.strip() if strip else res.stdout
    except Exception:
        return ""

def git_succeeds(cmd, cwd, timeout):
    try:
        subprocess.run(git_cmd(cmd, cwd), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       check=True, timeout=timeout)
        return True
    except Exception:
        return False

def is_git_repo(path):
    if not os.path.isdir(path):
        return False
    if os.path.exists(os.path.join(path, ".git")):
        return run_git(["rev-parse", "--is-inside-work-tree"], path) == "true"
    return False

def dir_size_bytes(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total

def human(n):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return "{:.1f} {}".format(n, unit)
        n /= 1024.0

def uncommitted_changes(path):
    out = run_git(["status", "--porcelain", "--untracked-files=normal"], path, strip=False)
    changes = []
    for line in out.splitlines():
        if not line.strip():
            continue
        p = line[3:]
        # Python bytecode is regenerated automatically; never a reason to bundle
        if "__pycache__" in p or p.endswith(".pyc") or p.endswith(".pyo"):
            continue
        changes.append(line)
    return changes

def recoverability_issues(path, remote, commit):
    reasons = []
    if commit == "N/A":
        reasons.append("no_commits")
    if not remote:
        reasons.append("no_remote")
    elif not (git_succeeds(["ls-remote", "origin", "HEAD"], path, REMOTE_CHECK_TIMEOUT)
              or git_succeeds(["ls-remote", "origin", "HEAD"], path, REMOTE_CHECK_TIMEOUT)):
        reasons.append("remote_unreachable")
    elif commit != "N/A":
        unpushed = run_git(["rev-list", "--count", "HEAD", "--not", "--remotes"], path)
        if unpushed and unpushed != "0":
            reasons.append("unpushed_commits:" + unpushed)
    changes = uncommitted_changes(path)
    if changes:
        reasons.append("uncommitted_changes:" + str(len(changes)))
    return reasons

def add_git_repo(category, full_path, name):
    rel_path = os.path.relpath(full_path, path_to_odoo)
    remote = run_git(["config", "--get", "remote.origin.url"], full_path)
    branch = run_git(["branch", "--show-current"], full_path) or "HEAD"
    commit = run_git(["rev-parse", "HEAD"], full_path) or "N/A"
    reasons = recoverability_issues(full_path, remote, commit)
    entry = {
        "name": name,
        "category": category,
        "relative_path": rel_path,
        "remote": remote or "N/A",
        "branch": branch,
        "commit": commit,
    }
    git_path = os.path.join(full_path, ".git")
    is_worktree = os.path.isfile(git_path)
    if is_worktree:
        entry["git_worktree"] = True
    size = dir_size_bytes(full_path) if reasons else 0
    if reasons == ["remote_unreachable"] and size > UNREACHABLE_BUNDLE_MAX_BYTES:
        # Only the network check failed (often transient) and the repo is large:
        # do not bloat the snapshot, but flag it so restore/validation can report it.
        entry["remote_check"] = "unreachable"
        git_repos.append(entry)
        txt_lines.append("  Git Directory: {0}\n  Git Remote: {1}\n  Git Branch: {2}\n  Git Hashes: {3}\n  Remote Check: unreachable (not bundled)\n".format(
            rel_path, entry["remote"], branch, commit))
        warn("Remote of {0} is unreachable and the repository is {1} (over SNAPSHOT_BUNDLE_UNREACHABLE_MAX_MB). "
             "NOT bundled: restoring this snapshot depends on {2} being reachable.".format(rel_path, human(size), entry["remote"]))
        return
    if reasons:
        entry.update({
            "is_git": True,
            "included_in_snapshot": True,
            # A worktree only has a .git pointer file; its history lives in the main repository
            "includes_git_dir": not is_worktree,
            "bundled_reasons": reasons,
            "size_bytes": size,
        })
        bundled_dirs.append(entry)
        txt_lines.append(
            "  Bundled Git Directory: {0}\n  Git Remote: {1}\n  Git Branch: {2}\n  Git Hashes: {3}\n  Bundled Reason: {4}\n".format(
                rel_path, entry["remote"], branch, commit, ", ".join(reasons)))
        warn("Git repository {0} cannot be re-cloned ({1}). Bundling it into the snapshot{3} ({2}). "
             "Push it to a reachable remote to keep snapshots small.".format(
                 rel_path, ", ".join(reasons), human(size),
                 " (worktree: files only, no history)" if is_worktree else " with its .git"))
    else:
        git_repos.append(entry)
        txt_lines.append("  Git Directory: {0}\n  Git Remote: {1}\n  Git Branch: {2}\n  Git Hashes: {3}\n".format(
            rel_path, entry["remote"], branch, commit))

def add_non_git_dir(category, full_path, name):
    rel_path = os.path.relpath(full_path, path_to_odoo)
    bundled_dirs.append({
        "name": name,
        "category": category,
        "relative_path": rel_path,
        "is_git": False,
        "included_in_snapshot": True,
    })
    txt_lines.append("  Non-Git Directory (Bundled directly into snapshot): {0}\n".format(rel_path))

search_roots = [
    ("git", os.path.join(path_to_odoo, "git")),
    ("odoo-base", os.path.join(path_to_odoo, "odoo-base")),
]

for category, root in search_roots:
    if not os.path.isdir(root):
        continue
    if is_git_repo(root):
        add_git_repo(category, root, os.path.basename(root))
        continue
    try:
        entries = sorted(os.listdir(root))
    except Exception:
        entries = []
    for entry in entries:
        full_path = os.path.join(root, entry)
        if not os.path.isdir(full_path):
            continue
        if is_git_repo(full_path):
            add_git_repo(category, full_path, entry)
        else:
            add_non_git_dir(category, full_path, entry)

data = {
    "service_name": os.path.basename(path_to_odoo),
    "git_repositories": git_repos,
    "bundled_directories": bundled_dirs,
}

with open(json_file, "w") as f:
    json.dump(data, f, indent=2)

with open(txt_file, "w") as f:
    f.write("\n".join(txt_lines) + "\n")

for b in bundled_dirs:
    print(b["relative_path"])
' "$PATH_TO_ODOO" "$REPOSITORY_OWNER" "$json_file" "$txt_file"
}

function writeGitHash() {
  local search_dir=$1
  local output_file=$2
  local subdirs

  [ -d "$search_dir" ] || return 0

  if isDirectoryGitRepository "$search_dir"; then
    getGitHash "$search_dir" "$output_file"
    return 0
  fi

  subdirs="$(getSubDirectories "$search_dir")"

  for dir in $subdirs; do
    dir="${dir%/}"
    if isDirectoryGitRepository "$dir"; then
      getGitHash "$dir" "$output_file"
    else
      log_warn "$dir is not a git repository."
    fi
  done
}

# Odoo version for manifest.json (release.py, then ODOO_VERSION in .env): scripts/lib/odoo_version.sh
function extract_odoo_version_info() {
  odoo_version_detect "$PATH_TO_ODOO"
}

# Queue shared by every snapshot on a host (and on the Secondary VPS). Files: /tmp/odoo-backup-system.queue.*
readonly SNAPSHOT_QUEUE_NAME="odoo-backup-system"
# Fallback when SNAPSHOT_QUEUE_TIMEOUT is missing/invalid in .env (keep in sync with .env.example)
readonly DEFAULT_SNAPSHOT_QUEUE_TIMEOUT=43200

acquire_secondary_vps_queue_token() {
  local host="$1" timeout="$4"
  log_info "Acquiring queue slot on Secondary VPS ($host)..."
  queue_lock_acquire_remote "$SNAPSHOT_QUEUE_NAME" "$SERVICE_NAME" \
    "$SERVICE_NAME (remote from $(hostname -s 2>/dev/null || hostname))" "$timeout" remote_exec
}

release_secondary_vps_queue_token() {
  queue_lock_release_remote
}

function remote_write_stats() {
  # Args: free_before free_at_peak dump_bytes archive_bytes. Called from run_remote_snapshot (uses its
  # remote_exec and remote_base). Writes ~/.odoo-snapshots/<service>/stats.json on the Secondary VPS (see
  # snap_write_stats): the room this snapshot took there, which the validator keeps free for the next one.
  local funcs source_host
  source_host=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo unknown)
  funcs=$(declare -f snap_write_stats)
  if remote_exec "bash -s" << REMOTE_STATS_EOF
$funcs
snap_write_stats '$remote_base/stats.json' '$SERVICE_NAME' '$source_host' '$3' '$4' '$1' '$2'
REMOTE_STATS_EOF
  then
    log_info "Recorded snapshot sizes on Secondary VPS ($remote_base/stats.json): dump $3 bytes, archive $4 bytes, peak ${5:-unknown} bytes."
  else
    log_warn "Could not write $remote_base/stats.json on the Secondary VPS; drills there keep only VALIDATOR_DISK_RESERVE_GB free."
  fi
}

function remote_inbox_handoff() {
  # Args: mode(move|link) archive_on_secondary kept_copy gcs_object. Called from run_remote_snapshot
  # (uses its remote_exec, remote_home and remote_staging). Hands the archive to the validator inbox
  # on the Secondary VPS (~/.odoo-validator/inbox/<service>/, see snap_inbox_handoff), where the
  # drill worker takes it. Returns 0 when handed off; otherwise the caller does what it did before.
  local mode="$1" src="$2" kept="$3" gcs_object="$4" funcs source_host
  source_host=$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo unknown)
  funcs=$(declare -f log log_info log_success log_warn log_error _ss_log snap_sha256_of snap_sidecar_hash snap_write_sidecar snap_inbox_handoff snap_stats_reserve snap_disk_reserve_bytes)
  funcs+=$'\n'"SNAP_STATS_MAX_AGE_DAYS='$SNAP_STATS_MAX_AGE_DAYS'"
  remote_exec "bash -s" << REMOTE_INBOX_EOF
COLOR_RESET='$COLOR_RESET'
COLOR_INFO='$COLOR_INFO'
COLOR_SUCCESS='$COLOR_SUCCESS'
COLOR_WARN='$COLOR_WARN'
COLOR_ERROR='$COLOR_ERROR'
$funcs
snap_inbox_handoff '$src' '$mode' '$remote_home/.odoo-validator/inbox' '$SERVICE_NAME' '$VALIDATOR_DISK_RESERVE_GB' '$source_host' '$remote_staging/.drive-upload' '$gcs_object' '$kept' '$remote_home/.odoo-snapshots'
REMOTE_INBOX_EOF
}

function run_remote_snapshot() {
  local host="$1"
  local user="$2"
  local port="${3:-22}"
  local key="$4"
  local compression_level="$5"

  if [ -z "$key" ]; then
    local this_vps clean_tgt
    this_vps=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo "vps-source")
    clean_tgt=$(echo "$host" | sed -e 's|^.*://||' -e 's|^.*@||' -e 's|:.*$||' -e 's|/.*$||' -e 's|[^a-zA-Z0-9._-]|_|g')
    if [ -f "$OWNER_HOME/.ssh/snapshot-${this_vps}-${clean_tgt}" ]; then
      key="$OWNER_HOME/.ssh/snapshot-${this_vps}-${clean_tgt}"
    elif [ -f "$OWNER_HOME/.ssh/id_ed25519-snapshot-$SERVICE_NAME" ]; then
      key="$OWNER_HOME/.ssh/id_ed25519-snapshot-$SERVICE_NAME"
    elif [ -f "$OWNER_HOME/.ssh/id_ed25519_snapshot" ]; then
      key="$OWNER_HOME/.ssh/id_ed25519_snapshot"
    else
      key="$OWNER_HOME/.ssh/snapshot-${this_vps}-${clean_tgt}"
    fi
  fi
  key="${key/#\~/$OWNER_HOME}"
  local ssh_opts=(-p "$port" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5)
  local rsync_ssh="ssh -p $port -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5"
  if [ -n "$key" ] && [ -f "$key" ]; then
    ssh_opts+=(-i "$key")
    rsync_ssh+=" -i $key"
  fi

  remote_exec() {
    ssh "${ssh_opts[@]}" "$user@$host" "$@"
  }

  remote_sync() {
    rsync -e "$rsync_ssh" "$@"
  }

  log_info "Connecting to Secondary VPS ($user@$host:$port)..."
  if ! remote_exec "true" 2>/dev/null; then
    log_error "Failed to establish SSH connection with Secondary VPS at $user@$host:$port."
    exit 1
  fi
  log_success "SSH connection established with Secondary VPS."

  # Acquire queue slot on Secondary VPS to avoid I/O conflict with other instances
  local queue_timeout="${SNAPSHOT_QUEUE_TIMEOUT:-$DEFAULT_SNAPSHOT_QUEUE_TIMEOUT}"
  acquire_secondary_vps_queue_token "$host" "$user" "$port" "$queue_timeout"

  # Lower I/O and CPU scheduling priority on Secondary VPS
  remote_exec "if command -v ionice >/dev/null 2>&1; then ionice -c2 -n7 -p \$\$ 2>/dev/null || true; fi; renice -n 19 -p \$\$ >/dev/null 2>&1 || true"

  # Check required tools on Secondary VPS
  if ! remote_exec "command -v zstd >/dev/null 2>&1 && command -v tar >/dev/null 2>&1"; then
    log_error "Secondary VPS is missing required tools (zstd or tar). Please install them on Secondary VPS."
    exit 1
  fi

  # Check GCS access on Secondary VPS if GCS_BUCKET_NAME is configured
  if [ -n "$GCS_BUCKET_NAME" ]; then
    log_info "Verifying Google Cloud Storage access on Secondary VPS..."
    if ! remote_exec "command -v gcloud >/dev/null 2>&1"; then
      log_error "gcloud CLI is not installed on Secondary VPS ($host), but GCS_BUCKET_NAME is set in .env."
      exit 1
    fi

    # Disable parallel composite upload check on secondary if needed
    remote_exec "gcloud config set storage/parallel_composite_upload_compatibility_check false 2>/dev/null || true"

    if ! remote_exec "gcloud storage ls 'gs://$GCS_BUCKET_NAME' >/dev/null 2>&1"; then
      log_error "Secondary VPS ($host) cannot access Google Cloud Storage bucket: gs://$GCS_BUCKET_NAME"
      log_error "Please ensure gcloud is authenticated and has storage permissions on the Secondary VPS."
      exit 1
    fi
    log_success "Secondary VPS has verified access to gs://$GCS_BUCKET_NAME."
  fi

  # Check Google Drive access prerequisites on Secondary VPS if configured
  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    log_info "Verifying Google Drive upload tools on Secondary VPS..."
    if ! remote_exec "command -v curl >/dev/null 2>&1 && command -v dd >/dev/null 2>&1"; then
      log_error "Secondary VPS ($host) is missing curl or dd, which are required for Google Drive upload."
      exit 1
    fi
    if [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      if ! remote_exec "command -v openssl >/dev/null 2>&1"; then
        log_error "Secondary VPS ($host) is missing openssl, which is required for Service Account token generation."
        exit 1
      fi
    fi
    log_success "Secondary VPS has verified prerequisites for Google Drive upload."
  fi

  local remote_home
  remote_home=$(remote_exec 'echo "$HOME"' 2>/dev/null | tr -d '\r\n')
  if [ -z "$remote_home" ]; then
    log_error "Could not determine HOME directory on Secondary VPS."
    exit 1
  fi

  local remote_base="$remote_home/.odoo-snapshots/$SERVICE_NAME"
  local remote_mirror="$remote_base/mirror/filestore"
  local remote_cache="$remote_base/cache"
  local remote_staging="$remote_base/staging"
  local remote_archives="$remote_base/archives"

  log_info "Preparing directory structure on Secondary VPS under $remote_base/..."
  remote_exec "mkdir -p '$remote_mirror' '$remote_cache' '$remote_staging/tmp' '$remote_archives' && chmod 700 '$remote_home/.odoo-snapshots' && if [ -L '$remote_mirror/filestore' ]; then rm -f '$remote_mirror/filestore'; fi"
  # Free space on the Secondary VPS before anything is staged, for stats.json (the room this snapshot takes)
  local remote_free_before
  remote_free_before=$(remote_exec "df -PB1 '$remote_base' 2>/dev/null | awk 'NR == 2 {print \$4}'" 2>/dev/null | tr -d '\r\n')

  local odoo_filestore_path="/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD"
  if [ -d "$odoo_filestore_path" ]; then
    log_info "Syncing filestore to Secondary VPS (incremental pass 1)..."
    remote_sync -az --delete "$odoo_filestore_path/" "$user@$host:$remote_mirror/"
  else
    log_warn "Filestore path not found: $odoo_filestore_path"
  fi

  log_info "Streaming database dump directly to Secondary VPS..."
  if ! run_pg_dump --no-owner "$ODOO_DATABASE_NAME_PRD" | remote_exec "cat > $remote_staging/tmp/dump.sql"; then
    log_error "pg_dump stream to Secondary VPS failed."
    exit 1
  fi

  if ! remote_exec "[ -s '$remote_staging/tmp/dump.sql' ] && tail -n 25 '$remote_staging/tmp/dump.sql' | grep -q 'PostgreSQL database dump complete'"; then
    log_error "Database dump on Secondary VPS is invalid or empty."
    exit 1
  fi

  if [ -d "$odoo_filestore_path" ]; then
    log_info "Syncing filestore catch-up changes to Secondary VPS..."
    remote_sync -az "$odoo_filestore_path/" "$user@$host:$remote_mirror/"
  fi

  local git_hashes_file="$ODOO_TMP_DIR/git_hashes.txt"
  local git_hashes_json="$ODOO_TMP_DIR/git_hashes.json"
  touch "$git_hashes_file" "$git_hashes_json"
  chmod 644 "$git_hashes_file" "$git_hashes_json"

  local nongit_dirs=()
  while IFS= read -r rel_dir; do
    [ -n "$rel_dir" ] && nongit_dirs+=("$rel_dir")
  done < <(collectGitMetadataAndNonGitDirs "$git_hashes_json" "$git_hashes_file")

  remote_sync -az "$git_hashes_file" "$user@$host:$remote_staging/tmp/git_hashes.txt"
  remote_sync -az "$git_hashes_file" "$user@$host:$remote_staging/git_hashes.txt"
  remote_sync -az "$git_hashes_json" "$user@$host:$remote_staging/tmp/git_hashes.json"
  remote_sync -az "$git_hashes_json" "$user@$host:$remote_staging/git_hashes.json"
  rm -f "$git_hashes_file" "$git_hashes_json"

  log_info "Syncing configuration files to Secondary VPS staging..."
  local files_to_sync=()
  for rel_dir in "${nongit_dirs[@]}"; do
    if [ -d "$PATH_TO_ODOO/$rel_dir" ]; then
      log_info "Syncing bundled directory to Secondary VPS: $rel_dir"
      files_to_sync+=("$PATH_TO_ODOO/$rel_dir")
      files_to_sync+=("$PATH_TO_ODOO/./$rel_dir")
    fi
  done
  [ -d "$PATH_TO_ODOO/.secrets" ] && files_to_sync+=("$PATH_TO_ODOO/.secrets")
  [ -f "$PATH_TO_ODOO/conf/odoo.conf" ] && files_to_sync+=("$PATH_TO_ODOO/conf/odoo.conf")
  [ -f "$PATH_TO_ODOO/.env" ] && files_to_sync+=("$PATH_TO_ODOO/.env")
  [ -f "$PATH_TO_ODOO/requirements.txt" ] && files_to_sync+=("$PATH_TO_ODOO/requirements.txt")
  [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/deploy_release_candidate-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/deploy_release_candidate-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/restore_backupdata-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/restore_backupdata-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME")
  [ -d "$PATH_TO_ODOO/.secrets" ] && files_to_sync+=("$PATH_TO_ODOO/./.secrets")
  [ -f "$PATH_TO_ODOO/conf/odoo.conf" ] && files_to_sync+=("$PATH_TO_ODOO/./conf/odoo.conf")
  [ -f "$PATH_TO_ODOO/.env" ] && files_to_sync+=("$PATH_TO_ODOO/./.env")
  [ -f "$PATH_TO_ODOO/requirements.txt" ] && files_to_sync+=("$PATH_TO_ODOO/./requirements.txt")
  [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/backupdata-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/backupdata-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/backupdata-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/databasecloner-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/databasecloner-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/databasecloner-$SERVICE_NAME")
  [ -f "$PATH_TO_ODOO/scripts/deploy_release_candidate-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/deploy_release_candidate-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/restore_backupdata-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/restore_backupdata-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME.sh" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/snapshot-$SERVICE_NAME.sh")
  [ -f "$PATH_TO_ODOO/scripts/snapshot-$SERVICE_NAME" ] && files_to_sync+=("$PATH_TO_ODOO/./scripts/snapshot-$SERVICE_NAME")

  if [ -n "$SNAPSHOT_CUSTOM_DIRS" ]; then
    IFS=';' read -ra ADDR <<< "$SNAPSHOT_CUSTOM_DIRS"
    for dir in "${ADDR[@]}"; do
      dir=$(echo "$dir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      if [ -n "$dir" ] && [ -e "$dir" ]; then
        files_to_sync+=("$dir")
        if [[ "$dir" == "$PATH_TO_ODOO/"* ]]; then
          files_to_sync+=("$PATH_TO_ODOO/./${dir#$PATH_TO_ODOO/}")
        elif [[ "$dir" == "$ODOO_TMP_DIR/"* ]]; then
          files_to_sync+=("$ODOO_TMP_DIR/./${dir#$ODOO_TMP_DIR/}")
        else
          files_to_sync+=("$(dirname "$dir")/./$(basename "$dir")")
        fi
      fi
    done
  fi

  remote_sync -azR "${files_to_sync[@]}" "$user@$host:$remote_staging/"

  log_info "Preparing manifest.json on Secondary VPS..."
  remote_exec "cat <<'MANIFEST_EOF' > '$remote_staging/manifest.json'
{
    \"odoo_dump\": \"1\",
    \"db_name\": \"$ODOO_DATABASE_NAME_PRD\",
    \"version\": \"$MANIFEST_VERSION\",
    \"version_info\": $MANIFEST_VERSION_INFO,
    \"major_version\": \"$MANIFEST_MAJOR_VERSION\",
    \"sudodevops\": $SUDODEVOPS_JSON,
    \"modules\": {}
}
MANIFEST_EOF"

  log_info "Staging database dump and filestore on Secondary VPS..."
  remote_exec "if [ -f '$remote_staging/tmp/dump.sql' ]; then mv '$remote_staging/tmp/dump.sql' '$remote_staging/dump.sql'; fi"
  remote_exec "if [ -d '$remote_mirror' ] && [ -n \"\$(ls -A '$remote_mirror' 2>/dev/null)\" ]; then rm -rf '$remote_staging/filestore' && (cp -al '$remote_mirror' '$remote_staging/filestore' 2>/dev/null || cp -r '$remote_mirror' '$remote_staging/filestore'); fi"
  remote_exec "rm -rf '$remote_staging/tmp'"

  if ! remote_exec "[ -s '$remote_staging/dump.sql' ] && [ -s '$remote_staging/manifest.json' ]"; then
    log_error "Database dump or manifest.json on Secondary VPS is missing or empty."
    exit 1
  fi

  log_info "Packaging snapshot-$SERVICE_NAME.tar.zst on Secondary VPS (compression level: $compression_level)..."
  # The archive is hashed while it is written; the .sha256 sidecar travels with it
  if ! remote_exec "cd '$remote_staging' && shopt -s dotglob nullglob && set -o pipefail && rm -f snapshot-$SERVICE_NAME.tar.zst.sha256 && tar -cf - --exclude='*.tar.zst' --exclude='*.tar.zst.sha256' * | zstd -vT0 -$compression_level --ultra -c | tee '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' | sha256sum | awk '{print \$1\"  snapshot-$SERVICE_NAME.tar.zst\"}' > '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256'"; then
    log_error "Packaging snapshot-$SERVICE_NAME.tar.zst on Secondary VPS failed."
    exit 1
  fi
  log_info "Snapshot sha256: $(remote_exec "awk 'NR==1{print \$1}' '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256'" 2>/dev/null)"

  log_info "Verifying snapshot archive integrity on Secondary VPS..."
  if ! remote_exec "
    [ -s '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' ] || exit 1
    tar -tf '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' -I zstd | awk '
      /dump\.sql$/ { has_dump=1 }
      /manifest\.json$/ { has_manifest=1 }
      END {
        if (!has_dump || !has_manifest) exit 1
        exit 0
      }
    '
  "; then
    log_error "Snapshot validation on Secondary VPS failed: missing dump.sql or manifest.json in archive, or archive is corrupted."
    exit 1
  fi
  log_success "Snapshot archive verified successfully on Secondary VPS."

  # The disk is at its fullest now (staged files and the archive): record what this snapshot took
  local remote_free_peak="" remote_dump_bytes="" remote_archive_bytes="" remote_peak=""
  read -r remote_free_peak remote_dump_bytes remote_archive_bytes < <(remote_exec "printf '%s %s %s\\n' \"\$(df -PB1 '$remote_base' 2>/dev/null | awk 'NR == 2 {print \$4}')\" \"\$(stat -c %s '$remote_staging/dump.sql' 2>/dev/null || echo 0)\" \"\$(stat -c %s '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' 2>/dev/null || echo 0)\"" 2>/dev/null)
  if [[ "$remote_free_before" =~ ^[0-9]+$ ]] && [[ "$remote_free_peak" =~ ^[0-9]+$ ]] && [ "$remote_free_before" -gt "$remote_free_peak" ]; then
    remote_peak=$((remote_free_before - remote_free_peak))
  fi
  remote_write_stats "$remote_free_before" "$remote_free_peak" "$remote_dump_bytes" "$remote_archive_bytes" "$remote_peak"

  # Clean up uncompressed staged data files on Secondary VPS
  remote_exec "rm -rf '$remote_staging/filestore' '$remote_staging/dump.sql' '$remote_staging/manifest.json'"

  local remote_upload_attempted=false
  local remote_upload_success=false
  local remote_gcs_object=""

  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    remote_upload_attempted=true
    log_info "Uploading snapshot archive from Secondary VPS to Google Drive..."

    local remote_sa_content=""
    if [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ] && [ -f "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      remote_sa_content=$(cat "$GDRIVE_SERVICE_ACCOUNT_KEY")
    elif [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
      remote_sa_content="$GDRIVE_SERVICE_ACCOUNT_KEY"
    fi

    local upload_funcs
    # shellcheck disable=SC2046
    upload_funcs=$(declare -f log log_info log_success log_warn log_error is_gdrive_token_valid get_gdrive_access_token_from_sa resolve_gdrive_access_token cleanup_gdrive_old_snapshots upload_to_gdrive _ss_log $(compgen -A function snap_) $(compgen -A function gds_))

    if remote_exec "bash -s" << REMOTE_EOF
COLOR_RESET='$COLOR_RESET'
COLOR_INFO='$COLOR_INFO'
COLOR_SUCCESS='$COLOR_SUCCESS'
COLOR_WARN='$COLOR_WARN'
COLOR_ERROR='$COLOR_ERROR'
SERVICE_NAME='$SERVICE_NAME'
SNAP_UPLOAD_RESULT='$remote_staging/.drive-upload'
rm -f "\$SNAP_UPLOAD_RESULT"
$upload_funcs
upload_to_gdrive '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$GDRIVE_ACCESS_TOKEN' '$remote_sa_content' '$GDRIVE_FOLDER_ID' '$GDRIVE_CHUNK_SIZE' '$GDRIVE_MAX_BACKUPS' '$SERVICE_NAME'
REMOTE_EOF
    then
      remote_upload_success=true
      log_success "Remote snapshot successfully uploaded to Google Drive from Secondary VPS."
    else
      log_error "Failed to upload snapshot to Google Drive from Secondary VPS."
    fi
  fi

  if [ -n "$GCS_BUCKET_NAME" ]; then
    remote_upload_attempted=true
    log_info "Moving snapshot archive to Google Cloud Storage (gs://$GCS_BUCKET_NAME)..."
    if remote_exec "gcloud storage cp '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' 'gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst'"; then
      local gcs_funcs gcs_rc=0
      gcs_funcs=$(declare -f log log_info log_success log_warn log_error _ss_log gcs_crc32c_field gcs_verify_upload gcs_invalidate_validation)
      remote_exec "bash -s" << REMOTE_GCS_EOF || gcs_rc=$?
COLOR_RESET='$COLOR_RESET'
COLOR_INFO='$COLOR_INFO'
COLOR_SUCCESS='$COLOR_SUCCESS'
COLOR_WARN='$COLOR_WARN'
COLOR_ERROR='$COLOR_ERROR'
$gcs_funcs
gcs_invalidate_validation 'gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst'
gcs_verify_upload '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' 'gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst'
REMOTE_GCS_EOF
      if [ "$gcs_rc" -eq 1 ]; then
        log_error "The copy in gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst is broken. Keeping the archive on the Secondary VPS."
      else
        remote_upload_success=true
        remote_gcs_object="gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst"
        if remote_exec "gcloud storage cp '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256' 'gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst.sha256'"; then
          log_success "Uploaded checksum file gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst.sha256"
        else
          log_error "Could not upload gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst.sha256. The snapshot is uploaded but has no checksum file."
        fi
        log_success "Remote snapshot successfully uploaded to gs://$GCS_BUCKET_NAME/snapshot-$SERVICE_NAME.tar.zst from Secondary VPS."
      fi
    else
      log_error "Failed to upload snapshot to gs://$GCS_BUCKET_NAME from Secondary VPS."
    fi
  fi

  if [ "$remote_upload_attempted" = true ]; then
    if [ "$remote_upload_success" = true ]; then
      # Uploaded: the archive is no longer needed here, unless the validator drills it (moved, no copy)
      if [ "$SNAPSHOT_VALIDATOR_INBOX" = true ] \
         && remote_inbox_handoff move "$remote_staging/snapshot-$SERVICE_NAME.tar.zst" "" "$remote_gcs_object"; then
        log_info "Remote cloud upload succeeded. The archive stays on the Secondary VPS for the validator's drill."
      else
        log_info "Remote cloud upload succeeded. Cleaning up temporary archive on Secondary VPS..."
      fi
      remote_exec "rm -f '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256'"
    else
      log_warn "Remote cloud upload failed. Preserving fallback archive on Secondary VPS at $remote_archives/snapshot-$SERVICE_NAME.tar.zst."
      remote_exec "mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst' && { [ ! -f '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256' ] || mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst.sha256'; }"
      if [ "$SNAPSHOT_VALIDATOR_INBOX" = true ]; then
        remote_inbox_handoff link "$remote_archives/snapshot-$SERVICE_NAME.tar.zst" "$remote_archives/snapshot-$SERVICE_NAME.tar.zst" "$remote_gcs_object" || true
      fi
    fi
  else
    log_info "Storing snapshot archive locally on Secondary VPS..."
    remote_exec "mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst' && { [ ! -f '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256' ] || mv '$remote_staging/snapshot-$SERVICE_NAME.tar.zst.sha256' '$remote_archives/snapshot-$SERVICE_NAME.tar.zst.sha256'; }"
    log_success "Remote snapshot successfully created and stored on Secondary VPS at $remote_archives/snapshot-$SERVICE_NAME.tar.zst."
    if [ "$SNAPSHOT_VALIDATOR_INBOX" = true ]; then
      remote_inbox_handoff link "$remote_archives/snapshot-$SERVICE_NAME.tar.zst" "$remote_archives/snapshot-$SERVICE_NAME.tar.zst" "" || true
    fi
  fi

  log_info "Cleaning staging directory on Secondary VPS..."
  remote_exec "rm -rf '$remote_staging'/*"
  remote_exec "find '$remote_staging' -mindepth 1 -delete"

  # Release queue slot on Secondary VPS
  release_secondary_vps_queue_token
}

function main() {
  LOG_PATH=/var/log/odoo/_utilities/snapshot-$SERVICE_NAME.log

  # Redirect stdout and stderr to tee
  exec > >(tee -a "$LOG_PATH") 2>&1

  # Self-elevate to root if not already
  if [ "$(id -u)" -ne 0 ]; then
      log_info "Elevating permissions to root..."
      # shellcheck disable=SC2093
      exec sudo "$0" "$@" # Re-run the script with sudo
      log_error "Failed to elevate to root. Please run with sudo." # This will only run if exec fails
      exit 1
  fi

  # Prevent multiple snapshot instances from running simultaneously
  LOCK_FILE="/var/run/snapshot-$SERVICE_NAME.lock"
  touch "$LOCK_FILE"
  exec 200<>"$LOCK_FILE"
  if ! flock -n 200; then
    local running_pid
    running_pid=$(head -n 1 "$LOCK_FILE" 2>/dev/null | tr -d '[:space:]')
    [ -z "$running_pid" ] && running_pid="unknown"
    log_warn "Another snapshot instance for $SERVICE_NAME is already running (PID: $running_pid). Exiting."
    exit 0
  fi
  echo "$$" >&200

  # Read queue timeout setting from .env
  SNAPSHOT_QUEUE_TIMEOUT=$(grep "^SNAPSHOT_QUEUE_TIMEOUT=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  if ! [[ "$SNAPSHOT_QUEUE_TIMEOUT" =~ ^[0-9]+$ ]] || [ "$SNAPSHOT_QUEUE_TIMEOUT" -le 0 ]; then
    [ -n "$SNAPSHOT_QUEUE_TIMEOUT" ] && log_warn "Invalid SNAPSHOT_QUEUE_TIMEOUT='$SNAPSHOT_QUEUE_TIMEOUT' in .env. Using default ${DEFAULT_SNAPSHOT_QUEUE_TIMEOUT}s."
    SNAPSHOT_QUEUE_TIMEOUT="$DEFAULT_SNAPSHOT_QUEUE_TIMEOUT"
  fi

  # How often a waiting snapshot checks the queue, and when a holder without heartbeat counts as dead
  SNAPSHOT_QUEUE_POLL_INTERVAL=$(grep "^SNAPSHOT_QUEUE_POLL_INTERVAL=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [[ "$SNAPSHOT_QUEUE_POLL_INTERVAL" =~ ^[0-9]+$ ]] && [ "$SNAPSHOT_QUEUE_POLL_INTERVAL" -gt 0 ] || SNAPSHOT_QUEUE_POLL_INTERVAL=60
  SNAPSHOT_QUEUE_STALE_AFTER=$(grep "^SNAPSHOT_QUEUE_STALE_AFTER=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [[ "$SNAPSHOT_QUEUE_STALE_AFTER" =~ ^[0-9]+$ ]] && [ "$SNAPSHOT_QUEUE_STALE_AFTER" -gt 0 ] || SNAPSHOT_QUEUE_STALE_AFTER=600
  QUEUE_LOCK_POLL_INTERVAL="$SNAPSHOT_QUEUE_POLL_INTERVAL"
  QUEUE_LOCK_STALE_AFTER="$SNAPSHOT_QUEUE_STALE_AFTER"
  # Markers written by older script versions have no heartbeat; treat them like the old code did
  QUEUE_LOCK_LEGACY_STALE_AFTER="$SNAPSHOT_QUEUE_TIMEOUT"

  # Unified Host-Wide Queue Lock (prevents concurrent backup I/O between instances on the same host)
  if ! queue_lock_acquire_local "$SNAPSHOT_QUEUE_NAME" "$SERVICE_NAME" \
      "$SERVICE_NAME (local on $(hostname -s 2>/dev/null || hostname))" "$SNAPSHOT_QUEUE_TIMEOUT"; then
    exit 1
  fi

  # Lower I/O and CPU scheduling priority to avoid starving Odoo and PostgreSQL
  if command -v ionice >/dev/null 2>&1; then
    ionice -c2 -n7 -p $$ 2>/dev/null || true
  fi
  renice -n 19 -p $$ >/dev/null 2>&1 || true

  ODOO_TMP_DIR="$OWNER_HOME/.odoo-tmp/$SERVICE_NAME"
  mkdir -p "$ODOO_TMP_DIR"
  chmod 700 "$OWNER_HOME/.odoo-tmp" "$ODOO_TMP_DIR" 2>/dev/null || true
  chown -R "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$OWNER_HOME/.odoo-tmp" 2>/dev/null || true

  DATA_STAGING_DIR="$ODOO_TMP_DIR/staging_data_$$"
  TAR_FILE_NAME="snapshot-$SERVICE_NAME.tar.zst"
  TAR_FILE_PATH="$ODOO_TMP_DIR/$TAR_FILE_NAME"
  GIT_HASHES_FILE=""
  GIT_HASHES_JSON_FILE=""

  cleanup_temp_files() {
      local exit_code=$?
      if [[ -n "$LOCK_FILE" && -f "$LOCK_FILE" ]]; then
          rm -f "$LOCK_FILE"
      fi
      if [[ -n "$DATA_STAGING_DIR" && -d "$DATA_STAGING_DIR" ]]; then
          rm -rf "$DATA_STAGING_DIR"
      fi
      if [[ -n "$GIT_HASHES_FILE" && -f "$GIT_HASHES_FILE" ]]; then
          rm -f "$GIT_HASHES_FILE"
      fi
      if [[ -n "$GIT_HASHES_JSON_FILE" && -f "$GIT_HASHES_JSON_FILE" ]]; then
          rm -f "$GIT_HASHES_JSON_FILE"
      fi
      if [ $exit_code -ne 0 ]; then
          if [[ -n "$TAR_FILE_PATH" && -f "$TAR_FILE_PATH" ]]; then
              rm -f "$TAR_FILE_PATH"
          fi
          [ -n "$TAR_FILE_PATH" ] && rm -f "$TAR_FILE_PATH.sha256" "$TAR_FILE_PATH.sha256.tmp"
      fi
      queue_lock_release_all
  }
  trap cleanup_temp_files EXIT

  echo "-------------------------------------------------------------------------------"
  echo " DAILY SNAPSHOT FOR $SERVICE_NAME @ $(date +"%A, %d %B %Y %H:%M %Z")"
  echo "-------------------------------------------------------------------------------"

  # enter the production database name this is required to backup the database
  # Robust parsing for DB_NAME
  ODOO_DATABASE_NAME_PRD=$(grep "^DB_NAME=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  if [ -z "$ODOO_DATABASE_NAME_PRD" ]; then
    log_error "Please setup DB_NAME in your .env file!"
    exit 1
  fi

  # ask to replace the existing snapshot file
  # enter "Y" to add question to replace the existing snapshot file
  ASK_TO_REPLACE_EXISTING_SNAPSHOT=$(grep "^ASK_TO_REPLACE_EXISTING_SNAPSHOT=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # Custom directories to backup (semicolon separated)
  SNAPSHOT_CUSTOM_DIRS=$(grep "^SNAPSHOT_CUSTOM_DIRS=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # you can leave it as is to back up to the /tmp directory instead of Google Cloud Storage (GCS)
  GCS_BUCKET_NAME=$(grep "^GCS_BUCKET_NAME=" "$PATH_TO_ODOO/.env" | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')

  # Google Drive upload configuration
  GDRIVE_ACCESS_TOKEN=$(grep "^GDRIVE_ACCESS_TOKEN=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_SERVICE_ACCOUNT_KEY=$(grep "^GDRIVE_SERVICE_ACCOUNT_KEY=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_FOLDER_ID=$(grep "^GDRIVE_FOLDER_ID=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_CHUNK_SIZE=$(grep "^GDRIVE_CHUNK_SIZE=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  GDRIVE_MAX_BACKUPS=$(grep "^GDRIVE_MAX_BACKUPS=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [ -z "$GDRIVE_MAX_BACKUPS" ] && GDRIVE_MAX_BACKUPS="7"

  # The number represents the compression level for Zstandard (zstd)
  SNAPSHOT_COMPRESSION_LEVEL=$(grep "^SNAPSHOT_COMPRESSION_LEVEL=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  if [ -z "$SNAPSHOT_COMPRESSION_LEVEL" ]; then
    SNAPSHOT_COMPRESSION_LEVEL=7
  fi

  if ! [[ "$SNAPSHOT_COMPRESSION_LEVEL" =~ ^[0-9]+$ ]]; then
    log_error "SNAPSHOT_COMPRESSION_LEVEL must be a number!"
    exit 1
  fi

  # Secondary VPS Remote Snapshot Config
  SNAPSHOT_REMOTE_HOST=$(grep "^SNAPSHOT_REMOTE_HOST=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_USER=$(grep "^SNAPSHOT_REMOTE_USER=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_PORT=$(grep "^SNAPSHOT_REMOTE_PORT=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  SNAPSHOT_REMOTE_KEY=$(grep "^SNAPSHOT_REMOTE_KEY=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  # Keep each remote snapshot on the Secondary VPS for the validator's drill (see run_remote_snapshot)
  SNAPSHOT_VALIDATOR_INBOX=$(grep "^SNAPSHOT_VALIDATOR_INBOX=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  VALIDATOR_DISK_RESERVE_GB=$(grep "^VALIDATOR_DISK_RESERVE_GB=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [ "$SNAPSHOT_VALIDATOR_INBOX" = true ] || SNAPSHOT_VALIDATOR_INBOX=false
  # How many snapshots kept on this host (not uploaded) to retain; empty keeps all (see snap_local_retention)
  SNAPSHOT_LOCAL_MAX_BACKUPS=$(grep "^SNAPSHOT_LOCAL_MAX_BACKUPS=" "$PATH_TO_ODOO/.env" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [[ "$VALIDATOR_DISK_RESERVE_GB" =~ ^[0-9]+$ ]] || VALIDATOR_DISK_RESERVE_GB=5
  [ -z "$SNAPSHOT_REMOTE_PORT" ] && SNAPSHOT_REMOTE_PORT="22"

  # Extract Odoo version metadata
  extract_odoo_version_info

  # Measured before the dump, for manifest.json's "sudodevops" block: the validator sizes its disk
  # check from db_size_bytes and picks its PostgreSQL from server_version. Unknown values are null.
  SUDODEVOPS_JSON=$(odoo_sizes_json "${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}" "$ODOO_DATABASE_NAME_PRD" "/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD")
  log_info "Sizes for manifest.json: $SUDODEVOPS_JSON"

  # --- Branch: Remote Secondary VPS Snapshot Mode ---
  if [ -n "$SNAPSHOT_REMOTE_HOST" ]; then
    if [ -z "$SNAPSHOT_REMOTE_USER" ]; then
      log_error "SNAPSHOT_REMOTE_USER is required when SNAPSHOT_REMOTE_HOST is set in .env!"
      exit 1
    fi
    log_info "Executing snapshot in Remote Secondary VPS Mode ($SNAPSHOT_REMOTE_USER@$SNAPSHOT_REMOTE_HOST)..."
    run_remote_snapshot "$SNAPSHOT_REMOTE_HOST" "$SNAPSHOT_REMOTE_USER" "$SNAPSHOT_REMOTE_PORT" "$SNAPSHOT_REMOTE_KEY" "$SNAPSHOT_COMPRESSION_LEVEL"
    echo
    return 0
  fi

  # --- Branch: Local Snapshot Mode (Default) ---
  if ! command -v zstd >/dev/null 2>&1; then
    log_error "zstd is not installed. Please install zstd first."
    echo "For Ubuntu: sudo apt install zstd"
    echo "For CentOS: sudo yum install zstd"
    exit 1
  fi

  if ! command -v curl >/dev/null 2>&1; then
    log_error "curl is not installed. Please install curl first."
    echo "For Ubuntu: sudo apt install curl"
    echo "For CentOS: sudo yum install curl"
    exit 1
  fi

  if ! command -v dd >/dev/null 2>&1; then
    log_error "dd is not installed. Please install coreutils first."
    exit 1
  fi

  # --- Dynamic Odoo Version Extraction & Staging ---
  rm -rf "$DATA_STAGING_DIR"
  mkdir -p "$DATA_STAGING_DIR"

  log_info "Dumping $ODOO_DATABASE_NAME_PRD database to staging dump.sql..."
  if ! run_pg_dump --no-owner "$ODOO_DATABASE_NAME_PRD" > "$DATA_STAGING_DIR/dump.sql"; then
    log_error "pg_dump failed."
    exit 1
  fi

  if [ ! -s "$DATA_STAGING_DIR/dump.sql" ]; then
    log_error "dump.sql is missing or 0 bytes."
    exit 1
  fi
  if ! tail -n 25 "$DATA_STAGING_DIR/dump.sql" | grep -q "PostgreSQL database dump complete"; then
    log_error "dump.sql appears incomplete (missing 'PostgreSQL database dump complete' marker)."
    exit 1
  fi

  log_info "Generating manifest.json for backup bundle (Odoo version: $MANIFEST_VERSION)..."
  cat <<EOF > "$DATA_STAGING_DIR/manifest.json"
{
    "odoo_dump": "1",
    "db_name": "$ODOO_DATABASE_NAME_PRD",
    "version": "$MANIFEST_VERSION",
    "version_info": $MANIFEST_VERSION_INFO,
    "major_version": "$MANIFEST_MAJOR_VERSION",
    "sudodevops": $SUDODEVOPS_JSON,
    "modules": {}
}
EOF

  ODOO_FILESTORE_PATH="/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD"

  ## Collect files directly for tar archive (single-pass zstd compression, no intermediate zip)
  files_dirs_to_tar=()

  # Include database dump and metadata manifest directly
  files_dirs_to_tar+=("-C" "$DATA_STAGING_DIR" "dump.sql" "manifest.json")

  # Include filestore directly if it exists
  if [ -d "$ODOO_FILESTORE_PATH" ] && [ -n "$(ls -A "$ODOO_FILESTORE_PATH" 2>/dev/null)" ]; then
    log_info "Including filestore directly in snapshot archive..."
    files_dirs_to_tar+=("-C" "$(dirname "$ODOO_FILESTORE_PATH")" "--transform=s|^$ODOO_DATABASE_NAME_PRD|filestore|" "$ODOO_DATABASE_NAME_PRD")
  else
    log_warn "Filestore not found or empty at $ODOO_FILESTORE_PATH. Skipping filestore."
  fi

  # Generate Git Hashes (JSON and TXT) and collect non-git directories to bundle
  GIT_HASHES_FILE="$ODOO_TMP_DIR/git_hashes.txt"
  GIT_HASHES_JSON_FILE="$ODOO_TMP_DIR/git_hashes.json"
  touch "$GIT_HASHES_FILE" "$GIT_HASHES_JSON_FILE"
  chmod 644 "$GIT_HASHES_FILE" "$GIT_HASHES_JSON_FILE"

  local nongit_dirs=()
  while IFS= read -r rel_dir; do
    [ -n "$rel_dir" ] && nongit_dirs+=("$rel_dir")
  done < <(collectGitMetadataAndNonGitDirs "$GIT_HASHES_JSON_FILE" "$GIT_HASHES_FILE")

  for rel_dir in "${nongit_dirs[@]}"; do
    if [ -d "$PATH_TO_ODOO/$rel_dir" ]; then
      log_info "Adding bundled directory directly to snapshot archive: $rel_dir"
      files_dirs_to_tar+=("-C" "$PATH_TO_ODOO" "$rel_dir")
    fi
  done

  files_dirs_to_tar+=("-C" "$ODOO_TMP_DIR" "git_hashes.txt" "git_hashes.json")

  # Add configuration files and utility scripts relative to repository root
  local repo_items=(
    ".secrets"
    "conf/odoo.conf"
    ".env"
    "requirements.txt"
    "scripts/backupdata-$SERVICE_NAME.sh"
    "scripts/backupdata-$SERVICE_NAME"
    "scripts/databasecloner-$SERVICE_NAME.sh"
    "scripts/databasecloner-$SERVICE_NAME"
    "scripts/deploy_release_candidate-$SERVICE_NAME.sh"
    "scripts/restore_backupdata-$SERVICE_NAME.sh"
    "scripts/restore_backupdata_manual-$SERVICE_NAME.sh"
    "scripts/snapshot-$SERVICE_NAME.sh"
    "scripts/snapshot-$SERVICE_NAME"
  )

  for item in "${repo_items[@]}"; do
    if [ -e "$PATH_TO_ODOO/$item" ]; then
      files_dirs_to_tar+=("-C" "$PATH_TO_ODOO" "$item")
    fi
  done

  # Add custom directories if defined
  if [ -n "$SNAPSHOT_CUSTOM_DIRS" ]; then
    log_info "Processing custom backup directories..."
    IFS=';' read -ra ADDR <<< "$SNAPSHOT_CUSTOM_DIRS"
    for dir in "${ADDR[@]}"; do
      dir=$(echo "$dir" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      if [ -n "$dir" ] && [ -e "$dir" ]; then
        log_info "Adding custom directory: $dir"
        if [[ "$dir" == "$PATH_TO_ODOO/"* ]]; then
          files_dirs_to_tar+=("-C" "$PATH_TO_ODOO" "${dir#$PATH_TO_ODOO/}")
        else
          files_dirs_to_tar+=("-C" "$(dirname "$dir")" "$(basename "$dir")")
        fi
      fi
    done
  fi

  areYouReallySure "$TAR_FILE_PATH" "$ASK_TO_REPLACE_EXISTING_SNAPSHOT"

  log_info "Backing up the database and its datadir directly to snapshot (single-pass zstd + sha256)..."
  # The archive is hashed while it is written, so a large snapshot is never read twice
  if ! ( set -o pipefail
         tar -cf - "${files_dirs_to_tar[@]}" 2>/dev/null \
           | zstd -T0 -"$SNAPSHOT_COMPRESSION_LEVEL" --ultra -q -c \
           | tee "$TAR_FILE_PATH" \
           | sha256sum ) > "$TAR_FILE_PATH.sha256.tmp"; then
    log_error "tar failed to backup the database and its datadir."
    rm -f "$TAR_FILE_PATH.sha256.tmp"
    rm -rf "$DATA_STAGING_DIR"
    exit 1
  fi
  snap_write_sidecar "$(awk '{print $1}' "$TAR_FILE_PATH.sha256.tmp")" "$TAR_FILE_PATH.sha256" "$TAR_FILE_NAME"
  rm -f "$TAR_FILE_PATH.sha256.tmp"
  log_info "Snapshot sha256: $(snap_sidecar_hash "$TAR_FILE_PATH.sha256")"

  rm -rf "$DATA_STAGING_DIR"

  log_info "Verifying snapshot archive integrity..."
  if [ ! -s "$TAR_FILE_PATH" ]; then
    log_error "Final snapshot file $TAR_FILE_PATH is 0 bytes."
    rm -f "$TAR_FILE_PATH"
    exit 1
  fi

  local need_fs=0
  if [ -d "$ODOO_FILESTORE_PATH" ] && [ -n "$(ls -A "$ODOO_FILESTORE_PATH" 2>/dev/null)" ]; then
    need_fs=1
  fi

  if ! tar -tf "$TAR_FILE_PATH" -I zstd | awk -v need_fs="$need_fs" '
    /dump\.sql$/ { has_dump=1 }
    /manifest\.json$/ { has_manifest=1 }
    /filestore/ { has_fs=1 }
    END {
      if (!has_dump || !has_manifest) exit 1
      if (need_fs && !has_fs) exit 1
      exit 0
    }
  '; then
    log_error "Snapshot validation failed: missing dump.sql, manifest.json, or filestore in $TAR_FILE_PATH, or archive is corrupted."
    rm -f "$TAR_FILE_PATH"
    exit 1
  fi
  log_success "Snapshot archive verified successfully."

  log_info "Changing the ownership of the snapshot file..."
  chown "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$TAR_FILE_PATH" "$TAR_FILE_PATH.sha256"

  local remote_upload_attempted=false
  local remote_upload_success=false

  if [ -n "$GDRIVE_ACCESS_TOKEN" ] || [ -n "$GDRIVE_SERVICE_ACCOUNT_KEY" ]; then
    remote_upload_attempted=true
    log_info "Uploading snapshot file to Google Drive..."
    if upload_to_gdrive "$TAR_FILE_PATH" "$GDRIVE_ACCESS_TOKEN" "$GDRIVE_SERVICE_ACCOUNT_KEY" "$GDRIVE_FOLDER_ID" "$GDRIVE_CHUNK_SIZE" "$GDRIVE_MAX_BACKUPS"; then
      remote_upload_success=true
      log_success "The snapshot File Uploaded Successfully to Google Drive: $TAR_FILE_NAME"
    else
      log_error "Failed to upload snapshot file to Google Drive."
    fi
  fi

  if [ -n "$GCS_BUCKET_NAME" ]; then
    remote_upload_attempted=true
    # Disable parallel composite upload compatibility check to avoid permission errors if not already set.
    if [ "$(sudo -u "$REPOSITORY_OWNER" gcloud config get-value storage/parallel_composite_upload_compatibility_check 2>/dev/null)" != "false" ]; then
      sudo -u "$REPOSITORY_OWNER" gcloud config set storage/parallel_composite_upload_compatibility_check false 2>/dev/null
    fi
    if sudo -u "$REPOSITORY_OWNER" gcloud storage ls "gs://$GCS_BUCKET_NAME" > /dev/null 2>&1; then
      log_info "Uploading the snapshot file to Google Cloud Storage bucket: gs://$GCS_BUCKET_NAME."
      if sudo -u "$REPOSITORY_OWNER" gcloud storage cp "$TAR_FILE_PATH" "gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME"; then
        local gcs_rc=0
        # The object was just replaced: the previous snapshot's validation record no longer applies
        GCS_GCLOUD="sudo -u $REPOSITORY_OWNER gcloud" gcs_invalidate_validation "gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME"
        GCS_GCLOUD="sudo -u $REPOSITORY_OWNER gcloud" gcs_verify_upload "$TAR_FILE_PATH" "gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME" || gcs_rc=$?
        if [ "$gcs_rc" -eq 1 ]; then
          log_error "The copy in gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME is broken. Keeping the local snapshot."
        else
          remote_upload_success=true
          if sudo -u "$REPOSITORY_OWNER" gcloud storage cp "$TAR_FILE_PATH.sha256" "gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME.sha256"; then
            log_success "Uploaded checksum file gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME.sha256"
          else
            log_error "Could not upload gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME.sha256. The snapshot is uploaded but has no checksum file."
          fi
          log_success "The snapshot File Created Successfully named $TAR_FILE_NAME. File Backed up at gs://$GCS_BUCKET_NAME/$TAR_FILE_NAME."
        fi
      else
        log_error "Error can't copy the snapshot file to gs://$GCS_BUCKET_NAME. Exit code: $?"
      fi
    else
      log_error "Error cannot access Google Cloud Storage (GCS). Exit code: $?"
      log_error "Please make sure the GCS_BUCKET_NAME on your .env file is the valid GCS Bucket Name."
    fi
  fi

  if [ "$remote_upload_attempted" = true ]; then
    if [ "$remote_upload_success" = true ]; then
      rm -f "$TAR_FILE_PATH" "$TAR_FILE_PATH.sha256"
    else
      log_warn "Remote upload failed. Preserving snapshot file locally in temporary directory."
      moveSnapshotFileToTempDir "$TAR_FILE_PATH" "$TAR_FILE_NAME"
    fi
  else
    moveSnapshotFileToTempDir "$TAR_FILE_PATH" "$TAR_FILE_NAME"
  fi

  # Snapshots kept on this host: only the newest SNAPSHOT_LOCAL_MAX_BACKUPS (and the newest that passed a drill)
  snap_local_retention "$OWNER_HOME/.odoo-snapshots/$SERVICE_NAME/archives" "$SERVICE_NAME" "$SNAPSHOT_LOCAL_MAX_BACKUPS" "$OWNER_HOME/$TAR_FILE_NAME" || true
  echo
}

main "$@"
