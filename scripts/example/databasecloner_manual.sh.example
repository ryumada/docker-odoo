#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Clones Odoo database using rsync for filestore and native localhost endpoint/PSQL mode. Supports interactive push and automated pull mode.
# Usage: ./scripts/databasecloner_manual.sh [TARGET_DB_NAME] [MODULES] [json]
# Dependencies: sudo, git, docker, pg_dump, psql, rsync, zip, curl

# Detect Repository Owner to run non-root commands as that user
CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_ODOO")

if [ -f "$CURRENT_DIR/lib/odoo_utils.sh" ]; then
    source "$CURRENT_DIR/lib/odoo_utils.sh"
elif [ -f "$CURRENT_DIR/../lib/odoo_utils.sh" ]; then
    source "$CURRENT_DIR/../lib/odoo_utils.sh"
fi

# --- Logging Functions & Colors ---
readonly COLOR_RESET="\033[0m"
readonly COLOR_INFO="\033[0;34m"
readonly COLOR_SUCCESS="\033[0;32m"
readonly COLOR_WARN="\033[1;33m"
readonly COLOR_ERROR="\033[0;31m"
readonly COLOR_CYAN="\033[0;36m"

log() {
  local color="$1"
  local emoji="$2"
  local message="$3"
  if [ "$JSON_MODE" = "true" ]; then
      echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}" >&2
  else
      echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
  fi
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() {
    if [ "$JSON_MODE" = "true" ]; then
        local escaped_msg=$(echo -n "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
        echo "{\"error\": \"$escaped_msg\"}"
    fi
    log "${COLOR_ERROR}" "❌" "$1"
}
log_stage() { log "${COLOR_CYAN}" "📋" "$1"; }

error_handler() {
  local exit_code=$1
  local line_no=$2
  local command_name=$3

  if [ -n "${STDERR_LOG:-}" ]; then
    exec 2>&3
  fi

  log_error "An error occurred on line $line_no."
  log_error "Exit Code: $exit_code"
  log_error "Command: $command_name"

  sleep 0.2

  if [ -f "${STDERR_LOG:-}" ] && [ -s "$STDERR_LOG" ]; then
    log_error "Captured stderr output:"
    while IFS= read -r line; do
      log_error "  $line"
    done < <(tail -n 20 "$STDERR_LOG")
  fi

  exit "$exit_code"
}

STDERR_LOG=$(mktemp)
exec 3>&2
exec 2> >(tee -a "$STDERR_LOG" >&3)

trap 'error_handler $? $LINENO "$BASH_COMMAND"' ERR

cleanup_temp_files() {
    rm -f "/tmp/$ODOO_DB_NAME_ENV.sql" "/tmp/$STG_DB_NAME.sql" "/tmp/dump.sql" "/tmp/db_dump_only_$ODOO_DB_NAME_ENV.zip" 2>/dev/null || true
    if [ -n "${STDERR_LOG:-}" ] && [ -f "$STDERR_LOG" ]; then
        rm -f "$STDERR_LOG"
    fi
    if [ -n "${CURL_OUT:-}" ] && [ -f "$CURL_OUT" ]; then
        rm -f "$CURL_OUT"
    fi
}
trap cleanup_temp_files EXIT

function promptWhichEnvironment() {
  local environment="$1"
  local ODOO_DEPLOYMENT_ENVIRONMENT
  local input_env

  if [ "$environment" == "" ]; then
    while true; do
      printf "Which environment you wish to clone the data to?\r\n" >&3
      printf "[1] Development (dev)\r\n" >&3
      printf "[2] Staging (stg)\r\n" >&3
      printf "[3] Testing (tst)\r\n" >&3
      printf "[4] Other\r\n\r\n" >&3
      printf ">> Enter the number 1 - 4: " >&3
      read -r input_env

      if [[ ! "$input_env" =~ ^[1-9]+$ ]]; then
        log_error "Invalid input. Please enter a number based on the menu above."
        continue
      fi

      case $input_env in
        1) ODOO_DEPLOYMENT_ENVIRONMENT=dev; break ;;
        2) ODOO_DEPLOYMENT_ENVIRONMENT=stg; break ;;
        3) ODOO_DEPLOYMENT_ENVIRONMENT=tst; break ;;
        4) read -rp "Enter the environment name: " ODOO_DEPLOYMENT_ENVIRONMENT; break ;;
        *) log_error "Invalid option" ;;
      esac
    done
  else
    ODOO_DEPLOYMENT_ENVIRONMENT=$environment
  fi

  echo "$ODOO_DEPLOYMENT_ENVIRONMENT"
}

function get_next_prefix() {
  local env_file="$1"
  local current_count
  local next_count

  current_count=$(grep "^DB_PREFIX_COUNT=" "$env_file" | cut -d "=" -f 2 | tr -d '[:space:]')
  if [[ ! "$current_count" =~ ^[0-9]+$ ]]; then
    current_count=-1
  fi
  next_count=$((current_count + 1))
  if [ "$next_count" -gt 999 ]; then
    next_count=0
  fi

  if grep -q "^DB_PREFIX_COUNT=" "$env_file"; then
     sed -i "s/^DB_PREFIX_COUNT=.*/DB_PREFIX_COUNT=$next_count/" "$env_file"
  else
     echo "DB_PREFIX_COUNT=$next_count" >> "$env_file"
  fi

  printf "%03d" "$next_count"
}

function promptClonedDBName() {
  local env_file="$1"
  local use_date_suffix="$2"
  local ODOO_DEPLOYMENT_ENVIRONMENT="$3"
  local ODOO_DB_NAME_ENV
  local DB_PREFIX
  DB_PREFIX=$(get_next_prefix "$env_file")
  local USE_DATE_SUFFIX_INPUT

  case "$use_date_suffix" in
    Y|y)
      ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT-$(date +"%Y%m%d_%H%M")"
      ;;
    prompt)
      while true; do
        read -rp "Do you want to use a date suffix for the new database name? [Y/n]: " USE_DATE_SUFFIX_INPUT

        case "$USE_DATE_SUFFIX_INPUT" in
          Y|y) ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT-$(date +"%Y%m%d_%H%M")"; break ;;
          N|n) ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT"; break ;;
          *) log_error "Invalid option" ;;
        esac
      done
      ;;
    *)
      ODOO_DB_NAME_ENV="$DB_PREFIX-$ODOO_DEPLOYMENT_ENVIRONMENT"
      ;;
  esac

  echo "$ODOO_DB_NAME_ENV"
}

function run_psql() {
  local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
  local db_host=$(grep "^DB_HOST=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
  local has_db=false
  for arg in "$@"; do
    if [[ "$arg" == "-d" || "$arg" == -d* || "$arg" == "--dbname="* || "$arg" == "--dbname" ]]; then
      has_db=true
      break
    fi
  done
  local db_default=()
  if [ "$has_db" = false ]; then
    db_default=(-d postgres)
  fi
  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port=$(grep "^DB_PORT=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    local db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
    local db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
    local docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    local net=$(echo "$docker_net" | cut -d "," -f 1)
    docker run -i --rm --network="$net" -e PGPASSWORD="$db_pass" postgres psql -h "$db_host" -p "$db_port" -U "$db_user" "${db_default[@]}" "$@"
  else
    sudo -u postgres psql "${db_default[@]}" "$@"
  fi
}

function run_pg_dump() {
  local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
  local db_host=$(grep "^DB_HOST=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
  if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
    local db_port=$(grep "^DB_PORT=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    local db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
    local db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
    local docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    [ -z "$db_port" ] && db_port="5432"
    [ -z "$docker_net" ] && docker_net="host"
    local net=$(echo "$docker_net" | cut -d "," -f 1)
    docker run -i --rm --network="$net" -e PGPASSWORD="$db_pass" postgres pg_dump -h "$db_host" -p "$db_port" -U "$db_user" "$@"
  else
    sudo -u postgres pg_dump "$@"
  fi
}

function sanitize_database() {
  local db_name="$1"
  log_info "Neutralizing the database (SMTP, Crons, Webhooks, Payments, and activating Neutralized Banner)..."

  local SANITIZE_SQL
  SANITIZE_SQL=$(cat << 'EOF'
    DO $$
    BEGIN
        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_mail_server' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_mail_server SET active = false';
            EXECUTE 'INSERT INTO ir_mail_server(name, smtp_port, smtp_host, smtp_encryption, active, smtp_authentication)
            VALUES (''neutralization - disable emails'', 1025, ''invalid'', ''none'', true, ''login'')
            ON CONFLICT DO NOTHING';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_cron' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_cron
               SET active = false
             WHERE id NOT IN (
                   SELECT res_id
                     FROM ir_model_data
                    WHERE model = ''ir.cron''
                      AND name = ''autovacuum_job''
                      AND module = ''base''
             )';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_config_parameter' AND column_name = 'key') THEN
            EXECUTE 'INSERT INTO ir_config_parameter (key, value)
            VALUES (''database.is_neutralized'', true)
                ON CONFLICT (key) DO UPDATE SET value = true';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_act_server' AND column_name = 'webhook_url') THEN
            EXECUTE 'UPDATE ir_act_server SET webhook_url = ''neutralization - disable webhook'' WHERE state = ''webhook''';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'mail_template' AND column_name = 'mail_server_id') THEN
            EXECUTE 'UPDATE mail_template SET mail_server_id = NULL';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'fetchmail_server' AND column_name = 'active') THEN
            EXECUTE 'UPDATE fetchmail_server SET active = false';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_config_parameter' AND column_name = 'key') THEN
            EXECUTE 'DELETE FROM ir_config_parameter WHERE key IN (''mail.web_push_vapid_private_key'', ''mail.web_push_vapid_public_key'', ''mail.sfu_server_key'')';
        END IF;

        IF EXISTS (SELECT FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'mail_push') THEN
            EXECUTE 'TRUNCATE mail_push CASCADE';
        END IF;

        IF EXISTS (SELECT FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'mail_push_device') THEN
            EXECUTE 'DELETE FROM mail_push_device';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'ir_ui_view' AND column_name = 'active') THEN
            EXECUTE 'UPDATE ir_ui_view SET active = true WHERE key = ''web.neutralize_banner''';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'payment_provider' AND column_name = 'state') THEN
            EXECUTE 'UPDATE payment_provider SET state = ''disabled'' WHERE state NOT IN (''test'', ''disabled'')';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'auth_oauth_provider' AND column_name = 'enabled') THEN
            EXECUTE 'UPDATE auth_oauth_provider SET enabled = false';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'res_users_settings' AND column_name = 'google_calendar_rtoken') THEN
            EXECUTE 'UPDATE res_users_settings SET google_calendar_rtoken = NULL, google_calendar_token = NULL, google_synchronization_stopped = True';
        END IF;

        IF EXISTS (SELECT FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'iap_account' AND column_name = 'account_token') THEN
            EXECUTE 'UPDATE iap_account SET account_token = REGEXP_REPLACE(account_token, ''(\+.*)?$'', ''+disabled'') WHERE LENGTH(account_token) <= 33';
            EXECUTE 'UPDATE iap_account SET account_token = ''dummy_value+disabled'' WHERE LENGTH(account_token) > 33 AND account_token NOT LIKE ''%+disabled''';
        END IF;
    END $$;
EOF
)

  if run_psql -d "$db_name" -c "$SANITIZE_SQL" > /dev/null 2>&1; then
    log_success "Database successfully neutralized."
  else
    log_warn "Warning: Failed to sanitize database completely (SQL command failed)."
  fi
}

function run_automated_pull_mode() {
    TARGET_DB=$1
    MODULES_TO_UPDATE=$2

    STG_PATH_TO_ODOO=$PATH_TO_ODOO
    SERVICE_NAME_PRD=${SERVICE_NAME%-*}

    if [ "$SERVICE_NAME" = "$SERVICE_NAME_PRD" ]; then
        if [ "$JSON_MODE" = "true" ]; then
            echo "{\"error\": \"Cannot clone production database onto itself ($SERVICE_NAME).\"}"
        fi
        log_error "Cannot clone production database onto itself ($SERVICE_NAME)."
        exit 1
    fi

    STG_ENV_FILE="$STG_PATH_TO_ODOO/.env"
    if [ ! -f "$STG_ENV_FILE" ]; then
        if [ "$JSON_MODE" = "true" ]; then
            echo "{\"error\": \"Target .env file not found at $STG_ENV_FILE\"}"
        fi
        log_error "Target .env file not found at: $STG_ENV_FILE"
        exit 1
    fi

    if [ -n "$TARGET_DB" ]; then
        STG_DB_NAME="$TARGET_DB"
    else
        STG_DB_NAME_FROM_ENV=$(grep "^DB_NAME=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        STG_DB_NAME="$STG_DB_NAME_FROM_ENV"
        if [ -z "$STG_DB_NAME" ]; then
            STG_DB_NAME="$(get_next_prefix "$STG_ENV_FILE")-$SERVICE_NAME-$(date +"%Y%m%d-%H%M%S")"
        fi
    fi

    PRD_PATH_TO_ODOO="$STG_PATH_TO_ODOO/../$SERVICE_NAME_PRD"
    PRD_ENV_FILE="$PRD_PATH_TO_ODOO/.env"
    if [ ! -f "$PRD_ENV_FILE" ]; then
        if [ "$JSON_MODE" = "true" ]; then
            echo "{\"error\": \"Production .env file not found at $PRD_ENV_FILE\"}"
        fi
        log_error "Production .env file not found at: $PRD_ENV_FILE"
        exit 1
    fi

    PRD_DB_NAME=$(grep "^DB_NAME=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    if [ -z "$PRD_DB_NAME" ]; then
        if [ "$JSON_MODE" = "true" ]; then
            echo "{\"error\": \"DB_NAME not set in production .env ($PRD_ENV_FILE).\"}"
        fi
        log_error "DB_NAME not set in production .env ($PRD_ENV_FILE)."
        exit 1
    fi

    log_stage "[1/3] Dumping Production Database ($PRD_DB_NAME)..."
    ODOO_FILESTORE_PATH_PRD="/var/lib/odoo/$SERVICE_NAME_PRD/filestore/$PRD_DB_NAME"
    ODOO_FILESTORE_PATH_ENV="/var/lib/odoo/$SERVICE_NAME/filestore/$STG_DB_NAME"

    PSQL_ENV_FILE="$PRD_ENV_FILE" run_pg_dump --no-owner -d "$PRD_DB_NAME" > "/tmp/$STG_DB_NAME.sql"
    export PSQL_ENV_FILE="$STG_ENV_FILE"

    log_stage "[2/3] Restoring Filestore and Database to $STG_DB_NAME..."
    if [ -d "$ODOO_FILESTORE_PATH_ENV" ]; then
        log_warn "Removing old filestore: $ODOO_FILESTORE_PATH_ENV"
        rm -rf "$ODOO_FILESTORE_PATH_ENV"
    fi
    mkdir -p "$ODOO_FILESTORE_PATH_ENV"
    rsync -a "$ODOO_FILESTORE_PATH_PRD/" "$ODOO_FILESTORE_PATH_ENV"
    chown -R odoo: "$ODOO_FILESTORE_PATH_ENV"

    DB_USER=$(grep "^ACTIVE_DB_USER=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    [ -z "$DB_USER" ] && DB_USER=$(cat "$(dirname "$STG_ENV_FILE")/.secrets/db_user" 2>/dev/null || echo "odoo")

    log_info "Dropping old database $STG_DB_NAME (if exists)..."
    run_psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$STG_DB_NAME' AND pid <> pg_backend_pid();" > /dev/null 2>&1 || true
    run_psql -d postgres -c "DROP DATABASE IF EXISTS \"$STG_DB_NAME\"" >/dev/null

    log_info "Creating database $STG_DB_NAME owned by $DB_USER..."
    run_psql -d postgres -c "CREATE DATABASE \"$STG_DB_NAME\" OWNER \"$DB_USER\"" >/dev/null

    log_info "Restoring SQL dump..."
    run_psql -d "$STG_DB_NAME" < "/tmp/$STG_DB_NAME.sql" >/dev/null

    NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' | tr '[:upper:]' '[:lower:]' || true)
    [ -z "$NEUTRALIZE_DB" ] && NEUTRALIZE_DB="true"

    if [ "$NEUTRALIZE_DB" = "true" ]; then
        sanitize_database "$STG_DB_NAME"
    fi

    trigger_registry_reload "$STG_DB_NAME" "$STG_PATH_TO_ODOO"

    if grep -q "^DB_NAME=" "$STG_ENV_FILE"; then
        sed -i "s/^DB_NAME=.*/DB_NAME=$STG_DB_NAME/" "$STG_ENV_FILE"
    else
        echo "DB_NAME=$STG_DB_NAME" >> "$STG_ENV_FILE"
    fi

    log_stage "[3/3] Restarting Odoo Container..."
    cd "$STG_PATH_TO_ODOO"
    if [ "$JSON_MODE" = "true" ]; then
        docker compose restart odoo >&2 || true
    else
        docker compose restart odoo || true
    fi

    MODULE_UPDATE_ERROR=false
    if [ -n "$MODULES_TO_UPDATE" ]; then
        log_info "Updating Odoo modules: $MODULES_TO_UPDATE..."
        sleep 10
        TEMP_UPDATE_LOG=$(mktemp)
        if [ "$JSON_MODE" = "true" ]; then
            docker compose exec odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG" >&2
            if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
        else
            docker compose exec odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG"
            if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
        fi
        rm -f "$TEMP_UPDATE_LOG"
    fi

    if [ "$JSON_MODE" = "true" ]; then
        echo "{"
        echo "  \"database_name\": \"$STG_DB_NAME\","
        echo "  \"source_database\": \"$PRD_DB_NAME\""
        if [ -n "$MODULES_TO_UPDATE" ]; then
            echo "  , \"modules_to_upgrade\": [ \"$MODULES_TO_UPDATE\" ]"
        fi
        if [ "$MODULE_UPDATE_ERROR" = "true" ]; then
            echo "  , \"error\": true"
        fi
        echo "}"
    fi

    log_success "Database clone completed successfully!"
}

function run_interactive_push_mode() {
    ODOO_DATABASE_NAME_PRD=$(grep "^DB_NAME=" "$PATH_TO_ODOO/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    if [ -z "$ODOO_DATABASE_NAME_PRD" ]; then
        read -rp "Enter the database name: " ODOO_DATABASE_NAME_PRD
    fi

    CLONED_ENV=$(grep "^CLONED_ENV=" "$PATH_TO_ODOO/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    USE_DATE_SUFFIX=$(grep "^USE_DATE_SUFFIX=" "$PATH_TO_ODOO/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)

    ODOO_DEPLOYMENT_ENVIRONMENT=$(promptWhichEnvironment "$CLONED_ENV")
    PATH_TO_ODOO_ENV="$PATH_TO_ODOO/../$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT"

    if [ ! -d "$PATH_TO_ODOO_ENV" ]; then
        log_error "The deployment environment $SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT does not exist"
        exit 1
    fi

    BACKUP_RESTORE_METHOD=$(grep "^BACKUP_RESTORE_METHOD=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    if [ -z "$BACKUP_RESTORE_METHOD" ]; then
        BACKUP_RESTORE_METHOD="manual"
    fi

    DEST_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    DEST_PORT=$(grep "^PORT=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    if [ "$BACKUP_RESTORE_METHOD" != "manual" ]; then
        if [ -z "$DEST_ADMIN_PASSWD" ] || [ -z "$DEST_PORT" ]; then
            log_error "ADMIN_PASSWD and/or PORT not set in destination .env file. Cannot proceed with endpoint cloning."
            exit 1
        fi
    fi

    ODOO_DB_NAME_ENV=$(promptClonedDBName "$PATH_TO_ODOO/.env" "$USE_DATE_SUFFIX" "$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT")

    ODOO_FILESTORE_PATH_PRD="/var/lib/odoo/$SERVICE_NAME/filestore/$ODOO_DATABASE_NAME_PRD"
    ODOO_FILESTORE_PATH_ENV="/var/lib/odoo/$SERVICE_NAME-$ODOO_DEPLOYMENT_ENVIRONMENT/filestore/$ODOO_DB_NAME_ENV"

    log_info "Change Directory to $PATH_TO_ODOO"
    cd "$PATH_TO_ODOO" || { log_error "Can't change directory to $PATH_TO_ODOO"; exit 1; }

    log_info "Start cloning database from $ODOO_DATABASE_NAME_PRD to $ODOO_DB_NAME_ENV"
    log_info "Dump $ODOO_DATABASE_NAME_PRD"
    run_pg_dump --no-owner -d "$ODOO_DATABASE_NAME_PRD" > "/tmp/$ODOO_DB_NAME_ENV.sql"

    export PSQL_ENV_FILE="$PATH_TO_ODOO_ENV/.env"

    if [ -d "$ODOO_FILESTORE_PATH_ENV" ]; then
        log_warn "Remove the old filestore of $ODOO_DB_NAME_ENV"
        rm -rf "$ODOO_FILESTORE_PATH_ENV"
    fi

    log_info "Copy the filestore to the $ODOO_DEPLOYMENT_ENVIRONMENT environment"
    mkdir "$ODOO_FILESTORE_PATH_ENV" > /dev/null 2>&1 || { log_warn "Error creating $ODOO_FILESTORE_PATH_ENV. Maybe the directory exists."; }
    rsync -a "$ODOO_FILESTORE_PATH_PRD/" "$ODOO_FILESTORE_PATH_ENV"

    log_info "Change owner of $ODOO_FILESTORE_PATH_ENV to odoo"
    chown -R odoo: "$ODOO_FILESTORE_PATH_ENV"

    if [ "$ODOO_DB_NAME_ENV" == "$ODOO_DATABASE_NAME_PRD-$ODOO_DEPLOYMENT_ENVIRONMENT" ]; then
        log_info "Stop the $ODOO_DEPLOYMENT_ENVIRONMENT environment"
        docker compose -f "$PATH_TO_ODOO_ENV/docker-compose.yml" stop > /dev/null 2>&1 || { log_error "Error stopping $ODOO_DEPLOYMENT_ENVIRONMENT"; exit 1; }

        log_warn "Drop the old database $ODOO_DB_NAME_ENV"
        run_psql -d postgres -c "DROP DATABASE IF EXISTS \"$ODOO_DB_NAME_ENV\" WITH (FORCE)" >/dev/null
    fi

    NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    if [ -z "$NEUTRALIZE_DB" ]; then
        NEUTRALIZE_DB="true"
    fi

    if [ "$BACKUP_RESTORE_METHOD" = "manual" ]; then
        ODOO_VERSION=$(grep "^ODOO_VERSION=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        ODOO_VERSION_NUM=${ODOO_VERSION%%.*}
        if [[ ! "$ODOO_VERSION_NUM" =~ ^[0-9]+$ ]]; then
          if [[ "$ODOO_VERSION" == "latest" ]]; then
            ODOO_VERSION_NUM=18
          else
            ODOO_VERSION_NUM=16
          fi
        fi
        log_info "Detected destination Odoo Version: ${ODOO_VERSION:-16} (Numeric: $ODOO_VERSION_NUM)"

        DB_USER=$(cat "$(dirname "$PATH_TO_ODOO_ENV/.env")/.secrets/db_user" 2>/dev/null || echo "odoo")

        log_info "Dropping old database $ODOO_DB_NAME_ENV (with force)"
        run_psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$ODOO_DB_NAME_ENV' AND pid <> pg_backend_pid();" > /dev/null 2>&1 || true
        run_psql -d postgres -c "DROP DATABASE IF EXISTS \"$ODOO_DB_NAME_ENV\"" >/dev/null 2>&3
        printf "\r\n"

        log_info "Creating new database $ODOO_DB_NAME_ENV with owner $DB_USER"
        run_psql -d postgres -c "CREATE DATABASE \"$ODOO_DB_NAME_ENV\" OWNER \"$DB_USER\"" >/dev/null 2>&3
        printf "\r\n"

        log_info "Restoring database from SQL dump via psql..."
        run_psql -d "$ODOO_DB_NAME_ENV" < "/tmp/$ODOO_DB_NAME_ENV.sql" >/dev/null 2>&3
        printf "\r\n"

        log_success "Database restored successfully via psql."

        log_info "Altering database object ownership..."
        local POSTGRES_USER_DEV="$DB_USER"
        run_psql -d "$ODOO_DB_NAME_ENV" -c "
          DO \$\$
          DECLARE rec RECORD;
          BEGIN
              FOR rec IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') LOOP
                  EXECUTE 'ALTER TABLE ' || quote_ident(rec.tablename) || ' OWNER TO \"${POSTGRES_USER_DEV}\"';
              END LOOP;
          END \$\$;
          DO \$\$
          DECLARE rec RECORD;
          BEGIN
              FOR rec IN (SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public') LOOP
                  EXECUTE 'ALTER SEQUENCE ' || quote_ident(rec.sequence_name) || ' OWNER TO \"${POSTGRES_USER_DEV}\"';
              END LOOP;
          END \$\$;
          DO \$\$
          DECLARE rec RECORD;
          BEGIN
              FOR rec IN (SELECT table_name FROM information_schema.views WHERE table_schema = 'public') LOOP
                  EXECUTE 'ALTER VIEW ' || quote_ident(rec.table_name) || ' OWNER TO \"${POSTGRES_USER_DEV}\"';
              END LOOP;
          END \$\$;
          DO \$\$
          DECLARE rec RECORD;
          BEGIN
              FOR rec IN (SELECT matviewname FROM pg_matviews WHERE schemaname = 'public') LOOP
                  EXECUTE 'ALTER MATERIALIZED VIEW ' || quote_ident(rec.matviewname) || ' OWNER TO \"${POSTGRES_USER_DEV}\"';
              END LOOP;
          END \$\$;
        "

        if [ "$NEUTRALIZE_DB" = "true" ]; then
            sanitize_database "$ODOO_DB_NAME_ENV"
        fi
    else
        log_info "Ensuring destination environment is running to receive endpoint restore command..."
        docker compose -f "$PATH_TO_ODOO_ENV/docker-compose.yml" up -d > /dev/null 2>&1 || true

        log_info "Preparing db_dump_only.zip archive containing dump.sql for destination endpoint import..."
        rm -f "/tmp/dump.sql" "/tmp/db_dump_only_$ODOO_DB_NAME_ENV.zip"
        mv "/tmp/$ODOO_DB_NAME_ENV.sql" "/tmp/dump.sql"
        (cd /tmp && zip -q "db_dump_only_$ODOO_DB_NAME_ENV.zip" dump.sql)
        rm -f "/tmp/dump.sql"

        ODOO_VERSION=$(grep "^ODOO_VERSION=" "$PATH_TO_ODOO_ENV/.env" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        ODOO_VERSION_NUM=${ODOO_VERSION%%.*}
        if [[ ! "$ODOO_VERSION_NUM" =~ ^[0-9]+$ ]]; then
          if [[ "$ODOO_VERSION" == "latest" ]]; then
            ODOO_VERSION_NUM=18
          else
            ODOO_VERSION_NUM=16
          fi
        fi
        log_info "Detected destination Odoo Version: ${ODOO_VERSION:-16} (Numeric: $ODOO_VERSION_NUM)"

        log_info "Restoring database schema/data via direct localhost endpoint..."
        if [ "$ODOO_VERSION_NUM" -ge 16 ]; then
          response=$(curl -s -X POST \
            -F "master_pwd=$DEST_ADMIN_PASSWD" \
            -F "name=$ODOO_DB_NAME_ENV" \
            -F "backup_file=@/tmp/db_dump_only_$ODOO_DB_NAME_ENV.zip" \
            -F "copy=true" \
            -F "neutralize_database=$NEUTRALIZE_DB" \
            "http://localhost:$DEST_PORT/web/database/restore")
        else
          response=$(curl -s -X POST \
            -F "master_pwd=$DEST_ADMIN_PASSWD" \
            -F "name=$ODOO_DB_NAME_ENV" \
            -F "backup_file=@/tmp/db_dump_only_$ODOO_DB_NAME_ENV.zip" \
            -F "copy=true" \
            "http://localhost:$DEST_PORT/web/database/restore")
        fi

        response_lower="${response,,}"
        if [[ "$response_lower" == *"redirecting"* ]] && [[ "$response_lower" == *"/web/database/manager"* ]]; then
          log_success "Database clone command completed successfully."
        elif [[ "$response_lower" == *"error"* ]] || \
             [[ "$response_lower" == *"incorrect master password"* ]] || \
             [ -z "$response" ]; then
          log_error "Failed to clone database via endpoint. Response: ${response:-'Empty response'}"
          exit 1
        else
          log_success "Database clone command completed."
        fi

        if [ "$NEUTRALIZE_DB" = "true" ] && [ "$ODOO_VERSION_NUM" -lt 16 ]; then
          log_info "Destination Odoo version < 16 detected. Performing manual SQL database neutralization fallback..."
          sanitize_database "$ODOO_DB_NAME_ENV"
        fi
    fi

    trigger_registry_reload "$ODOO_DB_NAME_ENV" "$PATH_TO_ODOO_ENV"

    log_info "Restart the $ODOO_DEPLOYMENT_ENVIRONMENT environment"
    docker compose -f "$PATH_TO_ODOO_ENV/docker-compose.yml" restart > /dev/null 2>&1 || { log_error "Error restarting $ODOO_DEPLOYMENT_ENVIRONMENT"; exit 1; }

    log_success "Finish cloning database $ODOO_DB_NAME_ENV from $ODOO_DATABASE_NAME_PRD"
}

main() {
    display_usage() {
        echo -e "${COLOR_INFO}Usage:${COLOR_RESET} sudo $0 [TARGET_DB_NAME] [MODULES] [json]"
        echo -e "       $0 -h | --help"
        echo ""
        echo -e "${COLOR_CYAN}Modes:${COLOR_RESET}"
        echo -e "  ${COLOR_SUCCESS}Automated Pull Mode${COLOR_RESET} : Pass arguments (e.g. TARGET_DB_NAME) or 'json' to pull & clone production database to this instance."
        echo -e "  ${COLOR_SUCCESS}Interactive Push Mode${COLOR_RESET} : Run without arguments to interactively choose a target environment to clone data to."
        echo ""
        echo -e "${COLOR_CYAN}Arguments:${COLOR_RESET}"
        echo -e "  ${COLOR_SUCCESS}1. TARGET_DB_NAME${COLOR_RESET}  : (Optional) Target database name to clone into."
        echo -e "  ${COLOR_SUCCESS}2. MODULES${COLOR_RESET}         : (Optional) Comma-separated list of modules to upgrade after clone (e.g., 'sale,stock')."
        echo -e "  ${COLOR_SUCCESS}3. json${COLOR_RESET}            : (Optional) Enable JSON machine output for integration."
        echo ""
    }

    JSON_MODE="false"
    ARGS=()
    for arg in "$@"; do
        if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
            display_usage
            exit 0
        elif [[ "$arg" == "json" ]]; then
            JSON_MODE="true"
        else
            ARGS+=("$arg")
        fi
    done
    set -- "${ARGS[@]}"

    if [ "$(id -u)" -ne 0 ]; then
        log_info "Elevating permissions to root..."
        # shellcheck disable=SC2093
        exec sudo "$0" "$@"
        log_error "Failed to elevate to root. Please run with sudo."
        exit 1
    fi

    if [ "$#" -gt 0 ] || [ "$JSON_MODE" = "true" ]; then
        run_automated_pull_mode "$@"
    else
        run_interactive_push_mode
    fi
}

main "$@"
