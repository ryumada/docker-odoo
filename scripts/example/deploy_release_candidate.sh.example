#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Deploys release candidates (standard).
# Usage: ./scripts/deploy_release_candidate.sh <REPO_NAME> <BRANCH> <RENEW_DB> [MODULES]
# Dependencies: git, docker, curl, sudo, rsync, ssh

# Detect Repository Owner to run non-root commands as that user
CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_ODOO=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel)
SERVICE_NAME=$(basename "$PATH_TO_ODOO")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_ODOO")

if [ -f "$CURRENT_DIR/lib/odoo_utils.sh" ]; then
    source "$CURRENT_DIR/lib/odoo_utils.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/odoo_utils.sh" ]; then
    source "$PATH_TO_ODOO/scripts/lib/odoo_utils.sh"
fi

if [ -f "$CURRENT_DIR/lib/ssh_utils.sh" ]; then
    source "$CURRENT_DIR/lib/ssh_utils.sh"
elif [ -f "$PATH_TO_ODOO/scripts/lib/ssh_utils.sh" ]; then
    source "$PATH_TO_ODOO/scripts/lib/ssh_utils.sh"
fi

# Configuration
ENV_FILE=".env"
UPDATE_SCRIPT="./scripts/update-env-file.sh"
MAX_BACKUPS=3

# --- Logging Functions & Colors ---
# Define colors for log messages
readonly COLOR_RESET="\033[0m"
readonly COLOR_INFO="\033[0;34m"
readonly COLOR_SUCCESS="\033[0;32m"
readonly COLOR_WARN="\033[1;33m"
readonly COLOR_ERROR="\033[0;31m"
readonly COLOR_CYAN="\033[0;36m"

# Function to log messages with a specific color and emoji
log() {
    local color="$1"
    local emoji="$2"
    local message="$3"
    if [ "$JSON_MODE" = "true" ]; then
        echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}" >&2
    else
        echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
    fi
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() {
    if [ "$JSON_MODE" = "true" ]; then
        # Escape backslashes and double quotes for JSON safety
        local escaped_msg=$(echo -n "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n' | sed 's/\\n$//')
        echo "{\"error\": \"$escaped_msg\"}"
    fi
    log "${COLOR_ERROR}" "❌" "$1"
}
log_stage() { log "${COLOR_CYAN}" "📋" "$1"; }

error_handler() {
  local exit_code=$1
  local line_no=$2
  local command_name=$3

  # Restore stderr to the original descriptor to stop logging to the temp file
  if [ -n "${STDERR_LOG:-}" ]; then
    exec 2>&3
  fi

  log_error "An error occurred on line $line_no."
  log_error "Exit Code: $exit_code"
  log_error "Command: $command_name"

  # Allow tee to finish flushing
  sleep 0.2

  if [ -f "${STDERR_LOG:-}" ] && [ -s "$STDERR_LOG" ]; then
    log_error "Captured stderr output:"
    while IFS= read -r line; do
      log_error "  $line"
    done < <(tail -n 20 "$STDERR_LOG")
  fi

  exit "$exit_code"
}

# Save original stderr to file descriptor 3 and redirect to temp file & descriptor 3
STDERR_LOG=$(mktemp)
exec 3>&2
exec 2> >(tee -a "$STDERR_LOG" >&3)

trap 'error_handler $? $LINENO "$BASH_COMMAND"' ERR

# --- Centralized Cleanup Hook ---
cleanup_temp_files() {
    if [ -n "$TEMP_BACKUP_FILE" ] && [ -f "$TEMP_BACKUP_FILE" ]; then
        rm -f "$TEMP_BACKUP_FILE"
    fi
    rm -f "/tmp/backupdata-$SERVICE_NAME.zip" 2>/dev/null || true
    # Delete temp stderr log
    if [ -n "${STDERR_LOG:-}" ] && [ -f "$STDERR_LOG" ]; then
        rm -f "$STDERR_LOG"
    fi
}
trap cleanup_temp_files EXIT
# ------------------------------------

function get_next_prefix() {
    local env_file="$1"
    local current_count
    local next_count

    # Read existing count
    current_count=$(grep "^DB_PREFIX_COUNT=" "$env_file" | cut -d "=" -f 2 | tr -d '[:space:]')

    # Initialize if empty or not a number
    if [[ ! "$current_count" =~ ^[0-9]+$ ]]; then
        current_count=-1
    fi

    # Increment
    next_count=$((current_count + 1))

    # Reset if > 999
    if [ "$next_count" -gt 999 ]; then
        next_count=0
    fi

    # Update .env file
    if grep -q "^DB_PREFIX_COUNT=" "$env_file"; then
        sed -i "s/^DB_PREFIX_COUNT=.*/DB_PREFIX_COUNT=$next_count/" "$env_file"
    else
        echo "DB_PREFIX_COUNT=$next_count" >> "$env_file"
    fi

    # Output formatted with leading zeros
    printf "%03d" "$next_count"
}

function run_psql() {
    local env_file="${PSQL_ENV_FILE:-$PATH_TO_ODOO/.env}"
    local db_host=$(grep "^DB_HOST=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
    local has_db=false
    local has_user=false
    local prev=""
    for arg in "$@"; do
        if [[ "$arg" == "-d" || "$arg" == -d* || "$arg" == "--dbname="* || "$arg" == "--dbname" ]]; then
            has_db=true
        fi
        if [[ "$arg" == "-U" || "$arg" == -U* || "$arg" == "--username="* || "$arg" == "--username" ]]; then
            has_user=true
        fi
    done
    local db_default=()
    if [ "$has_db" = false ]; then
        db_default=(-d postgres)
    fi
    if [ -n "$db_host" ] && [ "$db_host" != "localhost" ]; then
        local db_port=$(grep "^DB_PORT=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        local db_user=""
        if [ "$has_user" = false ]; then
            db_user=$(grep "^ACTIVE_DB_USER=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
            [ -z "$db_user" ] && db_user=$(cat "$(dirname "$env_file")/.secrets/db_user" 2>/dev/null || true)
        fi
        local db_pass=$(cat "$(dirname "$env_file")/.secrets/db_password" 2>/dev/null || true)
        local docker_net=$(grep "^DOCKER_NETWORK_MODE=" "$env_file" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' || true)
        [ -z "$db_port" ] && db_port="5432"
        [ -z "$docker_net" ] && docker_net="host"
        local net=$(echo "$docker_net" | cut -d "," -f 1)
        local user_arg=()
        [ -n "$db_user" ] && user_arg=(-U "$db_user")
        docker run -i --rm --network="$net" -e PGPASSWORD="$db_pass" postgres psql -h "$db_host" -p "$db_port" "${user_arg[@]}" "${db_default[@]}" "$@"
    else
        local user_to_run="postgres"
        local filtered_args=()
        local skip_next=false
        for ((i=1; i<=$#; i++)); do
            if [ "$skip_next" = true ]; then
                skip_next=false
                continue
            fi
            local curr="${!i}"
            if [[ "$curr" == "-U" ]]; then
                local next_idx=$((i + 1))
                user_to_run="${!next_idx}"
                skip_next=true
            elif [[ "$curr" == -U* ]]; then
                user_to_run="${curr#-U}"
            elif [[ "$curr" == "--username="* ]]; then
                user_to_run="${curr#--username=}"
            else
                filtered_args+=("$curr")
            fi
        done
        sudo -u "$user_to_run" psql "${db_default[@]}" "${filtered_args[@]}"
    fi
}

function fail_with_json() {
    local message="$1"
    log_error "$message"
    exit 1
}

function checkOdooEndpoint() {
    local port="$1"
    log_info "Checking if Odoo endpoint is accessible on port $port..."

    if curl --output /dev/null --silent --head --fail "http://localhost:$port"; then
        log_success "Odoo endpoint is accessible on port $port."
        return 0
    else
        log_warn "Odoo endpoint is NOT accessible at http://localhost:$port. Retrying with longer timeout..."
        if curl --output /dev/null --silent --head --fail --connect-timeout 10 "http://localhost:$port"; then
            log_success "Odoo endpoint is accessible on port $port after retry."
            return 0
        else
            log_error "Odoo endpoint is NOT accessible at http://localhost:$port. Please check if the service is running."
            exit 1
        fi
    fi
}
# ------------------------------------

# --- JSON Mode Early Detection ---
for arg in "$@"; do
    if [[ "$arg" == "json" ]]; then
        JSON_MODE="true"
        break
    fi
done

# Self-elevate to root if not already
if [ "$(id -u)" -ne 0 ]; then
    log_info "Elevating permissions to root..."
    # shellcheck disable=SC2093
    exec sudo "$0" "$@" # Re-run the script with sudo
    log_error "Failed to elevate to root. Please run with sudo." # This will only run if exec fails
    exit 1
fi

# Filter 'json' from arguments
ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "json" ]]; then
        JSON_MODE="true"
    else
        ARGS+=("$arg")
    fi
done
set -- "${ARGS[@]}"

# --- Usage / Help Function ---
display_usage() {
    echo -e "${COLOR_INFO}Usage:${COLOR_RESET} sudo $0 <REPO_NAME> <BRANCH> <RENEW_DB> [DB_NAME] [MODULES]"
    echo -e "       sudo $0 --list-db"
    echo ""
    echo -e "${COLOR_CYAN}Arguments:${COLOR_RESET}"
    echo -e "  ${COLOR_SUCCESS}1. REPO_NAME${COLOR_RESET}       : The directory name of the git repository (inside stg/git/)."
    echo -e "  ${COLOR_SUCCESS}2. BRANCH${COLOR_RESET}          : The target Git branch to checkout (e.g., 'staging', 'main')."
    echo -e "  ${COLOR_SUCCESS}3. RENEW_DB${COLOR_RESET}        : Set to 'true' or '1' to drop Staging DB and clone from Production."
    echo -e "                       Set to 'false' or '0' to keep existing Staging data."
    echo -e "  ${COLOR_SUCCESS}4. DB_NAME${COLOR_RESET}         : (Required if RENEW_DB is false) The name of the target database."
    echo -e "  ${COLOR_SUCCESS}5. MODULES${COLOR_RESET}         : (Optional) Comma-separated list of modules to update (e.g., 'sale,stock')."
    echo ""
    echo -e "${COLOR_CYAN}Options:${COLOR_RESET}"
    echo -e "  ${COLOR_SUCCESS}-h, --help${COLOR_RESET}         : Show this help message and exit."
    echo -e "  ${COLOR_SUCCESS}-l, --list-db${COLOR_RESET}      : List all databases owned by the project's pg user and exit."
    echo ""
    echo -e "${COLOR_CYAN}Examples:${COLOR_RESET}"
    echo "  # 1. Update code only (Fastest):"
    echo "  sudo $0 odoo-custom release/feature_a false my_existing_db"
    echo ""
    echo "  # 2. Update code and refresh Database from Prod (Full Reset):"
    echo "  sudo $0 odoo-custom release/feature_a true"
    echo ""
    echo "  # 3. Update code and specific modules without DB reset:"
    echo "  sudo $0 odoo-custom release/feature_a false my_existing_db sale,inventory,account"
    echo ""
}

# --- Check for Help or List Flags ---
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    display_usage
    exit 0
elif [[ "$1" == "-l" || "$1" == "--list-db" ]]; then
    "$PATH_TO_ODOO/scripts/list-databases.sh"
fi

# --- Inputs ---
GIT_REPO_NAME=$1
RELEASE_BRANCH=$2
IS_RENEW_DB=$3

case "${IS_RENEW_DB}" in
    1|true|True|TRUE)
        IS_RENEW_DB=true
    ;;
    *)
        IS_RENEW_DB=false
    ;;
esac

TARGET_DB=""
MODULES_TO_UPDATE=""

if [ "$IS_RENEW_DB" = "true" ]; then
    MODULES_TO_UPDATE=$4
else
    TARGET_DB=$4
    MODULES_TO_UPDATE=$5
fi

# --- Validation ---
MISSING_ARGS=false
if [ -z "$GIT_REPO_NAME" ]; then
    log_error "Missing Argument 1: Git Repo Name"
    MISSING_ARGS=true
fi

if [ -z "$RELEASE_BRANCH" ]; then
    log_error "Missing Argument 2: Release Branch"
    MISSING_ARGS=true
fi

if [ -z "$IS_RENEW_DB" ]; then
    log_error "Missing Argument 3: Clone DB Flag (true/false)"
    MISSING_ARGS=true
fi

if [ "$IS_RENEW_DB" = "false" ] && [ -z "$TARGET_DB" ] && [ -n "$MODULES_TO_UPDATE" ]; then
    log_error "Missing Argument 4: Target Database Name (Required when RENEW_DB is false and modules are provided)"
    MISSING_ARGS=true
fi

if [ "$MISSING_ARGS" == "true" ]; then
    echo ""
    display_usage
    exit 1
fi

STG_PATH_TO_ODOO=$PATH_TO_ODOO
SERVICE_NAME_PRD=${SERVICE_NAME%-*} # Assumes format like 'project-stg' -> 'project' OR 'project-16-stg' -> 'project-16'

# Try to grab this automatically from your .env file
STG_ENV_FILE="$STG_PATH_TO_ODOO/.env"

if [ "$IS_RENEW_DB" = "true" ]; then
    STG_DB_NAME_FROM_ENV=$(grep "^DB_NAME=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
    STG_DB_NAME="$STG_DB_NAME_FROM_ENV"

    # Fallback DB Name
    if [ -z "$STG_DB_NAME" ]; then
        # Fallback if .env is empty
        STG_DB_NAME="$(get_next_prefix "$STG_ENV_FILE")-$SERVICE_NAME-$(date +"%Y%m%d-%H%M%S")"
    fi
else
    STG_DB_NAME="$TARGET_DB"
fi

STG_GIT_PATH="$STG_PATH_TO_ODOO/git/$GIT_REPO_NAME"

# Verify Git path exists
if [ ! -d "$STG_GIT_PATH" ]; then
    fail_with_json "Git path not found at: $STG_GIT_PATH"
fi

# Check if remote branch or tag exists
log_info "Checking if remote branch or tag '$RELEASE_BRANCH' exists..."
if [ "$JSON_MODE" = "true" ]; then
    GIT_LS_REMOTE_CMD="sudo -u $CURRENT_DIR_USER git -C $STG_GIT_PATH ls-remote --exit-code origin $RELEASE_BRANCH > /dev/null 2>&1"
else
    GIT_LS_REMOTE_CMD="sudo -u $CURRENT_DIR_USER git -C $STG_GIT_PATH ls-remote --exit-code origin $RELEASE_BRANCH > /dev/null"
fi

if ! eval "$GIT_LS_REMOTE_CMD"; then
    fail_with_json "Remote branch or tag '$RELEASE_BRANCH' not found in repository '$GIT_REPO_NAME'."
fi

log_info "🚀 Starting Deployment for Service: $SERVICE_NAME"
log_info "   Git Repo Name: $GIT_REPO_NAME"
log_info "   Branch: $RELEASE_BRANCH"
if [ "$IS_RENEW_DB" == "true" ]; then
    log_info "   Target DB: $STG_DB_NAME"
fi
log_info "   Clone DB: $IS_RENEW_DB"


# 1. SWITCH BRANCH (Code Update)
# ---------------------------------------------------------
log_stage "[1/4] Switching Git Branch..."

log_info "Stashing local changes if any..."
if [ "$JSON_MODE" = "true" ]; then
    sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" stash save -u >&2 || true
else
    sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" stash save -u || true
fi

# Fetch updates with prune and tags
log_info "Fetching latest updates..."
TEMP_GIT_LOG=$(mktemp)
if [ "$JSON_MODE" = "true" ]; then
    eval "sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" fetch --prune --tags" >"$TEMP_GIT_LOG" 2>&1
else
    eval "sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" fetch --prune --tags" >"$TEMP_GIT_LOG" 2>&1
    cat "$TEMP_GIT_LOG"
fi
FETCH_STATUS=$?

if [ $FETCH_STATUS -ne 0 ]; then
    if grep -q "fatal: cannot lock ref" "$TEMP_GIT_LOG"; then
        CONFLICTING_BRANCH=$(sed -n "s/.*fatal: cannot lock ref '[^']*': '\([^']*\)' exists.*/\1/p" "$TEMP_GIT_LOG" | head -n 1)
        if [ -n "$CONFLICTING_BRANCH" ]; then
            log_warn "Detected git ref conflict: $CONFLICTING_BRANCH"
            log_info "Switching to main/master branch first to resolve conflict..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main >&2 || sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master >&2 || true
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main || sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master || true
            fi

            log_info "Deleting conflicting branch: $CONFLICTING_BRANCH..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$CONFLICTING_BRANCH" >&2 || true
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$CONFLICTING_BRANCH" || true
            fi

            log_info "Retrying fetch --prune..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" fetch --prune >&2 || { log_error "Failed to fetch updates after resolving conflict."; rm -f "$TEMP_GIT_LOG"; exit 1; }
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" fetch --prune || { log_error "Failed to fetch updates after resolving conflict."; rm -f "$TEMP_GIT_LOG"; exit 1; }
            fi
        else
            log_error "Failed to fetch updates and could not parse conflict branch."
            rm -f "$TEMP_GIT_LOG"
            exit 1
        fi
    else
        log_error "Failed to fetch updates."
        rm -f "$TEMP_GIT_LOG"
        exit 1
    fi
else
    log_info "Fetch success."
fi
rm -f "$TEMP_GIT_LOG"

# Force checkout clean (discard local changes in staging)
if [ "$JSON_MODE" = "true" ]; then
    GIT_RESET_CMD="sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" reset --hard >&2"
else
    GIT_RESET_CMD="sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" reset --hard"
fi

if eval "$GIT_RESET_CMD"; then
    log_info "Local changes discarded (Reset Hard)."
else
    log_warn "Could not reset git changes. Proceeding..."
fi

# Checkout the branch with ref-locking conflict resolution fallback
TEMP_CHECKOUT_LOG=$(mktemp)
if [ "$JSON_MODE" = "true" ]; then
    eval "sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" checkout \"$RELEASE_BRANCH\"" >"$TEMP_CHECKOUT_LOG" 2>&1
else
    eval "sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" checkout \"$RELEASE_BRANCH\"" >"$TEMP_CHECKOUT_LOG" 2>&1
    cat "$TEMP_CHECKOUT_LOG"
fi
CHECKOUT_STATUS=$?

if [ $CHECKOUT_STATUS -ne 0 ]; then
    if grep -q "fatal: cannot lock ref" "$TEMP_CHECKOUT_LOG"; then
        CONFLICTING_BRANCH=$(sed -n "s/.*fatal: cannot lock ref '[^']*': '\([^']*\)' exists.*/\1/p" "$TEMP_CHECKOUT_LOG" | head -n 1)
        if [ -n "$CONFLICTING_BRANCH" ]; then
            log_warn "Detected checkout git ref conflict: $CONFLICTING_BRANCH"
            log_info "Switching to main/master branch first to resolve conflict..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main >&2 || sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master >&2 || true
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main || sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master || true
            fi

            log_info "Deleting conflicting branch: $CONFLICTING_BRANCH..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$CONFLICTING_BRANCH" >&2 || true
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$CONFLICTING_BRANCH" || true
            fi

            log_info "Retrying checkout to $RELEASE_BRANCH..."
            if [ "$JSON_MODE" = "true" ]; then
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout "$RELEASE_BRANCH" >&2 || { log_error "Failed to checkout after resolving conflict."; rm -f "$TEMP_CHECKOUT_LOG"; exit 1; }
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout "$RELEASE_BRANCH" || { log_error "Failed to checkout after resolving conflict."; rm -f "$TEMP_CHECKOUT_LOG"; exit 1; }
            fi
        else
            log_error "Failed to checkout and could not parse conflict branch."
            rm -f "$TEMP_CHECKOUT_LOG"
            exit 1
        fi
    else
        log_error "Failed to checkout branch."
        rm -f "$TEMP_CHECKOUT_LOG"
        exit 1
    fi
else
    log_success "Checked out branch: $RELEASE_BRANCH"
fi
rm -f "$TEMP_CHECKOUT_LOG"

if sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" symbolic-ref -q HEAD >/dev/null; then
    if [ "$JSON_MODE" = "true" ]; then
        GIT_PULL_CMD="sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" pull >&2"
    else
        GIT_PULL_CMD="sudo -u \"$CURRENT_DIR_USER\" git -C \"$STG_GIT_PATH\" pull"
    fi

    if eval "$GIT_PULL_CMD"; then
        log_success "Code is up to date."
    else
        log_warn "Failed to pull latest code. Attempting auto-recovery for divergent branch/conflict..."
        if [ "$JSON_MODE" = "true" ]; then
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" merge --abort >&2 || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" reset --hard >&2 || true
            if [ "$RELEASE_BRANCH" != "main" ] && sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main >&2; then
                :
            elif [ "$RELEASE_BRANCH" != "master" ] && sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master >&2; then
                :
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout --detach >&2 || true
            fi
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$RELEASE_BRANCH" >&2 || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" fetch --prune --tags >&2 || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout "$RELEASE_BRANCH" >&2 || { log_error "Failed to checkout $RELEASE_BRANCH after recovery."; exit 1; }
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" pull >&2 || { log_error "Failed to pull code after recovery."; exit 1; }
        else
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" merge --abort || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" reset --hard || true
            if [ "$RELEASE_BRANCH" != "main" ] && sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout main; then
                :
            elif [ "$RELEASE_BRANCH" != "master" ] && sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout master; then
                :
            else
                sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout --detach || true
            fi
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" branch -D "$RELEASE_BRANCH" || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" fetch --prune --tags || true
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" checkout "$RELEASE_BRANCH" || { log_error "Failed to checkout $RELEASE_BRANCH after recovery."; exit 1; }
            sudo -u "$CURRENT_DIR_USER" git -C "$STG_GIT_PATH" pull || { log_error "Failed to pull code after recovery."; exit 1; }
        fi
        log_success "Code is up to date after auto-recovery."
    fi
else
    log_info "HEAD is detached ($RELEASE_BRANCH is a tag/commit). Skipping git pull."
fi


# 2. CLONE DATABASE (Data Reset)
# ---------------------------------------------------------
if [ "$IS_RENEW_DB" == "true" ]; then
    PRD_SSH_HOST=$(grep "^PRD_SSH_HOST=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    PRD_SSH_USER=$(grep "^PRD_SSH_USER=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    PRD_SSH_PORT=$(grep "^PRD_SSH_PORT=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    PRD_SSH_KEY=$(grep "^PRD_SSH_KEY=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    PRD_SSH_PATH=$(grep "^PRD_SSH_PATH=" "$STG_ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
    [ -z "$PRD_SSH_PORT" ] && PRD_SSH_PORT="22"

    if [ -n "$PRD_SSH_HOST" ]; then
        if [ -z "$PRD_SSH_USER" ] || [ -z "$PRD_SSH_PATH" ]; then
            fail_with_json "PRD_SSH_USER and PRD_SSH_PATH are required when PRD_SSH_HOST is configured in .env!"
        fi

        PRD_SERVICE_NAME=$(basename "$PRD_SSH_PATH")

        log_stage "[2/4] Cloning Remote Production Database to Staging (SSH Mode)..."

        if declare -f ensure_ssh_key_for_remote >/dev/null 2>&1; then
            key_path=$(ensure_ssh_key_for_remote "deploy_rc" "$PRD_SSH_HOST" "$PRD_SSH_USER" "$PRD_SSH_KEY" "$REPOSITORY_OWNER" "PRD_SSH_KEY" "$STG_ENV_FILE")
        else

            owner_home=$(eval echo "~$REPOSITORY_OWNER")
            [ -z "$owner_home" ] && owner_home="$HOME"
            key_path="${PRD_SSH_KEY/#\~/$owner_home}"
        fi

        prd_ssh_opts=(-p "$PRD_SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5)
        prd_rsync_ssh="ssh -p $PRD_SSH_PORT -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30 -o ServerAliveCountMax=5"
        if [ -n "$key_path" ] && [ -f "$key_path" ]; then
            prd_ssh_opts+=(-i "$key_path")
            prd_rsync_ssh+=" -i $key_path"
        fi

        log_info "Connecting to Remote Production VPS ($PRD_SSH_USER@$PRD_SSH_HOST:$PRD_SSH_PORT)..."
        if ! ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "true" 2>/dev/null; then
            fail_with_json "Failed to establish SSH connection with Remote Production VPS at $PRD_SSH_USER@$PRD_SSH_HOST:$PRD_SSH_PORT."
        fi
        log_success "SSH connection to Production VPS established."

        log_info "Step 1/3: Synchronizing Odoo filestore from Remote Production VPS..."
        remote_prd_db=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "sed -e 's/#.*//' '$PRD_SSH_PATH/.env' 2>/dev/null | grep '^DB_NAME=' | cut -d '=' -f2- | tr -d '[:space:]\"' | tr -d \"'\" || true" | tr -d '\r\n')
        [ -z "$remote_prd_db" ] && remote_prd_db="$PRD_SERVICE_NAME"

        local_filestore_base="/var/lib/odoo/$SERVICE_NAME/filestore"
        local_target_filestore="$local_filestore_base/$STG_DB_NAME"
        sudo mkdir -p "$local_filestore_base"

        # Check existing staging filestore to seed from
        if [ ! -d "$local_target_filestore" ]; then
            existing_seed_filestore=$(find "$local_filestore_base" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n 1 || true)
            if [ -n "$existing_seed_filestore" ] && [ -d "$existing_seed_filestore" ]; then
                log_info "Seeding filestore from existing local directory: $existing_seed_filestore..."
                sudo cp -al "$existing_seed_filestore" "$local_target_filestore" 2>/dev/null || sudo cp -r "$existing_seed_filestore" "$local_target_filestore" 2>/dev/null || true
            else
                sudo mkdir -p "$local_target_filestore"
            fi
        fi

        remote_has_export_helper=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "
            if command -v export_filestore-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/export_filestore-$PRD_SERVICE_NAME' ] || [ -f '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh' ] || [ -f '$PRD_SSH_PATH/scripts/export_filestore.sh' ]; then
                echo 'true'
            else
                echo 'false'
            fi
        " | tr -d '\r\n')

        if [ "$remote_has_export_helper" = "true" ]; then
            log_info "Streaming remote filestore via export_filestore helper..."
            remote_export_cmd="if command -v export_filestore-$PRD_SERVICE_NAME &>/dev/null; then sudo -n export_filestore-$PRD_SERVICE_NAME; elif [ -x '/usr/local/sbin/export_filestore-$PRD_SERVICE_NAME' ]; then sudo -n /usr/local/sbin/export_filestore-$PRD_SERVICE_NAME; elif [ -f '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh' ]; then sudo -n '$PRD_SSH_PATH/scripts/export_filestore-$PRD_SERVICE_NAME.sh'; else sudo -n '$PRD_SSH_PATH/scripts/export_filestore.sh'; fi"
            if command -v zstd >/dev/null 2>&1; then
                ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_export_cmd" | zstd -d -T0 | sudo tar -C "$local_target_filestore" -xf -
            else
                ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_export_cmd" | sudo tar -C "$local_target_filestore" -xf -
            fi
        else
            log_info "Syncing filestore via rsync from /var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/..."
            rsync -e "$prd_rsync_ssh" -avz --delete "$PRD_SSH_USER@$PRD_SSH_HOST:/var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/" "$local_target_filestore/" 2>/dev/null || \
            rsync -e "$prd_rsync_ssh" -avz "$PRD_SSH_USER@$PRD_SSH_HOST:/var/lib/odoo/$PRD_SERVICE_NAME/filestore/$remote_prd_db/" "$local_target_filestore/" 2>/dev/null || \
            log_warn "Filestore direct rsync skipped or partially transferred."
        fi
        sudo chown -R odoo:odoo "$local_target_filestore" 2>/dev/null || true
        log_success "Filestore synchronization completed."

        log_info "Step 2/3: Checking remote database dump capabilities..."
        remote_has_dump_helper=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "
            if command -v dump_database-$PRD_SERVICE_NAME &>/dev/null || [ -x '/usr/local/sbin/dump_database-$PRD_SERVICE_NAME' ] || [ -f '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh' ] || [ -f '$PRD_SSH_PATH/scripts/dump_database.sh' ]; then
                echo 'true'
            else
                echo 'false'
            fi
        " | tr -d '\r\n')

        remote_has_zstd=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "command -v zstd >/dev/null 2>&1 && echo true || echo false" | tr -d '\r\n')

        # Base64-encoded fallback runner for direct host/container pg_dump
        local remote_dump_b64=""

        # Prepare staging database
        log_info "Recreating staging database '$STG_DB_NAME'..."
        run_psql -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$STG_DB_NAME' AND pid <> pg_backend_pid();" >/dev/null 2>&1 || true
        run_psql -d postgres -c "DROP DATABASE IF EXISTS \"$STG_DB_NAME\"" >/dev/null 2>&1 || true

        local local_db_user
        local_db_user=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^ACTIVE_DB_USER=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
        [ -z "$local_db_user" ] && local_db_user=$(cat "$STG_PATH_TO_ODOO/.secrets/db_user" 2>/dev/null || echo "odoo")
        run_psql -d postgres -c "CREATE DATABASE \"$STG_DB_NAME\" OWNER \"$local_db_user\"" >/dev/null 2>&1 || run_psql -d postgres -c "CREATE DATABASE \"$STG_DB_NAME\"" >/dev/null 2>&1

        # Function to run psql targeting the staging database as the active staging DB user
        restore_psql() {
            local stg_host
            stg_host=$(sed -e 's/#.*//' "$STG_ENV_FILE" 2>/dev/null | grep "^DB_HOST=" | cut -d '=' -f2- | tr -d '[:space:]"' | tr -d "'" || true)
            if [ -n "$stg_host" ] && [ "$stg_host" != "localhost" ]; then
                if cd "$STG_PATH_TO_ODOO" 2>/dev/null && docker compose exec -T odoo which psql >/dev/null 2>&1; then
                    docker compose exec -T odoo psql -h "$stg_host" -p "${DB_PORT:-5432}" -U "$local_db_user" -d "$STG_DB_NAME" "$@"
                else
                    run_psql -U "$local_db_user" -d "$STG_DB_NAME" "$@"
                fi
            else
                # Staging uses host PostgreSQL mode
                run_psql -U "$local_db_user" -d "$STG_DB_NAME" "$@"
            fi
        }

        local remote_dump_file=""
        local rsync_ssh_cmd="ssh -i '$PRD_SSH_KEY' -p '$PRD_SSH_PORT' -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

        if [ "$remote_has_dump_helper" = "true" ]; then
            log_info "Streaming remote database dump via dump_database helper..."
            local remote_dump_cmd="if command -v dump_database-$PRD_SERVICE_NAME &>/dev/null; then sudo -n dump_database-$PRD_SERVICE_NAME; elif [ -x '/usr/local/sbin/dump_database-$PRD_SERVICE_NAME' ]; then sudo -n /usr/local/sbin/dump_database-$PRD_SERVICE_NAME; elif [ -f '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh' ]; then sudo -n '$PRD_SSH_PATH/scripts/dump_database-$PRD_SERVICE_NAME.sh'; else sudo -n '$PRD_SSH_PATH/scripts/dump_database.sh'; fi"
            local ssh_status=0
            if [ "$remote_has_zstd" = "true" ] && command -v zstd >/dev/null 2>&1; then
                ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_dump_cmd" | zstd -d -T0 | restore_psql >/dev/null
                ssh_status=${PIPESTATUS[0]}
            else
                ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_dump_cmd --raw" | restore_psql >/dev/null
                ssh_status=${PIPESTATUS[0]}
            fi
            if [ "$ssh_status" -ne 0 ]; then
                fail_with_json "Database streaming restore from remote production failed (SSH exit code: $ssh_status)."
            fi
        else
            log_info "dump_database helper not found on remote; dumping on production host via container pg_dump..."
            local remote_tmp_base="/tmp/${STG_DB_NAME}"
            local remote_exec_cmd="echo '$remote_dump_b64' | base64 -d | bash -s -- '$PRD_SSH_PATH' '$remote_prd_db' '$remote_tmp_base'"
            local remote_dump_out=""
            if ! remote_dump_out=$(ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "$remote_exec_cmd" 2>&1); then
                fail_with_json "Database dump on remote production host failed. Output: $remote_dump_out"
            fi
            remote_dump_file=$(echo "$remote_dump_out" | tail -n 1 | tr -d '\r\n')
            if [ -z "$remote_dump_file" ] || [[ "$remote_dump_file" != /tmp/* ]]; then
                fail_with_json "Database dump on remote production host failed. Output: $remote_dump_out"
            fi

            log_info "Moving database dump from Production VPS to staging environment ($remote_dump_file)..."
            local local_dump_file="/tmp/$(basename "$remote_dump_file")"
            if [ "$JSON_MODE" = "true" ]; then
                if ! rsync -az -e "$rsync_ssh_cmd" "$PRD_SSH_USER@$PRD_SSH_HOST:$remote_dump_file" "$local_dump_file" >&2; then
                    ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true
                    fail_with_json "Failed to transfer database dump from Production VPS."
                fi
            else
                if ! rsync -az -e "$rsync_ssh_cmd" "$PRD_SSH_USER@$PRD_SSH_HOST:$remote_dump_file" "$local_dump_file"; then
                    ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true
                    fail_with_json "Failed to transfer database dump from Production VPS."
                fi
            fi
            ssh "${prd_ssh_opts[@]}" "$PRD_SSH_USER@$PRD_SSH_HOST" "rm -f '$remote_dump_file'" 2>/dev/null || true

            log_info "Restoring SQL into '$STG_DB_NAME' using user '$local_db_user'..."
            if [[ "$local_dump_file" == *.zst ]] && command -v zstd >/dev/null 2>&1; then
                zstd -d -c "$local_dump_file" | restore_psql >/dev/null
            else
                restore_psql < "$local_dump_file" >/dev/null
            fi
            rm -f "$local_dump_file"
        fi

        # Ensure all database objects in public schema are owned by local_db_user
        log_info "Verifying database object ownership for '$local_db_user'..."
        run_psql -d "$STG_DB_NAME" -c "
            DO \$\$
            DECLARE
                rec RECORD;
            BEGIN
                FOR rec IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') LOOP
                    EXECUTE 'ALTER TABLE ' || quote_ident(rec.tablename) || ' OWNER TO \"$local_db_user\"';
                END LOOP;
                FOR rec IN (SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public') LOOP
                    EXECUTE 'ALTER SEQUENCE ' || quote_ident(rec.sequence_name) || ' OWNER TO \"$local_db_user\"';
                END LOOP;
                FOR rec IN (SELECT table_name FROM information_schema.views WHERE table_schema = 'public') LOOP
                    EXECUTE 'ALTER VIEW ' || quote_ident(rec.table_name) || ' OWNER TO \"$local_db_user\"';
                END LOOP;
                FOR rec IN (SELECT matviewname FROM pg_matviews WHERE schemaname = 'public') LOOP
                    EXECUTE 'ALTER MATERIALIZED VIEW ' || quote_ident(rec.matviewname) || ' OWNER TO \"$local_db_user\"';
                END LOOP;
            END \$\$;
        " >/dev/null 2>&1 || true

        log_success "Database restore completed."
        trigger_registry_reload "$STG_DB_NAME" "$STG_PATH_TO_ODOO" || log_warn "Registry reload skipped or failed; container restart in step 3 will reload registry."
        log_success "Database clone from remote production completed successfully."
    else
        PRD_PATH_TO_ODOO="$STG_PATH_TO_ODOO/../$SERVICE_NAME_PRD"
        PRD_ENV_FILE="$PRD_PATH_TO_ODOO/.env"

        if [ ! -f "$PRD_ENV_FILE" ]; then
            log_error "Production .env file not found at: $PRD_ENV_FILE"
            exit 1
        fi

        PRD_DB_NAME=$(grep "^DB_NAME=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

        if [ -z "$PRD_DB_NAME" ]; then
            log_error "DB_NAME is not set in the production environment. Please set it at: $PRD_ENV_FILE"
            exit 1
        fi

        log_stage "[2/4] Cloning Production Database to Staging..."

        # if the DB_NAME variable is set in Staging Environment file, drop it first
        STG_PORT=$(grep "^PORT=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
        STG_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$STG_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

        # Check Staging (Destination) Health
        log_info "Checking Staging ($SERVICE_NAME) Health..."
        checkOdooEndpoint "$STG_PORT"

        if [ -n "$STG_DB_NAME_FROM_ENV" ]; then
            log_info "Dropping old database '$STG_DB_NAME_FROM_ENV' if it exists..."

            drop_response=$(curl -s -X POST \
                -d "master_pwd=$STG_ADMIN_PASSWD" \
                -d "name=$STG_DB_NAME_FROM_ENV" \
                "http://localhost:$STG_PORT/web/database/drop")

            drop_response_lower="${drop_response,,}"

            if [[ "$drop_response_lower" == *"error"* ]] && [[ "$drop_response_lower" != *"does not exist"* ]] || \
               [[ "$drop_response_lower" == *"no space left"* ]] || \
               [[ "$drop_response_lower" == *"<html"* ]]; then
                log_warn "Could not drop database '$STG_DB_NAME_FROM_ENV'. It might not exist or another error occurred. Response: $drop_response"
            else
                log_success "Drop database command completed for '$STG_DB_NAME_FROM_ENV'."
            fi
        fi

        # backup the database from production environment
        TEMP_BACKUP_FILE="/tmp/temp_backup_db-$SERVICE_NAME_PRD-$(date +"%Y%m%d_%H%M%S").zip"
        PRD_PORT=$(grep "^PORT=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')
        PRD_ADMIN_PASSWD=$(grep "^ADMIN_PASSWD=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g')

        # Check Production (Source) Health
        log_info "Checking Production ($SERVICE_NAME_PRD) Health..."
        checkOdooEndpoint "$PRD_PORT"

        log_info "Requesting backup from production $SERVICE_NAME_PRD instance..."
        if [ "$JSON_MODE" = "true" ]; then
            curl -s -X POST \
                -F "master_pwd=$PRD_ADMIN_PASSWD" \
                -F "name=$PRD_DB_NAME" \
                -F "backup_format=zip" \
                -o "$TEMP_BACKUP_FILE" \
                "http://localhost:$PRD_PORT/web/database/backup" >&2
        else
            curl -s -X POST \
                -F "master_pwd=$PRD_ADMIN_PASSWD" \
                -F "name=$PRD_DB_NAME" \
                -F "backup_format=zip" \
                -o "$TEMP_BACKUP_FILE" \
                "http://localhost:$PRD_PORT/web/database/backup"
        fi

        if [ ! -s "$TEMP_BACKUP_FILE" ]; then
            log_error "Backup failed for production $SERVICE_NAME_PRD instance. The output file is empty or was not created. Check source Odoo logs."
            exit 1
        fi

        # check if the zip backup file actually an html file
        if grep -q -i "<html" "$TEMP_BACKUP_FILE"; then
            ODOO_ERROR_MSG=$(grep -a '<div class="alert alert-danger">' "$TEMP_BACKUP_FILE" | sed -n 's/.*<div class="alert alert-danger">\(.*\)<\/div>.*/\1/p' || true)

            if [ -z "$ODOO_ERROR_MSG" ]; then
                ODOO_ERROR_MSG="Unknown error (The response was an HTML page, but the specific error message could not be parsed)."
            fi

            log_error "Backup failed! Odoo returned an HTML error page instead of a ZIP file."
            log_error "Odoo Message: $ODOO_ERROR_MSG"

            exit 1
        fi

        log_success "Backup of '$PRD_DB_NAME' completed successfully to $TEMP_BACKUP_FILE"

        # restore the database
        NEUTRALIZE_DB=$(grep "^NEUTRALIZE_DATABASE=" "$PRD_ENV_FILE" | cut -d "=" -f 2 | sed 's/^[[:space:]\n]*//g' | sed 's/[[:space:]\n]*$//g' | tr '[:upper:]' '[:lower:]')
        if [ -z "$NEUTRALIZE_DB" ]; then
            NEUTRALIZE_DB="true"
        fi

        log_info "Requesting restore to destination Odoo instance..."
        log_info "Neutralize database option: $NEUTRALIZE_DB"

        # Build curl arguments
        CURL_RESTORE_ARGS=(
            -sS -X POST
            -F "master_pwd=$STG_ADMIN_PASSWD"
            -F "name=$STG_DB_NAME"
            -F "backup_file=@$TEMP_BACKUP_FILE"
            -F "copy=true"
        )

        # Always pass neutralize_database if it's set in config
        if [ -n "$NEUTRALIZE_DB" ]; then
            CURL_RESTORE_ARGS+=(-F "neutralize_database=$NEUTRALIZE_DB")
        fi

        # Execute restore with high timeout (database restore can be slow)
        # --connect-timeout: max time to establish connection
        # --max-time: max time for the entire operation (1 hour default)
        response=$(curl "${CURL_RESTORE_ARGS[@]}" \
            --connect-timeout 10 \
            --max-time 3600 \
            "http://localhost:$STG_PORT/web/database/restore")

        log_info "Removing temporary backup file: $TEMP_BACKUP_FILE"
        rm -f "$TEMP_BACKUP_FILE"

        response_lower="${response,,}"

        # Catch empty responses, explicit errors, or any HTML error pages
        if [[ "$response_lower" == *"error"* ]] || \
           [[ "$response_lower" == *"incorrect master password"* ]] || \
           [[ "$response_lower" == *"no space left"* ]] || \
           [[ "$response_lower" == *"<html"* ]] || \
           [ -z "$response" ]; then
            log_error "Failed to restore database to staging environment. Server Response: ${response:-'Empty response (Likely timeout or bad gateway)'}"
            exit 1
        fi

        log_success "Database restore command completed successfully."
        trigger_registry_reload "$STG_DB_NAME" "$STG_PATH_TO_ODOO" || log_warn "Registry reload skipped or failed; container restart in step 3 will reload registry."
    fi
else
    log_stage "[2/4] Skipping Database Clone (IS_RENEW_DB is false)."
fi


# 3. RESTART CONTAINER
# ---------------------------------------------------------
log_stage "[3/4] Restarting Staging Container..."

# Change directory to the dynamic STG_PATH_TO_ODOO
if cd "$STG_PATH_TO_ODOO"; then
    if [ "$JSON_MODE" = "true" ]; then
        if docker compose restart odoo >&2; then
            log_success "Container restarted."
        else
            log_error "Failed to restart docker container."
            exit 1
        fi
    else
        if docker compose restart odoo; then
            log_success "Container restarted."
        else
            log_error "Failed to restart docker container."
            exit 1
        fi
    fi
else
    log_error "Could not find directory $STG_PATH_TO_ODOO"
    exit 1
fi


# 4. UPDATE MODULES
# ---------------------------------------------------------
if [ -z "$MODULES_TO_UPDATE" ]; then
    log_stage "[4/4] Update module skipped..."
    log_warn "No specific modules listed."
    log_info "Tip: You can pass modules as the fourth argument: $0 $RELEASE_BRANCH $IS_RENEW_DB 'sale,inventory'"
else
    log_stage "[4/4] Updating Odoo Modules..."
    log_info "Waiting 10 seconds for Odoo to initialize..."
    sleep 10
    log_info "Updating modules: $MODULES_TO_UPDATE"
    # Using the 'odoo-module-upgrade' utility embedded in your image
    MODULE_UPDATE_ERROR=false
    UPDATE_OUTPUT=""
    TEMP_UPDATE_LOG=$(mktemp)
    if [ "$JSON_MODE" = "true" ]; then
        docker compose exec odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG" >&2
        if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
        UPDATE_OUTPUT=$(cat "$TEMP_UPDATE_LOG")
        if [ "$MODULE_UPDATE_ERROR" = "false" ]; then
            log_success "Modules updated successfully."
        else
            log_warn "Process complete, but the module update encountered an error."
            log "${COLOR_ERROR}" "❌" "Odoo module upgrade log (Summary):"
            echo "$UPDATE_OUTPUT" >&2
        fi
    else
        docker compose exec odoo odoo-module-upgrade "$STG_DB_NAME" --update="$MODULES_TO_UPDATE" 2>&1 | tee "$TEMP_UPDATE_LOG"
        if [ ${PIPESTATUS[0]} -ne 0 ]; then MODULE_UPDATE_ERROR=true; fi
        UPDATE_OUTPUT=$(cat "$TEMP_UPDATE_LOG")
        if [ "$MODULE_UPDATE_ERROR" = "false" ]; then
            log_success "Modules updated successfully."
        else
            log_warn "Process complete, but the module update encountered an error."
            log "${COLOR_ERROR}" "❌" "Odoo module upgrade log (Summary):"
            echo "$UPDATE_OUTPUT"
        fi
    fi
    rm -f "$TEMP_UPDATE_LOG"
fi

if [ "$JSON_MODE" = "false" ]; then
    echo ""
    echo "=================================================="
    log_success "Deployment Complete!"
    echo "   Service:     $SERVICE_NAME"
    if [ "$IS_RENEW_DB" == "true" ]; then
        echo "   Database:    $STG_DB_NAME (Cloned from $PRD_DB_NAME)"
    fi
    echo "   Branch:      $RELEASE_BRANCH"
    echo "=================================================="
fi

# --- JSON Output Generation ---
if [ "$JSON_MODE" = "true" ]; then
    echo "{"
    echo '  "repositories": ['

    GIT_ROOT="$STG_PATH_TO_ODOO/git"
    FIRST_REPO=1

    if [ -d "$GIT_ROOT" ]; then
        for repo_dir in "$GIT_ROOT"/*/; do
            [ -d "$repo_dir" ] || continue
            repo_name=$(basename "$repo_dir")

            # Default values
            status="clean"
            # Note: We don't do full 'git status' check here to keep it fast,
            # but we can assume existing is 'clean' or 'not_git' unless we want to run git status.
            # The user asked for "list of current commit".

            if [ -d "$repo_dir/.git" ]; then
               commit_hash=$(sudo -u "$CURRENT_DIR_USER" git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
               commit_subject=$(sudo -u "$CURRENT_DIR_USER" git -C "$repo_dir" log -1 --format="%s" 2>/dev/null | tr -d '"\\' || echo "")
            else
               status="not_git"
               commit_hash=""
               commit_subject=""
            fi

            if [ $FIRST_REPO -eq 0 ]; then echo ","; fi
            FIRST_REPO=0

            echo "    {"
            echo "      \"name\": \"$repo_name\","
            echo "      \"status\": \"$status\","
            echo "      \"commit\": \"$commit_hash\","
            echo "      \"subject\": \"$commit_subject\","
            echo "      \"files\": []"
            echo -n "    }"
        done
    fi
    echo ""
    if [ -n "$MODULES_TO_UPDATE" ]; then
        echo "  ],"
        echo "  \"database_name\": \"$STG_DB_NAME\","
        echo '  "modules_to_upgrade": ['
        IFS=',' read -ra MODULES <<< "$MODULES_TO_UPDATE"
        FIRST_MODULE=1
        for module in "${MODULES[@]}"; do
            if [ $FIRST_MODULE -eq 0 ]; then echo ","; fi
            # Trim whitespace just in case
            module=$(echo "$module" | xargs)
            echo -n "    \"$module\""
            FIRST_MODULE=0
        done
        echo ""

        if [ "$MODULE_UPDATE_ERROR" = "true" ]; then
            echo "  ],"
            echo "  \"error\": true,"
            if command -v python3 >/dev/null 2>&1; then
                JSON_SAFE_LOG=$(python3 -c 'import json, sys; print(json.dumps(sys.stdin.read()))' <<< "$UPDATE_OUTPUT")
            else
                ESCAPED=$(echo "$UPDATE_OUTPUT" | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $0}' | sed 's/\\n$//')
                JSON_SAFE_LOG="\"$ESCAPED\""
            fi
            echo "  \"module_upgrade_log\": $JSON_SAFE_LOG"
        else
            echo "  ]"
        fi
        echo "}"
    else
        echo "  ],"
        echo "  \"database_name\": \"$STG_DB_NAME\""
        echo "}"
    fi
fi
