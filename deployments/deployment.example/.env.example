# Category: Config
# File: deployments/deployment.example/.env.example
# Description: Per-deployment environment configuration template.
# Usage: Copy to deployments/<deployment_name>/.env and customize values.
# Maintainer: ryumada

# # # # # # # # # # # # # # # # #
# ODOO VERSION                  #
# # # # # # # # # # # # # # # # #
# type your odoo base version
# possible values: 11, 12, 13, 14, 15, 16, 17, 18
# default: 16
ODOO_VERSION=

# # # # # # # # # # # # # # # # #
# ODOO CONFIG                   #
# # # # # # # # # # # # # # # # #
# Odoo base directory name under odoo-base/ (e.g. odoo16, odoo_project_a)
ODOO_BASE_PATH=
# Specify your odoo addons path, the app dir would be in /opt/odoo.
## example:
## ADDONS_PATH=/opt/odoo/odoo-base/odoo/odoo/addons,/opt/odoo/odoo-base/odoo/addons
ADDONS_PATH=
# Additional Odoo Configuration keys
# Insert custom keys into odoo.conf. Use semicolon (;) to separate multiple keys.
## Example: api_key=12345;route_method=POST;my_custom_flag=True
ODOO_ADDITIONAL_CONF=

# # # # # # # # # # # # # # # # #
# DATABASE CREDENTIALS          #
# # # # # # # # # # # # # # # # #
# Name of database (needed to disable ODOO_DB_MANAGER)
DB_NAME=
# This config to regenerate the password of PostgreSQL user
## on the second row, the variable will be set to 'N' as the Postgres Secret will stay the same.
# Please type 'Y' to regenerate the new PostgreSQL Secrets.
DB_REGENERATE_SECRETS=Y

# # # # # # # # # # # # # # # # #
# CUSTOM SECRETS                #
# # # # # # # # # # # # # # # # #
# Specify additional secret files to be injected into the docker-compose.yml
# Separated by comma for multiple files.
# The files should be placed in .secrets/ directory.
# Example: CUSTOM_SECRETS_FILES=service_account,api_key
CUSTOM_SECRETS_FILES=

# # # # # # # # # # # # # # # # #
# PYTHON                        #
# # # # # # # # # # # # # # # # #
# choose python version tag from https://hub.docker.com/_/python
## enter "3.7-bookworm" to use python version python:3.7-bookworm image (Odoo 11 - 16)
## enter "3.8-bookworm" to use python version python:3.8-bookworm image (Odoo 16)
## enter "3.11-bookworm" to use python version python:3.11-bookworm image (Odoo 16+)
## default: 3.11-bookworm
PYTHON_VERSION=

# # # # # # # # # # # # # # # # #
# BUILD MODE, IMAGE, AND SOURCE #
# # # # # # # # # # # # # # # # #
# push the image to Container registry (enter and choose one) leave empty if you don't want to push the image
# this will also pull the image from the registry
## Use GitHub Container Registry (NEED TO ADD ODOO_IMAGE_SOURCE variable)
### ghcr.io/enter_username/enter_project_name
## Use Docker Hub
### enter_username/enter_project_name
## Use Gitlab Container Registry
### registry.gitlab.com/enter_username/enter_project_name
ODOO_IMAGE_NAME=

# image version (tag)
# if empty, it will use "latest" or the tag specified in ODOO_IMAGE_NAME if any
# CURRENT_IMAGE_VERSION is used to pull production mode
# NEXT_IMAGE_VERSION is used to build image
# ex. 1, 2, 3, etc
# NEXT_IMAGE_VERSION will be automatically incremented by 1 every time you run setup.sh on Builder mode (See DOCKER_BUILD_MODE variable)
CURRENT_IMAGE_VERSION=0
NEXT_IMAGE_VERSION=0

# source of the image from git repository (primarlily used for GitHub Container Registry)
# if you use Docker Hub or Gitlab Container Registry, you can leave this empty
# format: https://github.com/enter_username/enter_repository_name
ODOO_IMAGE_SOURCE=

# # # # # # # # # # # # # # # # #
# APT ADDITIONAL PACKAGES       #
# # # # # # # # # # # # # # # # #
# enter the additional apt packages to install inside the container
# to install multiple packages use space as the separator
APT_ADDITIONAL_PACKAGES=

# # # # # # # # # # # # # # # # #
# PIP ADDITIONAL PACKAGES       #
# # # # # # # # # # # # # # # # #
# enter the additional pip packages or constraints to install inside the container
# to install multiple packages use space as the separator
# example: setuptools<70 wheel
PIP_ADDITIONAL_PACKAGES=

# # # # # # # # # # # # # # # # #
# Libreoffice                   #
# # # # # # # # # # # # # # # # #
# install libreoffice inside the container
# Enter 'Y' to install LibreOffice in the Container
# or leave it empty to skip installation (default)
INSTALL_LIBREOFFICE=

# # # # # # # # # # # # # # # # #
# WKHTMLTOPDF                   #
# # # # # # # # # # # # # # # # #
# install wkhtmltopdf inside the container (needed to print pdf on Odoo)
# Get the deb url right here: https://wkhtmltopdf.org/downloads.html
# Example for Debian BookWorm: https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.bookworm_amd64.deb
WKHTMLTOPDF_DIRECT_DOWNLOAD_URL=

# # # # # # # # # # # # # # # # #
# POSTGRESQL LOCAL              #
# # # # # # # # # # # # # # # # #
# default follows the version from bult-in version in Python Image tag
## for example bookworm will use version 14
## ⚠️ This version should be the same as the version in the python image
POSTGRESQL_VERSION=

# Custom PostgreSQL Repository URL
# Leave empty to use the official default: https://apt.postgresql.org
# Example for a local mirror: http://mirror.example.com/postgresql
POSTGRESQL_CUSTOM_REPO_URL=

# # # # # # # # # # # # # # # # #
# CUSTOM FONT INSTALLATION      #
# # # # # # # # # # # # # # # # #
# Comma-separated list of direct download URLs for TTF/OTF font files.
## Your script (docker_install_font.sh) will read and process this list.
## ex. https://github.com/googlefonts/Montserrat/raw/refs/heads/master/fonts/variable/Montserrat%5Bwght%5D.ttf,https://github.com/taveevut/Windows-10-Fonts-Default/raw/refs/heads/master/calibri.ttf
FONT_URLS=
