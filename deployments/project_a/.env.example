# Category: Config
# File: deployments/project_a/.env.example
# Description: Per-deployment environment configuration template for project_a.
# Usage: Copy to deployments/project_a/.env and customize values.
# Maintainer: ryumada

# Python runtime version for this deployment image (e.g. 3.10-bookworm, 3.12-bookworm)
PYTHON_VERSION=3.10-bookworm

# Odoo version (e.g. 16, 17, 18)
ODOO_VERSION=16

# Odoo base directory name under odoo-base/ (e.g. odoo16, odoo_project_a)
ODOO_BASE_PATH=odoo16

# Addons paths for this deployment (comma-separated host paths)
ADDONS_PATH=/opt/odoo/git/project_a-16-addons,/opt/odoo/git/project_a-16ent-addons

# Deployment specific network ports
PORT=8069
GEVENT_PORT=8072

# Database master password & specific database name
ADMIN_PASSWD=admin_project_a
DB_NAME=project_a_db

# Custom APT & PIP packages required by this deployment's addons
APT_ADDITIONAL_PACKAGES=
PIP_ADDITIONAL_PACKAGES=
